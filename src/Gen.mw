-- `syntax!`: a parser and a lossless tree, written from an ungrammar.
--
--   syntax! {
--     pub Calc
--     lexer Token
--     trivia { Whitespace, Comment }
--     tokens { "let" = Let, "ident" = Ident _, … }
--     precedence Expr { left "+" "-", left "*" "/", postfix Call }
--     grammar {
--       File = Stmt*
--       …
--     }
--   }
--
-- writes, beside the call:
--
-- * `Calc`, every kind of node and token the tree can hold;
-- * a parse function for each rule, emitting events over `Lingua.Parser`;
-- * `parseCalc : String -> (Green Calc, [(Int, String)])`, which lexes with
--   the Scythe lexer `lexToken`, parses, and builds the lossless tree;
-- * the typed AST: `CalcLet`, `asCalcLet`, `calcLetName`, … -- everything
--   named after `Calc` (see "names" below).
--
-- See docs/DESIGN.md for what each rule becomes. Every mistake is reported
-- where it was written: in the tables, at the token; in the grammar, at the
-- byte inside the string.

use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe as M
use Std.Macro (TokenTree, Delim, Loc, spanOf, text, isWord, isPunct)
use Std.Macro.TokenTree.*
use Std.Macro.Loc.*
use Std.Macro.Delim.*
use Std.Macro.Parse (Tokens, parseTokens, ident, keyword, punct, group, treesUntil)
use Std.String.Parse as P
use Std.String.Parse (Parser)
use Lingua.Ungrammar (Rule, Def, parseGrammar, parseGrammarTrees, defName, defAt, defBody)
use Lingua.Ungrammar.Rule.*
use Lingua.Lang (Lang, Sort, Prod, Field, Ty)
use Lingua.Lang.Lang.*
use Lingua.Lang.Sort.*
use Lingua.Lang.Prod.*
use Lingua.Lang.Field.*
use Lingua.Lang.Ty.*
use Std.Macro (defineAs, toDatum, fromDatum)

-- --- reading the call --------------------------------------------------------

-- One section of the call.
data Section
  = Lexer String
  | Trivia [[TokenTree]]
  | Table [(String, Loc, [TokenTree])]
  | Precedence String [(String, [String])]
  | Grammar String Loc Int
  | GrammarTrees [TokenTree] Int
  | Public

use Section.*

-- A string literal, where it is, and where its text starts: for a raw string
-- `r#"…"#` the text starts past `r`, the hashes and the quote.
def literal : Parser Tokens (String, Loc, Int) =
  P.label "a string"
    (P.token
      (\t ->
        match t with
        | Str s at ->
            (match at with
             | At a b -> Just (s, at, a + (b - a - stringByteLength s + 1) / 2)
             | Nowhere -> Just (s, at, 0))
        | _ -> None)
      [])

def stringOnly : Parser Tokens String = P.map (\l -> match l with | (s, _, _) -> s) literal

fun comma p = P.thenSkip p (P.optional (punct ","))

-- A pattern of the lexer's type, up to the next comma or the end of its braces.
def pattern : Parser Tokens [TokenTree] =
  comma (P.bind (treesUntil (isPunct ",")) (\ts -> if V.isEmpty ts then P.fail "expected a pattern" else P.pure ts))

def section : Parser Tokens Section =
  P.choice
    [ P.skipThen (keyword "lexer") (P.map Lexer ident),
      P.skipThen (keyword "trivia") (P.map Trivia (group Brace (P.many pattern))),
      P.skipThen (keyword "tokens") (P.map Table (group Brace (P.many tokenEntry))),
      P.skipThen (keyword "precedence") (P.bind ident (\e -> P.map (\ls -> Precedence e ls) (group Brace (P.many level)))),
      P.skipThen
        (keyword "grammar")
        (P.choice
          [ P.map (\l -> match l with | (s, at, start) -> Grammar s at start) literal,
            P.map (\ts -> GrammarTrees ts (lastEnd ts)) (group Brace (treesUntil (\t -> False))) ]) ]

-- Where the last of `ts` ends: what a grammar in braces is said to stop at.
fun lastEnd (ts : [TokenTree]) : Int =
  match V.get ts (V.len ts - 1) with
  | Just t -> (match spanOf t with | At _ b -> b | Nowhere -> 0)
  | None -> 0

def tokenEntry : Parser Tokens (String, Loc, [TokenTree]) =
  P.bind literal (\l -> P.skipThen (punct "=") (P.map (\pat -> match l with | (s, at, _) -> (s, at, pat)) pattern))

def level : Parser Tokens (String, [String]) =
  comma
    (P.choice
      [ P.skipThen (keyword "left") (P.map (\ops -> ("left", ops)) (P.some stringOnly)),
        P.skipThen (keyword "right") (P.map (\ops -> ("right", ops)) (P.some stringOnly)),
        P.skipThen (keyword "postfix") (P.map (\rs -> ("postfix", rs)) (P.some (P.label "a rule" (P.token (\t -> match t with | Word w _ -> (if V.elem w ["left", "right", "postfix"] then None else Just w) | _ -> None) [])))) ])

def call : Parser Tokens (String, [Section]) =
  P.bind
    (P.optional (keyword "pub"))
    (\pub -> P.bind ident (\name -> P.map (\ss -> (name, match pub with | Just _ -> V.pushBack ss Public | None -> ss)) (P.many section)))

-- --- the macro -----------------------------------------------------------------

@macro
@pub fun syntax (ts : [TokenTree]) : [TokenTree] ! { Mut, Expand | e } =
  match parseTokens call ts with
  | Err failed -> failed
  | Ok (name, sections) -> written name sections

fun written name sections =
  let lexer = V.foldl (\acc s -> match s with | Lexer l -> Just l | _ -> acc) None sections in
  let grammar = grammarOf sections in
  match (lexer, grammar) with
  | (None, _) -> [Fail "`syntax!` needs `lexer`, the Scythe token type it reads" Nowhere]
  | (_, None) -> [Fail "`syntax!` needs a `grammar`, in ungrammar" Nowhere]
  | (Just lx, Just (parsed, base)) ->
      match parsed with
      | Err (off, why) -> [Fail why (inGrammar (if base > 0 then base else 0) off 1)]
      | Ok (defs, start) ->
          let spec = {
          name = name,
            lexer = lx,
            public = V.any (\s -> match s with | Public -> True | _ -> False) sections,
            trivia = V.concatMap (\s -> match s with | Trivia ps -> ps | _ -> []) sections,
            tokens = V.concatMap (\s -> match s with | Table es -> es | _ -> []) sections,
            prec = V.foldl (\acc s -> match s with | Precedence e ls -> Just (e, ls) | _ -> acc) None sections,
            defs = defs,
            start = start
          } in
          match check spec with
          | Just failed -> failed
          | None ->
              -- The language the grammar implies, for `lang!` and `pass!`.
              let u = defineAs name (grammarLang spec) in
              generate spec

-- The rules, and where their offsets count from: a string's text, or -- for
-- a grammar in braces, whose pieces are where they are in the file -- the
-- file's start. -1 is a string the compiler cannot place.
fun grammarOf sections =
  V.foldl
    (\acc s ->
      match s with
      | Grammar g at start -> Just (withBase (parseGrammar g) (if start > 0 then start else 0 - 1), start)
      | GrammarTrees ts stop -> Just (withBase (parseGrammarTrees ts stop) 0, 0)
      | _ -> acc)
    None
    sections

-- Where byte `off` of the grammar is in the file, `n` bytes of it: `start`
-- is where the grammar's text begins -- 0 for one in braces, whose offsets
-- are the file's own -- and -1 where that is not known.
fun inGrammar (start : Int) (off : Int) (n : Int) : Loc = if start < 0 or off < 0 then Nowhere else At (start + off) (start + off + n)

-- A parse's rules, with where their offsets count from.
fun withBase r (base : Int) = match r with | Ok ds -> Ok (ds, base) | Err e -> Err e

-- --- what the grammar says -------------------------------------------------------

fun lookupDef spec n = V.find (\d -> defName d == n) spec.defs

-- An enum: a rule that is only an alternation of other rules.
fun isEnum (d : Def) : Bool =
  match defBody d with
  | Alt alts -> V.all (\a -> match a with | Ref _ _ -> True | _ -> False) alts
  | _ -> False

-- The kinds of node a rule's type can hold: its own, or an enum's
-- alternatives', all the way down.
fun kindsOf spec (n : String) : [String] =
  match lookupDef spec n with
  | Just d -> if isEnum d then V.concatMap (\a -> kindsOf spec a) (alternatives d) else [n]
  | None -> []

fun overlaps spec a b = V.any (\x -> V.elem x (kindsOf spec b)) (kindsOf spec a)

fun alternatives (d : Def) : [String] =
  match defBody d with
  | Alt alts -> V.concatMap (\a -> match a with | Ref n _ -> [n] | _ -> []) alts
  | _ -> []

-- The rule a body starts with, if it starts with one.
fun leading (r : Rule) : Maybe String =
  match r with
  | Ref n _ -> Just n
  | Label _ _ x -> leading x
  | Seq xs -> (match V.get xs 0 with | Just x -> leading x | None -> None)
  | _ -> None

-- What follows the first element of a sequence.
fun rest (r : Rule) : [Rule] =
  match r with
  | Seq xs -> V.drop xs 1
  | _ -> []

-- The alternatives of enum `e` that start with `e`: read after a left side.
fun ledAlts spec e =
  V.filter
    (\a -> match lookupDef spec a with | Just d -> leading (defBody d) == Just e | None -> False)
    (match lookupDef spec e with | Just d -> alternatives d | None -> [])

fun prefixAlts spec e =
  V.filter (\a -> not (V.elem a (ledAlts spec e))) (match lookupDef spec e with | Just d -> alternatives d | None -> [])

-- Every quoted token the grammar writes, with where.
fun quoted (r : Rule) : [(String, Int)] =
  match r with
  | Tok t at -> [(t, at)]
  | Ref _ _ -> []
  | Seq xs -> V.concatMap quoted xs
  | Alt xs -> V.concatMap quoted xs
  | Opt x -> quoted x
  | Rep x -> quoted x
  | Label _ _ x -> quoted x

fun refs (r : Rule) : [(String, Int)] =
  match r with
  | Tok _ _ -> []
  | Ref n at -> [(n, at)]
  | Seq xs -> V.concatMap refs xs
  | Alt xs -> V.concatMap refs xs
  | Opt x -> refs x
  | Rep x -> refs x
  | Label _ _ x -> refs x

-- --- FIRST sets ----------------------------------------------------------------

-- What a rule can start with, and whether it can be nothing, by rule name.
fun firsts spec : [(String, ([String], Bool))] = settle spec (V.map (\d -> (defName d, ([], False))) spec.defs) 0

fun settle spec env n =
  let next = V.map (\d -> (defName d, firstOf env (defBody d))) spec.defs in
  if next == env or n > 64 then next else settle spec next (n + 1)

fun firstOf env (r : Rule) : ([String], Bool) =
  match r with
  | Tok t _ -> ([t], False)
  | Ref n _ -> (match V.find (\e -> fst e == n) env with | Just e -> snd e | None -> ([], False))
  | Label _ _ x -> firstOf env x
  | Opt x -> (fst (firstOf env x), True)
  | Rep x -> (fst (firstOf env x), True)
  | Alt xs -> V.foldl (\acc x -> let f = firstOf env x in (union (fst acc) (fst f), snd acc or snd f)) ([], False) xs
  | Seq xs -> firstOfSeq env xs 0

fun firstOfSeq env xs i =
  match V.get xs i with
  | None -> ([], True)
  | Just x ->
      let f = firstOf env x in
      if snd f then (let more = firstOfSeq env xs (i + 1) in (union (fst f) (fst more), snd more)) else f

fun union (a : [String]) (b : [String]) : [String] = V.foldl (\acc x -> if V.elem x acc then acc else V.pushBack acc x) a b

fun overlap (a : [String]) (b : [String]) : [String] = V.filter (\x -> V.elem x b) a

-- --- checks ---------------------------------------------------------------------

fun check spec : Maybe [TokenTree] =
  let env = firsts spec in
  let problems =
    V.concat
      [ undefinedRefs spec,
        unknownTokens spec,
        duplicateRules spec,
        precedenceCovers spec env,
        enumConflicts spec env,
        fieldClashes spec ] in
    match V.get problems 0 with
    | Just (msg, loc) -> Just [Fail msg loc]
    | None -> None

fun undefinedRefs spec =
  V.concatMap
    (\d -> V.concatMap (\r -> match r with | (n, at) -> (match lookupDef spec n with | Just _ -> [] | None -> [("no rule is called `${n}`", inGrammar spec.start at (stringByteLength n))])) (refs (defBody d)))
    spec.defs

fun unknownTokens spec =
  V.concatMap
    (\d -> V.concatMap (\q -> match q with | (t, at) -> (if V.any (\e -> tokName e == t) spec.tokens then [] else [("`'${t}'` is not in `tokens`: say which of the lexer's tokens it is", inGrammar spec.start at (stringByteLength t + 2))])) (quoted (defBody d)))
    spec.defs

fun duplicateRules spec =
  V.concatMap
    (\i -> match V.get spec.defs i with
           | Just d -> (if V.any (\e -> defName e == defName d) (V.take spec.defs i) then [("`${defName d}` is defined twice", inGrammar spec.start (defAt d) (stringByteLength (defName d)))] else [])
           | None -> [])
    (V.range 0 (V.len spec.defs))

-- Every alternative that starts with its own enum has to be read after a
-- left side: an operator in the table, or a postfix form named there.
fun precedenceCovers spec env =
  V.concatMap
    (\d ->
      if not (isEnum d) then []
      else
        V.concatMap
          (\a ->
            let covered =
              (match spec.prec with
               | Just (e, ls) -> e == defName d and (postfixes ls a or V.all (\t -> V.elem t (operators ls)) (trigger spec env a))
               | None -> False) in
              if covered then []
              else [("`${a}` starts with `${defName d}`: give its operator a place in `precedence ${defName d}`, or name it `postfix`", whereDef spec a)])
          (ledAlts spec (defName d)))
    spec.defs

fun postfixes ls a = V.any (\l -> fst l == "postfix" and V.elem a (snd l)) ls

fun operators ls = V.concatMap (\l -> if fst l == "postfix" then [] else snd l) ls

-- What a left-recursive alternative is recognised by: the start of what
-- follows its left side.
fun trigger spec env a =
  match lookupDef spec a with
  | Just d -> fst (firstOf env (Seq (rest (defBody d))))
  | None -> []

fun enumConflicts spec env =
  V.concatMap
    (\d ->
      if not (isEnum d) then []
      else
        let alts = prefixAlts spec (defName d) in
        V.concatMap
          (\i ->
            V.concatMap
              (\j ->
                match (V.get alts i, V.get alts j) with
                | (Just a, Just b) ->
                    let shared = overlap (firstOfName env a) (firstOfName env b) in
                    if i < j and not (V.isEmpty shared) then
                      [("`${a}` and `${b}` can both start with `'${V.getOr "" shared 0}'`: an enum's alternatives must start differently", whereDef spec (defName d))]
                    else []
                | _ -> [])
              (V.range 0 (V.len alts)))
          (V.range 0 (V.len alts)))
    spec.defs

fun firstOfName env n = match V.find (\e -> fst e == n) env with | Just e -> fst (snd e) | None -> []

fun whereDef spec n = match lookupDef spec n with | Just d -> inGrammar spec.start (defAt d) (stringByteLength n) | None -> Nowhere

-- --- writing the parser ------------------------------------------------------------

fun tokName e = match e with | (t, _, _) -> t

-- The kind a quoted token is: the constructor its pattern starts with.
fun tokKind spec t =
  match V.find (\e -> tokName e == t) spec.tokens with
  | Just (_, _, pat) -> ctorOf pat
  | None -> "Unknown"

fun ctorOf (pat : [TokenTree]) : String =
  match V.get pat 0 with
  | Just (Word w _) -> w
  | _ -> "Unknown"

-- --- names ---------------------------------------------------------------------------
--
-- Everything `syntax! { Mini … }` makes is named after `Mini`, so nothing it
-- makes can be a name of the program's own, or of another `syntax!`'s:
--
--   Mini                 the kinds: `Mini.Node<Rule>` for each node rule,
--                        `Mini.Token<Token>` for each of the lexer's tokens, and
--                        `Mini.ErrorNode`, `Mini.Eof` and `Mini.Unknown`. A
--                        rule and a token of one name are two kinds, and none
--                        of them is one of the three.
--   Mini<Rule>           the typed AST: `MiniIf`, `MiniExpr`
--   asMini<Rule>, syntaxMini<Rule>, mini<Rule><Field>
--                        its casts and accessors
--   parseMini, astMini   the entry points
--   linguaMini_<x>       everything else: rule names start upper case, and the
--                        parser's own helpers lower
--
-- A kind displays as its rule's or token's own name, which is what a tree's
-- dump and an editor's colours read.

fun kindType spec = spec.name

-- The kind of node rule `r`, of the lexer's token `c`, and the three every
-- tree may need.
fun kn spec r = "${spec.name}.Node${r}"

fun kt spec c = "${spec.name}.Token${c}"

fun kx spec c = "${spec.name}.${c}"

-- The kind a quoted token is.
fun kq spec t =
  match V.find (\e -> tokName e == t) spec.tokens with
  | Just (_, _, pat) -> kt spec (ctorOf pat)
  | None -> kx spec "Unknown"

-- The typed AST's type for rule `r`.
fun ty spec r = "${spec.name}${r}"

fun fn spec r = "lingua${spec.name}_${r}"

fun anyOf spec env ts = "LinguaP.atAny p [${S.join ", " (V.map (\t -> kq spec t) ts)}]"

-- The kinds, as constructor and display name: every node rule, every token
-- the table names and the trivia, and the three every tree may need.
fun kinds spec : [(String, String)] =
  let nodes = V.map (\d -> ("Node${defName d}", defName d)) (V.filter (\d -> not (isEnum d)) spec.defs) in
  let toks = V.map (\c -> ("Token${c}", c)) (union (V.map (\e -> match e with | (_, _, pat) -> ctorOf pat) spec.tokens) (V.map ctorOf spec.trivia)) in
  V.concat [nodes, toks, V.map (\c -> (c, c)) ["ErrorNode", "Eof", "Unknown"]]

fun generate spec : [TokenTree] ! { Mut | e } =
  let env = firsts spec in
  let counter = newRef 0 in
  let root = (match V.get spec.defs 0 with | Just d -> defName d | None -> "File") in
  let pub = if spec.public then "@pub " else "" in
  let lx = spec.lexer in
  V.concat
    [ [Code (header spec pub)],
      classify spec,
      [Code (V.foldl (\acc d -> acc ++ "\n" ++ ruleFun spec env counter root d) "" spec.defs),
        Code (entry spec pub root lx)],
      typed spec pub root ]

fun header spec pub =
  "use Lingua.Parser as LinguaP
use Lingua.Build as LinguaB
use Lingua.Red as LinguaR
use Lingua.Red (Syntax)
use Lingua.Ast as LinguaA
use Lingua.Green as LinguaG
use Scythe as LinguaScythe
use Std.Collections.Vector as LinguaV

@derive(Debug, PartialEq)
${pub}data ${kindType spec} = ${S.join " | " (V.map fst (kinds spec))}

impl Display ${kindType spec} {
  fun display x =
    match x with
${S.join "\n" (V.map (\c -> "    | ${kx spec (fst c)} -> \"${snd c}\"") (kinds spec))}
}

-- How a kind is named in a message: a token as it is written, a node by its rule.
fun ${fn spec "name"} (x : ${kindType spec}) : String =
  match x with
${S.join "\n" (V.map (\e -> match e with | (t, _, pat) -> "  | ${kt spec (ctorOf pat)} -> \"`${escape t}`\"") spec.tokens)}
  | other -> display other
"

-- The lexer's tokens as kinds, each pattern where the table wrote it; and
-- which of them are trivia.
fun classify spec : [TokenTree] =
  let arm = \pat -> V.concat [[Punct "|" Nowhere], qualify spec pat, [Code "-> ${kt spec (ctorOf pat)}"]] in
  V.concat
    [ [Code "fun ${fn spec "kindOf"} (t : ${spec.lexer}) : ${kindType spec} =\n  match t with"],
      V.concatMap (\e -> match e with | (_, _, pat) -> arm pat) spec.tokens,
      V.concatMap arm spec.trivia,
      [Code "  | _ -> ${kx spec "Unknown"}\n\nfun ${fn spec "isTrivia"} (x : ${kindType spec}) : Bool =\n  match x with"],
      V.concatMap (\pat -> [Code "| ${kt spec (ctorOf pat)} -> True"]) spec.trivia,
      [Code "| ${kx spec "Unknown"} -> True\n  | _ -> False\n"] ]

-- `Ident _` as `Token.Ident _`, still where it was written.
fun qualify spec pat =
  match V.get pat 0 with
  | Just (Word w at) -> V.pushFront (V.drop pat 1) (Word "${spec.lexer}.${w}" at)
  | _ -> pat

-- `s` as it goes inside a string literal.
fun escape (s : String) : String =
  S.join
    ""
    (V.map
      (\i ->
        let c = stringSlice s i (i + 1) in
        if c == "\"" then "\\\"" else if c == "\\" then "\\\\" else if c == "$" then "\\$" else c)
      (V.range 0 (stringByteLength s)))

fun fresh counter = let n = getRef counter in let u = setRef counter (n + 1) in n

-- A rule's parse function: a node opens, reads its body, and closes; an enum
-- chooses an alternative, then -- if it has left-recursive ones -- reads them
-- after the left side, Pratt style.
fun ruleFun spec env counter root d =
  let name = defName d in
  if isEnum d then enumFun spec env counter d
  else if name == root then
    "fun ${fn spec name} p =
  let m = LinguaP.open p in
  let rec go u =
    let _ = ${body spec env counter "" (defBody d)} in
    if LinguaP.atEnd p then () else (let _ = LinguaP.advanceWithError p \"unexpected ${escape name} content\" in go ())
  in
  let _ = go () in
  LinguaP.close p m ${kn spec name}
"
  else
    "fun ${fn spec name} p =
  let m = LinguaP.open p in
  let _ = ${body spec env counter "" (defBody d)} in
  LinguaP.close p m ${kn spec name}
"

-- The code that reads `r`, answering `()`. `self` is the enum a Pratt tail is
-- read for: its last element, if it is that enum, is read at a binding power.
fun body spec env counter self (r : Rule) : String ! { Mut | e } =
  match r with
  | Tok t _ -> "LinguaP.expect p ${kq spec t}"
  | Ref n _ -> "(let _ = ${fn spec n} p in ())"
  | Label _ _ x -> body spec env counter self x
  | Seq xs -> "(" ++ V.foldl (\acc x -> acc ++ "let _ = ${body spec env counter self x} in ") "" xs ++ "())"
  | Opt x -> "(if ${anyOf spec env (fst (firstOf env x))} then ${body spec env counter self x} else ())"
  | Rep x ->
      let n = fresh counter in
      "(let rec loop${show n} u = if ${anyOf spec env (fst (firstOf env x))} then (let _ = ${body spec env counter self x} in loop${show n} ()) else () in loop${show n} ())"
  | Alt xs ->
      V.foldr
        (\x acc -> "(if ${anyOf spec env (fst (firstOf env x))} then ${body spec env counter self x} else ${acc})")
        "LinguaP.error p \"expected one of ${escape (S.join ", " (V.map (\x -> S.join " " (fst (firstOf env x))) xs))}\""
        xs

fun enumFun spec env counter d =
  let e = defName d in
  let alts = prefixAlts spec e in
  let dispatch =
    V.foldr
      (\a acc -> "if ${anyOf spec env (firstOfName env a)} then ${fn spec a} p else ${acc}")
      "(let _ = LinguaP.error p \"expected ${e}\" in 0 - 1)"
      alts in
    if V.isEmpty (ledAlts spec e) then
      "fun ${fn spec e} p = ${dispatch}
"
    else
      "fun ${fn spec e} p = ${fn spec ("bp" ++ e)} p 0

fun ${fn spec ("bp" ++ e)} p (minBp : Int) : Int ! { St s | e } =
  let lhs = ${dispatch} in
  if lhs < 0 then lhs else ${fn spec ("led" ++ e)} p minBp lhs

fun ${fn spec ("led" ++ e)} p (minBp : Int) (lhs : Int) : Int ! { St s | e } =
  ${ledBranches spec env counter e}lhs
"

-- One branch per level of the table and per postfix form: at its trigger and
-- binding tighter than what is being read, wrap the left side and read on.
fun ledBranches spec env counter e =
  match spec.prec with
  | None -> ""
  | Just (_, ls) ->
      let top = V.len ls + 1 in
      V.foldl
        (\acc i ->
          match V.get ls i with
          | Just (assoc, items) ->
              let lbp = 2 * (i + 1) in
              if assoc == "postfix" then
                acc ++ V.foldl (\acc2 a -> acc2 ++ branch spec env counter e a (fst (firstOf env (Seq (restOf spec a)))) (2 * top) 0) "" items
              else
                let rbp = if assoc == "right" then lbp - 1 else lbp + 1 in
                acc ++ V.foldl (\acc2 a -> acc2 ++ branch spec env counter e a items lbp rbp) "" (altsFor spec env e items)
          | None -> acc)
        ""
        (V.range 0 (V.len ls))

-- The left-recursive alternatives whose trigger is among `ops`.
fun altsFor spec env e ops = V.filter (\a -> not (V.isEmpty (overlap (trigger spec env a) ops))) (ledAlts spec e)

fun restOf spec a = match lookupDef spec a with | Just d -> rest (defBody d) | None -> []

fun branch spec env counter e a triggers lbp rbp =
  "if ${anyOf spec env triggers} and ${show lbp} > minBp then
    let m = LinguaP.openBefore p lhs in
    let _ = ${tail spec env counter e (restOf spec a) rbp} in
    ${fn spec ("led" ++ e)} p minBp (LinguaP.close p m ${kn spec a})
  else "

-- What follows the left side, its last element -- the right side, when it is
-- the enum again -- read at binding power `rbp`.
fun tail spec env counter e xs rbp =
  "(" ++ V.foldl (\acc i -> acc ++ "let _ = ${elementAt spec env counter e xs i rbp} in ") "" (V.range 0 (V.len xs)) ++ "())"

fun elementAt spec env counter e xs i rbp =
  match V.get xs i with
  | Just x ->
      if i == V.len xs - 1 and leading x == Just e and not (isSeq x) then
        "(let _ = ${fn spec ("bp" ++ e)} p ${show rbp} in ())"
      else body spec env counter e x
  | None -> "()"

fun isSeq x = match x with | Seq _ -> True | _ -> False

-- `parseCalc`: lex, parse, build.
fun entry spec pub root lx =
  "-- The lexer's tokens, and the text between them it skipped, as trivia: every
-- byte of `input`, in order.
fun ${fn spec "lexemes"} (input : String) ts =
  let n = stringByteLength input in
  let step = \\acc l ->
    match acc with
    | (out, at) ->
        let s = LinguaScythe.start l in
        let e = LinguaScythe.stop l in
        let out2 = if s > at then LinguaV.pushBack out (LinguaB.lexeme ${kx spec "Unknown"} (stringSlice input at s) True) else out in
        let kd = ${fn spec "kindOf"} (LinguaScythe.token l) in
        (LinguaV.pushBack out2 (LinguaB.lexeme kd (stringSlice input s e) (${fn spec "isTrivia"} kd)), e)
  in
  match LinguaV.foldl step ([], 0) ts with
  | (out, at) -> if at < n then LinguaV.pushBack out (LinguaB.lexeme ${kx spec "Unknown"} (stringSlice input at n) True) else out

-- `input` as a lossless tree, and every error with the byte it is at: a pure
-- function of the text.
${pub}fun parse${spec.name} (input : String) =
  match lex${lx} input with
  | Err err ->
      (LinguaG.node ${kn spec root} [LinguaG.token ${kx spec "Unknown"} input], [(LinguaScythe.errorAt err, \"the lexer stopped here\")])
  | Ok ts ->
      let lexemes = ${fn spec "lexemes"} input ts in
      let kinds = LinguaV.toArray (LinguaV.map LinguaB.lexemeKind (LinguaV.filter (\\l -> not (LinguaB.lexemeTrivia l)) lexemes)) in
      let events =
        runSt (\\() ->
          let p = LinguaP.parser kinds ${kx spec "Eof"} ${kx spec "ErrorNode"} ${fn spec "name"} in
          let _ = ${fn spec root} p in
          LinguaP.events p) in
      LinguaB.build ${kn spec root} events lexemes
"

-- --- the typed AST -----------------------------------------------------------------
--
-- Each node rule a type over `Syntax`, each enum a sum of its alternatives, and
-- each element of a node an accessor named for its label -- ungrammar's
-- contract -- or, without one, for what it is: `name` for a `Name`, `names`
-- for a `Name*`, `letToken` for a `'let'`.

-- A child an accessor reads: a node of a rule, or a token of these quoted
-- names; one, or every one.
data Slot = NodeField String String Bool | TokField String [String] Bool

use Slot.*

fun fieldName f = match f with | NodeField n _ _ -> n | TokField n _ _ -> n

fun fieldsOf spec (r : Rule) (many : Bool) : [Slot] =
  match r with
  | Tok t _ -> [TokField (lowerFirst (tokKind spec t) ++ "Token") [t] many]
  | Ref n _ -> [NodeField (lowerFirst n ++ (if many then "s" else "")) n many]
  | Label l _ x -> labelled spec l x many
  | Opt x -> fieldsOf spec x many
  | Rep x -> fieldsOf spec x True
  | Seq xs -> V.concatMap (\x -> fieldsOf spec x many) xs
  | Alt xs -> V.concatMap (\x -> fieldsOf spec x many) xs

-- `label:x`: one accessor for all of `x`. Its nodes, when it has any -- all of
-- one rule, as many as there may be -- and otherwise its tokens.
fun labelled spec l x many =
  let inner = fieldsOf spec x many in
  let nodes = V.filter (\f -> match f with | NodeField _ _ _ -> True | _ -> False) inner in
  match V.get nodes 0 with
  | Just (NodeField _ n m) -> [NodeField l n (many or m or V.len nodes > 1)]
  | _ ->
      let toks = V.concatMap (\f -> match f with | TokField _ ts _ -> ts | _ -> []) inner in
      [TokField l toks (many or V.any (\f -> match f with | TokField _ _ m -> m | _ -> False) inner)]

fun fieldsOfDef spec d = if isEnum d then [] else fieldsOf spec (defBody d) False

-- Where each of `fieldsOf`'s slots was written, in the same order: its name
-- -- the label, or the rule or token it is named for -- and, for a node, the
-- rule it holds. -1 for a place there is none.
fun slotsAt (r : Rule) : [(Int, Int)] =
  match r with
  | Tok _ at -> [(at, 0 - 1)]
  | Ref _ at -> [(at, at)]
  | Label _ at x -> [(at, firstRef x)]
  | Opt x -> slotsAt x
  | Rep x -> slotsAt x
  | Seq xs -> V.concatMap slotsAt xs
  | Alt xs -> V.concatMap slotsAt xs

fun firstRef (r : Rule) : Int = match V.get (refs r) 0 with | Just (_, at) -> at | None -> 0 - 1

fun slotsAtDef d = if isEnum d then [] else slotsAt (defBody d)

-- `name` as a token of the generated code: written where the grammar wrote
-- what it is named for, `n` bytes of it, so that hovering there shows it and
-- going to its definition arrives there; or, placed nowhere, as text.
fun named spec (name : String) (at : Int) (n : Int) : TokenTree =
  match inGrammar spec.start at n with
  | Nowhere -> Code name
  | loc -> Word name loc

-- Code, and spanned names, as one list of tokens.
fun tokensOf (parts : [TokenTree]) : [TokenTree] = parts

fun fieldClashes spec =
  V.concatMap
    (\d ->
      let fs = fieldsOfDef spec d in
      V.concatMap
        (\i ->
          match V.get fs i with
          | Just f ->
              if V.any (\g -> fieldName g == fieldName f) (V.take fs i) then
                [("`${defName d}` has two children that would both be `${fieldName f}`: give them labels", whereDef spec (defName d))]
              else []
          | None -> [])
        (V.range 0 (V.len fs)))
    spec.defs

fun lowerFirst (s : String) : String =
  if stringByteLength s == 0 then s
  else
    let c = stringSlice s 0 1 in
    let b = toInt (stringByteAt s 0) in
    (if b >= 65 and b <= 90 then stringSlice "abcdefghijklmnopqrstuvwxyz" (b - 65) (b - 64) else c) ++ stringSlice s 1 (stringByteLength s)

fun upperFirst (s : String) : String =
  if stringByteLength s == 0 then s
  else
    let b = toInt (stringByteAt s 0) in
    (if b >= 97 and b <= 122 then stringSlice "ABCDEFGHIJKLMNOPQRSTUVWXYZ" (b - 97) (b - 96) else stringSlice s 0 1) ++ stringSlice s 1 (stringByteLength s)

-- The typed AST. The names it gives a rule -- its type and its cast -- are
-- written where the rule's name is, an accessor where its label is, and the
-- rule a field holds where the grammar names it: a grammar in braces then
-- hovers as what it generates, and what it generates goes to its definition
-- in the grammar.
fun typed spec pub root : [TokenTree] =
  V.concat
    [ [Code "-- --- the typed AST ---------------------------------------------------------\n\n"],
      V.concatMap (\d -> if isEnum d then enumType spec pub d else nodeType spec pub d) spec.defs,
      [Code "\n-- The typed root of a tree `parse${spec.name}` made.\n${pub}fun ast${spec.name} g : Maybe ${ty spec root} = as${ty spec root} (LinguaR.root g)\n"] ]

-- `name` where rule `d`'s name is.
fun atRule spec d name = named spec name (defAt d) (stringByteLength (defName d))

fun nodeType spec pub d : [TokenTree] =
  let r = ty spec (defName d) in
  let kt = kindType spec in
  let fs = fieldsOfDef spec d in
  let ats = slotsAtDef d in
  V.concat
    [ [Code "${pub}data ", atRule spec d r, Code " = ${r} (Syntax ${kt})\n\n${pub}fun ", atRule spec d "as${r}",
       Code " (s : Syntax ${kt}) : Maybe ${r} = if LinguaR.kindOf s == ${kn spec (defName d)} then Just (${r}.${r} s) else None\n\n${pub}fun syntax${r} (x : ${r}) : Syntax ${kt} = match x with | ${r}.${r} s -> s\n"],
      V.concatMap (\i -> accessor spec pub r fs ats i) (V.range 0 (V.len fs)),
      [Code "\n"] ]

-- The accessor for field `i` of rule `r`. Two single children of one rule are
-- told apart by position: `lhs` is the first `Expr`, `rhs` the second. When an
-- earlier child's type can hold a node this one's can -- `func:Expr arg:Atom`,
-- where every `Atom` is an `Expr` -- counting by type would find the earlier
-- child again, so the position among all child nodes is what says which it is.
fun accessor spec pub r fs ats i : [TokenTree] =
  let kt = kindType spec in
  let field = match V.get fs i with | Just f -> fieldName f | None -> "" in
  let name = "${lowerFirst r}${upperFirst field}" in
  let at = V.getOr (0 - 1, 0 - 1) ats i in
  -- The accessor where its label -- or the rule or token it is named for --
  -- is, and the cast to the rule it holds where the grammar names that rule:
  -- a cast, not the type, since a function hovers with its type and goes to
  -- its definition, which is at the rule.
  let fn = named spec name (fst at) (stringByteLength (fieldBare field)) in
  let cast = \n -> named spec "as${ty spec n}" (snd at) (stringByteLength n) in
  let subject = " ${subject0 r}\n" in
  let head = \ret -> [Code "\n${pub}fun ", fn, Code " (x : ${r}) : ${ret} = "] in
  match V.get fs i with
  | Just (NodeField _ n True) -> V.concat [head "[${ty spec n}]", [Code "LinguaA.childrenOf ", cast n, Code subject]]
  | Just (NodeField _ n False) ->
      let prior = V.take fs i in
      let overlapping = V.any (\f -> match f with | NodeField _ m _ -> m != n and overlaps spec m n | _ -> False) prior in
      let single = V.all (\f -> match f with | NodeField _ _ many -> not many | _ -> True) prior in
      if overlapping and single then
        let k = V.len (V.filter (\f -> match f with | NodeField _ _ _ -> True | _ -> False) prior) in
        V.concat [head "Maybe ${ty spec n}", [Code "LinguaA.nthNodeAs ", cast n, Code " ${show k}${subject}"]]
      else
        let before = V.len (V.filter (\f -> match f with | NodeField _ m False -> m == n | _ -> False) prior) in
        V.concat [head "Maybe ${ty spec n}", [Code "LinguaA.nthChild ", cast n, Code " ${show before}${subject}"]]
  | Just (TokField _ ts True) -> V.concat [head "[Syntax ${kt}]", [Code "LinguaA.tokensOf [${S.join ", " (V.map (\t -> kq spec t) ts)}]${subject}"]]
  | Just (TokField _ ts False) -> V.concat [head "Maybe (Syntax ${kt})", [Code "LinguaA.tokenOf [${S.join ", " (V.map (\t -> kq spec t) ts)}]${subject}"]]
  | None -> []

fun subject0 r = "(syntax${r} x)"

-- Enum `e`'s cast: each alternative tried in turn, its cast where the enum
-- names it -- in groups, since a piece of code has to balance its own
-- brackets.
fun enumCast spec e (written : [(String, Int)]) : TokenTree =
  V.foldr (\w acc -> Group Paren (alternative spec e w acc) Nowhere) (Code "None") written

fun alternative spec e w acc =
  match w with
  | (a, at) -> [Code "match ", named spec "as${ty spec a}" at (stringByteLength a), Code " s with | Just y -> Just (${e}.${a} y) | None -> ", acc]

fun enumType spec pub d : [TokenTree] =
  let e = ty spec (defName d) in
  let kt = kindType spec in
  let alts = alternatives d in
  let written = refs (defBody d) in
  let cast = enumCast spec e written in
  V.concat
    [ [Code "${pub}data ", atRule spec d e, Code " = ${S.join " | " (V.map (\a -> "${a} ${ty spec a}") alts)}\n\n${pub}fun ", atRule spec d "as${e}",
       Code " (s : Syntax ${kt}) : Maybe ${e} = ", cast,
       Code "\n\n${pub}fun syntax${e} (x : ${e}) : Syntax ${kt} =\n  match x with\n${S.join "\n" (V.map (\a -> "  | ${e}.${a} y -> syntax${ty spec a} y") alts)}\n\n"] ]

-- --- the language the grammar implies ------------------------------------------------
--
-- What `lang! { Surface from Calc }` starts from. An enum is a sort, its
-- alternatives its productions; a node rule that is no enum's alternative is
-- a sort of one production. A production's fields are its slots in the typed
-- AST -- the same names, read by the same accessors -- less the tokens that
-- say nothing: a token is kept when it is labelled or carries text of its own
-- (`Ident _`), and `'let'` and `';'` are not.

fun grammarLang spec : Lang =
  let enums = V.filter isEnum spec.defs in
  let alts = V.concatMap alternatives enums in
  let enumSorts = V.map (\d -> Sort (defName d) (V.map (\a -> prodOf spec a) (alternatives d))) enums in
  let loners = V.map (\d -> Sort (defName d) [prodOf spec (defName d)]) (V.filter (\d -> not (isEnum d) and not (V.elem (defName d) alts)) spec.defs) in
  let root = (match V.get spec.defs 0 with | Just d -> defName d | None -> "File") in
  Lang spec.name root (V.append enumSorts loners) spec.name []

-- The production of rule `r`: an enum inside an enum is a production holding
-- that enum's sort.
fun prodOf spec r =
  match lookupDef spec r with
  | Just d ->
      if isEnum d then Prod r [Field (lowerFirst r) (TSort r) "" False]
      else
        let slots = fieldsOfDef spec d in
        let opts = optsOf (defBody d) False in
        Prod r (V.concatMap (\i -> fieldOf spec r (V.get slots i) (V.getOr False opts i)) (V.range 0 (V.len slots)))
  | None -> Prod r []

fun fieldOf spec r slot opt =
  let accessorOf = \name -> "${lowerFirst (ty spec r)}${upperFirst name}" in
  let shape = \many base -> if many then TMany base else if opt then TOpt base else base in
  match slot with
  | Just (NodeField name n many) -> [Field name (shape many (TSort n)) (accessorOf name) False]
  | Just (TokField name ts many) ->
      if kept spec name ts then [Field (fieldBare name) (shape many (TPrim "String")) (accessorOf name) True] else []
  | None -> []

-- Whether a token slot says anything: labelled, or a token with text.
fun kept spec name ts =
  V.len ts > 1
    or not (V.any (\t -> name == lowerFirst (tokKind spec t) ++ "Token") ts)
    or V.any (\t -> match V.find (\e -> tokName e == t) spec.tokens with | Just (_, _, pat) -> V.len pat > 1 | None -> False) ts

-- `numberToken` is a field `number`.
fun fieldBare name =
  let n = stringByteLength name in
  if n > 5 and stringSlice name (n - 5) n == "Token" then stringSlice name 0 (n - 5) else name

-- For each slot, in the order `fieldsOf` makes them, whether it is under `?`.
fun optsOf (r : Rule) (opt : Bool) : [Bool] =
  match r with
  | Tok _ _ -> [opt]
  | Ref _ _ -> [opt]
  | Label _ _ x -> [opt or isOptional x]
  | Opt x -> optsOf x True
  | Rep x -> optsOf x opt
  | Seq xs -> V.concatMap (\x -> optsOf x opt) xs
  | Alt xs -> V.concatMap (\x -> optsOf x opt) xs

fun isOptional x = match x with | Opt _ -> True | _ -> False
