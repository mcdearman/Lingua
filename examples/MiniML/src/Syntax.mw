-- MiniML's syntax: its tokens, the grammar Lingua makes a parser, a lossless
-- tree and a typed AST of (`syntax!`), and the language the grammar implies
-- (`lang!`).

use Scythe (lexer!)
use Lingua (syntax!, lang!, format!)
use Lingua.Green (dump)

-- Whitespace and `--` comments are tokens -- no `@skip` -- so the tree keeps
-- them, and every program comes back byte for byte.
@derive(Lexer)
@pub data Token
  = @regex("[ \t\r\n]+") Whitespace
  | @regex("--[^\n]*") Comment
  | @token("let") Let
  | @token("rec") Rec
  | @token("in") In
  | @token("fun") Fun
  | @token("if") If
  | @token("then") Then
  | @token("else") Else
  | @token("true") True
  | @token("false") False
  | @token("(") LParen
  | @token(")") RParen
  | @token("->") Arrow
  | @token("=") Equals
  | @token("==") EqEq
  | @token("<=") Le
  | @token(">=") Ge
  | @token("<") Lt
  | @token(">") Gt
  | @token("+") Plus
  | @token("-") Minus
  | @token("*") Star
  | @token("/") Slash
  | @regex("[0-9]+") Number String
  | @regex("[a-zA-Z_][a-zA-Z0-9_]*") Ident String

-- Application is two operands side by side, as Meadow's own parser reads it:
-- an atom after an expression is an argument to it. So `f x y` is `(f x) y`,
-- and `f x + 1` is `(f x) + 1` -- the argument is one atom, and binds tighter
-- than any operator.
@pub(pkg) syntax! {
  pub Mini
  lexer Token
  trivia { Whitespace, Comment }
  tokens {
    "let" = Let,
    "rec" = Rec,
    "in" = In,
    "fun" = Fun,
    "if" = If,
    "then" = Then,
    "else" = Else,
    "true" = True,
    "false" = False,
    "(" = LParen,
    ")" = RParen,
    "->" = Arrow,
    "=" = Equals,
    "==" = EqEq,
    "<=" = Le,
    ">=" = Ge,
    "<" = Lt,
    ">" = Gt,
    "+" = Plus,
    "-" = Minus,
    "*" = Star,
    "/" = Slash,
    "ident" = Ident _,
    "int_number" = Number _
  }
  precedence Expr { left "==" "<=" ">=" "<" ">", left "+" "-", left "*" "/", postfix App }
  grammar {
    File = Expr

    Expr = Atom | Lam | Let | If | App | Bin

    App = func:Expr arg:Atom
    Bin = lhs:Expr op:("==" | "<=" | ">=" | "<" | ">" | "+" | "-" | "*" | "/") rhs:Expr

    Atom = Literal | BoolLit | NameRef | Paren
    Literal = "int_number"
    BoolLit = value:("true" | "false")
    NameRef = "ident"
    Paren = "(" Expr ")"

    Lam = "fun" params:Param* "->" body:Expr
    Let = "let" recursive:"rec"? name:Name params:Param* "=" value:Expr "in" body:Expr
    If = "if" cond:Expr "then" yes:Expr "else" no:Expr

    Name = "ident"
    Param = "ident"
  }
}

-- The language the grammar implies: what name resolution reads.
@pub(pkg) lang! { pub Surface from Mini }

-- How MiniML is set out (`format!`): what each rule holds, in the grammar's
-- order, which of it is a level in, and where it breaks when it does not fit
-- in the width. A `let`'s value goes after its `=` if it fits and under it
-- if not, and its body always starts a line; a function's body and an `if`'s
-- branches go on the line they follow, or under it, a level in.
-- `formatStyle` lays a program out by it, and `indentStyle` says where the
-- line after an unfinished one starts.
@pub(pkg) format! {
  pub Style for Mini
  indent 2
  width 80
    | Let = "let" recursive name params "=" group(indent(line value) line "in") newline body
    | Lam = "fun" params "->" indent(line body)
    | If = "if" cond indent(line "then" yes) indent(line "else" no)
    | Paren = "(" indent(cut expr) cut ")"
}

-- The tree of `input`, drawn.
@pub fun drawn (input : String) : String = match parseMini input with | (g, errs) -> dump display g

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)
use Std.Collections.Vector as V
use Std.String as S
use Lingua.Green (text)
use MiniML.Compiler (typeOfSource)
use Std.Result.Result.*

@test fun everyProgramComesBackByteForByte () =
  let a =
    assertEq
      (text (fst (parseMini "let rec f n = f n in f 1 -- loops\n")))
      "let rec f n = f n in f 1 -- loops\n"
      "a comment kept"
  in assertEq (text (fst (parseMini "let x = in (1"))) "let x = in (1" "and a broken one"

@test fun applicationTakesOneAtom () =
  -- `f x + 1` is `(f x) + 1`: the argument is an atom, and application binds
  -- tighter than any operator.
  assertEq
    (V.len (V.filter (\l -> S.trim l == "App") (S.split "\n" (drawn "f x + 1"))))
    1
    "one application, under the `+`"

@test fun keywordsAreNotIdentifiers () =
  assertEq (typeOfSource "letter") (Err "unbound variable: letter") "`let` is a prefix of `letter`"

@test fun aMissingPieceIsAnErrorWhereItWouldBe () =
  match parseMini "let x = in 1" with
  | (_, errs) -> assertEq errs [(8, "expected Expr")] "at the `in`"

-- The formatter.

-- The same rules in twenty columns, to see them break; and with no width at
-- all, which only sets lines in and leaves them broken where they were.
format! {
  Narrow for Mini
  indent 2
  width 20
    | Let = "let" recursive name params "=" group(indent(line value) line "in") newline body
    | Lam = "fun" params "->" indent(line body)
    | If = "if" cond indent(line "then" yes) indent(line "else" no)
    | Paren = "(" indent(cut expr) cut ")"
}

format! {
  Indents for Mini
  indent 2
    | Let = "let" recursive name params "=" indent(value) "in" body
    | Lam = "fun" params "->" indent(body)
    | If = "if" cond indent("then" yes) indent("else" no)
    | Paren = "(" indent(expr) ")"
}

fun laidOut (src : String) : String = formatStyle (fst (parseMini src))

fun narrow (src : String) : String = formatNarrow (fst (parseMini src))

fun formatted (src : String) : String = formatIndents (fst (parseMini src))

fun opens (src : String) : String = indentStyle (fst (parseMini src))

-- What was written, without the space between: what laying out must not change.
fun written (src : String) : String =
  S.join
    ""
    (V.concatMap
       (\i ->
         let c = stringSlice src i (i + 1) in
         if c == " " or c == "\n" or c == "\t" then [] else [c])
       (V.range 0 (stringByteLength src)))

@test fun whatFitsGoesOnOneLine () =
  assertEq
    (laidOut "let x =\n1 + 2\nin\n      if x < 3\nthen (\nx\n)\nelse fun y ->\ny\n")
    "let x = 1 + 2 in\nif x < 3 then (x) else fun y -> y\n"
    "the value after its `=`, the body on a line of its own, and each of them whole"

@test fun whatDoesNotFitBreaksWhereItsRuleSays () =
  let a =
    assertEq
      (narrow "let x = 1 + 2 in if x < 3 then (x) else fun y -> y")
      "let x = 1 + 2 in\nif x < 3\n  then (x)\n  else fun y -> y"
      "the `if` breaks before each branch, and each branch still fits"
  in assertEq
       (narrow "let total = (first + second + third) in total")
       "let total =\n  (\n    first + second + third\n  )\nin\ntotal"
       "the value under its `=`, and the parentheses around what they hold"

@test fun aNodeBreaksOnlyWhenItDoesNotFit () =
  -- The inner `let` has a body, which starts a line: so the outer value
  -- cannot go on one, and is under its `=`.
  assertEq
    (laidOut "let x = let y = 1 in y in x")
    "let x =\n  let y = 1 in\n  y\nin\nx"
    "a level in, and the `in` back out"

@test fun aCommentKeepsItsLineAndBreaksWhatHoldsIt () =
  assertEq
    (laidOut "let x = -- note\n1 in x")
    "let x =\n  -- note\n  1\nin\nx"
    "the comment before the value, where it was"

@test fun layingOutChangesOnlyTheSpace () =
  let srcs =
    [
      "let x =\n(1 +\nin x",
      "let rec f n = if n < 2 then 1 else n * f (n - 1) in f 5 -- five\n",
      "fun x -> fun y ->\n\n  x  +  y",
      "if a then",
      ")(",
      ""
    ]
  in
  let a =
    assertEq
      (V.map (\s -> written (narrow s)) srcs)
      (V.map written srcs)
      "every token still there, in order, broken program or not"
  in assertEq
       (V.map (\s -> narrow (narrow s)) srcs)
       (V.map narrow srcs)
       "and laid out twice is laid out once"

@test fun everyLineIsSetInAsTheRulesSay () =
  assertEq
    (formatted "let x =\n1 + 2\nin\n      if x < 3\nthen (\nx\n)\nelse fun y ->\ny\n")
    "let x =\n  1 + 2\nin\nif x < 3\n  then (\n    x\n  )\n  else fun y ->\n    y\n"
    "a level for the value, the branches, the parentheses and the body"

@test fun twoNodesBegunOnOneLineAreOneLevel () =
  -- The `let` and the `fun` both begin on the first line: what follows is in
  -- by one level, not two. On lines of their own, by one each.
  let a =
    assertEq
      (formatted "let f = fun y ->\ny + 1\nin f 2")
      "let f = fun y ->\n  y + 1\nin f 2"
      "one line, one level"
  in assertEq
       (formatted "let f =\nfun y ->\ny + 1\nin f 2")
       "let f =\n  fun y ->\n    y + 1\nin f 2"
       "two lines, two"

@test fun aFormattedProgramIsLeftAsItIs () =
  let src = "let x =\n  1 + 2 -- three\nin\n\nif x < 3\n  then x\n  else 0\n" in
  let a = assertEq (formatted src) src "nothing to do" in
  assertEq
    (formatted (formatted "let x =\n      1\n in x"))
    (formatted "let x =\n      1\n in x")
    "and doing it twice is doing it once"

@test fun aBrokenProgramIsFormattedAsFarAsItReads () =
  assertEq (formatted "let x =\n(1 +\nin x") "let x =\n  (1 +\nin x" "the value still a level in"

@test fun theNextLineStartsWhereTheFormatterWouldPutIt () =
  assertEq
    (V.map opens [
       "let x =", "let x = 1 +", "let x = 1 in", "let f = fun y ->", "let f =\n  fun y ->", "if a",
       "if a then", "(", "(a)", "f x", ""
     ])
    ["  ", "  ", "", "  ", "    ", "  ", "  ", "  ", "", "", ""]
    "a level for each line a node still open began on"
