-- Units, and building them (`make!`). A unit is a directory of `.ml` files
-- with a `Unit` file naming the units it depends on, a line each. Each file
-- exports its program under the file's name -- `lib/double.ml` is `double` --
-- and a unit's interface is what its files export, at their types.

use Lingua (make!)
use Lingua.Make (Given, Linking, unitSources, unitImports, unitOut, linkUnits, linkOut)
use Lingua.Diagnostic (renderToOutput)
use MiniML.Types
use MiniML.Compiler
use Std.Macro (Reflect, Datum, toDatum, fromDatum)
use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe as M
use Std.Path as Path
use Std.Fs (writeString)
use Std.Exn (toResult)
use Std.Result.Result.*

make! {
  pub Build "miniml"
    | sources = ".ml"
    | manifest = "Unit"
    | compile = compileUnit
}

-- What a unit exports: each file's name, and the type of its program.
@derive(Debug, PartialEq)
data Interface = Interface [(String, Type)]

impl Reflect Interface {
  fun toDatum i =
    match i with
    | Interface.Interface xs -> Datum.List (V.map (\x -> Datum.Tag (fst x) [toDatum (snd x)]) xs)
  fun fromDatum d =
    match d with
    | Datum.List ds ->
        V.foldl
          (\acc x ->
            match (acc, x) with
            | (Ok (Interface.Interface xs), Datum.Tag n ts) ->
                (match M.map fromDatum (V.get ts 0) with
                 | Just (Ok t) -> Ok (Interface.Interface (V.pushBack xs (n, t)))
                 | _ -> Err "an export's type")
            | (Err e, _) -> Err e
            | _ -> Err "an export")
          (Ok (Interface.Interface []))
          ds
    | _ -> Err "not an interface"
}

fun exports (i : Interface) : [(String, Type)] = match i with | Interface.Interface xs -> xs

-- The compiler, given a unit. Inside it, it is the compiler's business how
-- the work is done: here, as a batch -- the unit's files read once and the
-- passes run straight through, one file after another, with nothing kept for
-- the next build. Whether a unit is compiled at all is the build's to say,
-- and it is the build that runs units at once.
fun compileUnit (u : Given Interface) : Result String Interface ! { Thread, Mut, Fs | e } =
  match toResult (\() -> compiling u) with
  | Ok r -> r
  | Err why -> Err "${show why}\n"

fun compiling (u : Given Interface) =
  let sources = unitSources u in
  let files = V.range 1 (V.len sources + 1) in
  let db = batchSession () in
  let a = setSessionImports db 0 (V.concatMap (\i -> exports (snd i)) (unitImports u)) in
  let b =
    V.foldl (\acc i -> setSessionSource db i (snd (V.getOr ("", "") sources (i - 1)))) () files
  in
  let exported = sessionExported db files in
  let named =
    V.map (\i -> Path.fileStem (fst (V.getOr ("", "") sources i))) (V.range 0 (V.len sources))
  in if V.all M.isSome exported then
       (let interface =
          V.map
            (\i -> (V.getOr "" named i, M.unwrapOr Type.Int (V.getOr None exported i)))
            (V.range 0 (V.len named))
        in
        let e =
          writeString (
            Path.join (unitOut u) "types",
            S.join "" (V.map (\x -> "${fst x} : ${typeName (snd x)}\n") interface)
          )
        in Ok (Interface.Interface interface))
     else
       let linked = sessionLinkedEach db files in
       Err
         (S.join
            ""
            (V.map
               (\i ->
                 match (V.get sources i, V.get linked i) with
                 | (Just (path, text), Just (Err ds)) -> renderToOutput path text ds
                 | _ -> "")
               (V.range 0 (V.len sources))))

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)
use Std.Console (withOutput)
use Std.Fs (Fs, createDirAll, removeDirAll, removeFile, appendString, readToString)
use Std.Result as Res

-- Build `root` and say, for each unit, how it went.
fun built root =
  match withOutput (\() -> buildBuild root) with
  | (ok, said) -> (ok, V.filter (\l -> S.startsWith "   " l) (S.lines said))

fun write dir file text =
  let u = createDirAll dir in
  writeString (Path.join dir file, text)

@test fun aUnitIsBuiltAgainOnlyWhenWhatItReadChanged () =
  let root = "target/build-test" in
  let lib = Path.join root "lib" in
  let app = Path.join root "app" in
  let a = write lib "Unit" "" in
  let b = write lib "double.ml" "fun x -> x + x" in
  let c = write lib "id.ml" "fun x -> x" in
  let d = write app "Unit" "../lib\n" in
  let e = write app "main.ml" "double (id 21)" in
  let first = built app in
  let second = built app in
  -- The body changes, the type does not: `lib` is compiled, `app` is not.
  let f = write lib "double.ml" "fun x -> x * 2" in
  let third = built app in
  -- The type changes: both are.
  let g = write lib "double.ml" "fun x -> x > 1" in
  let fourth = built app in
  let h = write lib "double.ml" "fun x -> x + x" in
  assertEq
    [first, second, third, fourth]
    [
      (True, ["   Compiled lib", "   Compiled app"]),
      (True, ["   Fresh lib", "   Fresh app"]),
      (True, ["   Compiled lib", "   Fresh app"]),
      (True, ["   Compiled lib", "   Compiled app"])
    ]
    "each build"

-- What a build keeps: fingerprints in one small file, and each unit's
-- interface in a file of its own, read only when a unit that depends on it
-- is compiled again -- here `app`, whose own source changed while `lib` did
-- not. An interface that has gone missing is its unit compiled again.
@test fun aUnitsInterfaceIsKeptInAFileOfItsOwn () =
  let root = "target/build-kept" in
  let z = removeDirAll root in
  let lib = Path.join root "lib" in
  let app = Path.join root "app" in
  let a = write lib "Unit" "" in
  let b = write lib "double.ml" "fun x -> x + x" in
  let c = write app "Unit" "../lib\n" in
  let d = write app "main.ml" "double 21" in
  let first = built app in
  let e = write app "main.ml" "double 4" in
  let second = built app in
  let index = Res.unwrapOr "" (readToString (Path.joinAll [app, "target", "lingua-build.json"])) in
  let kept = Path.joinAll [app, "target", "interfaces", "lib.json"] in
  let there = Res.isOk (readToString kept) in
  let f = removeFile kept in
  let third = built app in
  let g =
    assertEq
      [first, second, third]
      [
        (True, ["   Compiled lib", "   Compiled app"]),
        (True, ["   Fresh lib", "   Compiled app"]),
        (True, ["   Compiled lib", "   Fresh app"])
      ]
      "`app` compiled against the interface `lib` left, and `lib` again when that was gone"
  in assertEq
       (S.contains "\"interface\"" index, S.contains "\"fingerprint\"" index, there)
       (False, True, True)
       "the index holds fingerprints, and the interface is beside it"

-- A unit's interface is kept after its answer has gone to what waits for it,
-- and a build is not done until it is: one that could not be kept -- here,
-- a file stands where the directory of interfaces should -- is a unit that
-- did not build, to be compiled again by the build after.
@test fun aUnitWhoseInterfaceCouldNotBeKeptIsNotBuilt () =
  let root = "target/build-unkept" in
  let z = removeDirAll root in
  let lib = Path.join root "lib" in
  let a = write lib "Unit" "" in
  let b = write lib "double.ml" "fun x -> x + x" in
  let c = write (Path.join lib "target") "interfaces" "in the way" in
  let first = built lib in
  let d = removeFile (Path.joinAll [lib, "target", "interfaces"]) in
  let second = built lib in
  let third = built lib in
  assertEq
    (fst first, V.map (\l -> S.startsWith "   Failed lib" l) (V.take (snd first) 2), second, third)
    (False, [False, True], (True, ["   Compiled lib"]), (True, ["   Fresh lib"]))
    "said compiled as its compiler answered, then failed; and built by the build after"

@test fun aUnitThatFailsBlocksWhatDependsOnIt () =
  let root = "target/build-fail" in
  let lib = Path.join root "lib" in
  let app = Path.join root "app" in
  let a = write lib "Unit" "" in
  let b = write lib "bad.ml" "1 + true" in
  let d = write app "Unit" "../lib\n" in
  let e = write app "main.ml" "bad" in
  match built app with
  | (ok, lines) ->
      assertEq
        (ok, V.getOr "" lines 0, V.getOr "" lines (V.len lines - 1))
        (False, "   Failed lib", "   Blocked app: lib did not build")
        "the failure, and what it stopped"

-- A build with a link: once its units are built, the program is put
-- together of what they wrote -- here, a line to each unit, and a line more
-- in a file beside it each time the link runs.
make! {
  Linked "miniml"
    | sources = ".ml"
    | manifest = "Unit"
    | compile = compileUnit
    | link = linkProgram
}

fun linkProgram (l : Linking Interface) : Result String () ! { Fs | e } =
  let names = V.map (\u -> match u with | (dir, _, _) -> Path.fileName dir) (linkUnits l) in
  let a = writeString (Path.join (linkOut l) "program", S.join "\n" names) in
  let b = appendString (Path.join (linkOut l) "runs", "ran\n") in
  Ok ()

@test fun aBuildIsLinkedAgainOnlyWhenAUnitWasCompiledFromSomethingElse () =
  let root = "target/build-link" in
  let z = removeDirAll root in
  let lib = Path.join root "lib" in
  let app = Path.join root "app" in
  let a = write lib "Unit" "" in
  let b = write lib "double.ml" "fun x -> x + x" in
  let d = write app "Unit" "../lib\n" in
  let e = write app "main.ml" "double 21" in
  let lines =
    \r ->
      match r with
      | (ok, said) -> (ok, V.filter (\l -> S.startsWith "   " l) (S.lines said))
  in
  let first = lines (withOutput (\() -> buildLinked app)) in
  let second = lines (withOutput (\() -> buildLinked app)) in
  -- A body changes and no interface does: one unit is compiled, and what
  -- it wrote is another program's, so the link runs.
  let f = write lib "double.ml" "fun x -> x * 2" in
  let third = lines (withOutput (\() -> buildLinked app)) in
  let out = Path.joinAll [app, "target", "link"] in
  assertEq
    (
      [first, second, third],
      readToString (Path.join out "program"),
      M.map (\t -> V.len (S.lines t)) (Res.toMaybe (readToString (Path.join out "runs")))
    )
    (
      [
        (True, ["   Compiled lib", "   Compiled app", "   Linked app"]),
        (True, ["   Fresh lib", "   Fresh app", "   Fresh link"]),
        (True, ["   Compiled lib", "   Fresh app", "   Linked app"])
      ],
      Ok "lib\napp",
      Just 2
    )
    "each build, the program, and how often it was put together"

-- The same build with no thread in it: `| parallel = false`.
make! {
  InTurn "miniml"
    | sources = ".ml"
    | manifest = "Unit"
    | compile = compileUnit
    | parallel = false
}

@test fun aBuildInTurnBuildsTheSame () =
  let root = "target/build-in-turn" in
  -- From nothing: what an earlier run of this test built would be up to date.
  let z = removeDirAll root in
  let a = write (Path.join root "one") "Unit" "" in
  let b = write (Path.join root "one") "double.ml" "fun x -> x + x" in
  let c = write (Path.join root "two") "Unit" "" in
  let d = write (Path.join root "two") "id.ml" "fun x -> x" in
  let e = write (Path.join root "app") "Unit" "../one\n../two\n" in
  let f = write (Path.join root "app") "main.ml" "double (id 21)" in
  let lines =
    \r ->
      match r with
      | (ok, said) -> (ok, V.filter (\l -> S.startsWith "   " l) (S.lines said))
  in
  let first = lines (withOutput (\() -> buildInTurn (Path.join root "app"))) in
  let second = lines (withOutput (\() -> buildInTurn (Path.join root "app"))) in
  assertEq
    [first, second]
    [
      (True, ["   Compiled one", "   Compiled two", "   Compiled app"]),
      (True, ["   Fresh one", "   Fresh two", "   Fresh app"])
    ]
    "each unit, one after another"

@test fun aUnitStartsWhenWhatItDependsOnIsDone () =
  -- `near` depends on `quick` alone, and `far` on `slow` alone. Whichever of
  -- them finishes first, each is compiled after its own and all four are.
  let root = "target/build-as-ready" in
  -- From nothing: what an earlier run of this test built would be up to date.
  let z = removeDirAll root in
  let a = write (Path.join root "quick") "Unit" "" in
  let b = write (Path.join root "quick") "id.ml" "fun x -> x" in
  let c = write (Path.join root "slow") "Unit" "" in
  let d = write (Path.join root "slow") "double.ml" "fun x -> x + x" in
  let e = write (Path.join root "near") "Unit" "../quick\n" in
  let f = write (Path.join root "near") "one.ml" "id 1" in
  let g = write (Path.join root "far") "Unit" "../slow\n" in
  let h = write (Path.join root "far") "two.ml" "double 1" in
  let i = write (Path.join root "app") "Unit" "../near\n../far\n" in
  let j = write (Path.join root "app") "main.ml" "one + two" in
  match built (Path.join root "app") with
  | (ok, lines) ->
      let at =
        \l ->
          V.foldl
            (\found i -> if V.getOr "" lines i == l then i else found)
            (0 - 1)
            (V.range 0 (V.len lines))
      in
      let k = assertEq (ok, V.len lines) (True, 5) "all five compiled" in
      let l =
        assertEq
          (
            at "   Compiled quick" < at "   Compiled near",
            at "   Compiled slow" < at "   Compiled far"
          )
          (True, True)
          "each after its own"
      in assertEq (V.getOr "" lines 4) "   Compiled app" "and the one that needs them all, last"
