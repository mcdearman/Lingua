-- Events and tokens into a green tree, every byte of the file in it.
--
-- The parser read only the tokens that are not trivia; the lexer made them
-- all. Walking the events, each `Advance` takes the next token that is not
-- trivia, and every trivia token on the way is put back where it was: before
-- a node opens, into the node around it -- so a comment above a declaration
-- belongs to what holds the declaration, as rust-analyzer attaches it -- and
-- otherwise into the node being read. What is left at the end, and any token
-- the parser never took, goes to the root, so that nothing written is lost.
--
-- The tree's tables are written directly, a slot per node and token as each
-- is met (`Lingua.Green`): a node's slot when it opens, its size and end when
-- it closes. Nothing is made per token but the numbers in those tables.

use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe as M
use Lingua.Green (Green, fromTables, fromTablesAt)
use Lingua.Parser (Events, eventCount, isOpenAt, isCloseAt, isAdvanceAt, openKindAt, messageAt)
use Lingua.Buf as B
use Lingua.Buf (Buf)

-- What the lexer made, as tables: the text; for each token -- trivia
-- included, in order, covering the text -- its kind, where it ends, and
-- whether it is trivia, each starting where the one before it ended; the
-- kinds of those that are not trivia, which are what the parser reads; and,
-- for tokens that stand somewhere other than where they are in the text --
-- tokens given rather than lexed (`tokenLexemes`) -- where each stands, -1
-- for one that stands where it is, or no tables at all for text.
use Lexemes.*

@pub data Lexemes k = Lexemes String #[k] #[Int] #[Bool] #[k] #[Int] #[Int]

@pub fun lexemesOf (text : String) (kinds : #[k]) (ends : #[Int])
    (trivia : #[Bool]) : Lexemes k =
  let parsed =
    V.toArray
      (V.map
        (\i -> arrayGet kinds i)
        (V.filter (\i -> not (arrayGet trivia i)) (V.range 0 (arrayLen kinds))))
  in Lexemes text kinds ends trivia parsed #[] #[]

-- A lexer's tables, written a token at a time inside a `runSt`: the kinds,
-- where each ends, whether each is trivia, the kinds of those that are not,
-- and where each stands, for tokens given with that.
use Lexing.*

@pub data Lexing s k = Lexing (Buf s k) (Buf s Int) (Buf s Bool) (Buf s k) (Buf s Int) (Buf s Int)

@pub fun lexing (filler : k) : Lexing s k ! { St s | e } =
  Lexing (B.buffer ()) (B.buffer ()) (B.buffer ()) (B.buffer ()) (B.buffer ()) (B.buffer ())

-- One more token, of kind `k`, ending at byte `stop`.
@pub fun lexed (l : Lexing s k) (k : k) (stop : Int) (trivia : Bool) :
    () ! { St s | e } =
  match l with
  | Lexing ks es ts ps _ _ ->
      let _ = B.push ks k in
      let _ = B.push es stop in
      let _ = B.push ts trivia in
      let _ = if trivia then () else (let _ = B.push ps k in ()) in
      ()

-- The same, standing for bytes `from` to `to` of somewhere else: -1 for a
-- token that stands where it is. Every token of a lexing is written with
-- this, or none is.
@pub fun lexedAt (l : Lexing s k) (k : k) (stop : Int) (trivia : Bool)
    (from : Int) (to : Int) : () ! { St s | e } =
  match l with
  | Lexing _ _ _ _ os oe ->
      let _ = lexed l k stop trivia in
      let _ = B.push os from in
      let _ = B.push oe to in
      ()

@pub fun lexemesFrom (text : String) (l : Lexing s k)
    : Lexemes k ! { St s | e } =
  match l with
  | Lexing ks es ts ps os oe ->
      Lexemes
        text
        (B.freeze ks)
        (B.freeze es)
        (B.freeze ts)
        (B.freeze ps)
        (B.freeze os)
        (B.freeze oe)

-- The tokens a parser reads: the kinds of those that are not trivia.
@pub fun parsedKinds (ls : Lexemes k) : #[k] = match ls with | Lexemes _ _ _ _ ps _ _ -> ps

-- Tokens given rather than lexed -- what a macro wrote -- as lexemes: each of
-- kind `kinds` says, standing for the bytes it came with, its text the one it
-- came with. The text is theirs, a space between each two, so that what
-- reads the tree's text reads them apart; the spaces are trivia of kind
-- `filler`, standing where they are.
@pub fun tokenLexemes (filler : k) (isTrivia : k -> Bool) (kinds : [k])
    (tokens : [(Int, Int, String)]) : Lexemes k =
  let texts = V.map (\x -> match x with | (_, _, t) -> t) tokens in
  runSt (\() ->
    let l = lexing filler in
    let _ = V.foldl (laid l filler isTrivia kinds tokens) 0 (V.range 0 (V.len tokens)) in
    lexemesFrom (S.join " " texts) l)

-- Token `i` of `tokens` laid down at byte `at`, after a space if it is not
-- the first: where it ends.
fun laid (l : Lexing s k) (filler : k) (isTrivia : k -> Bool) (kinds : [k])
    (tokens : [(Int, Int, String)]) (at : Int) (i : Int) : Int ! { St s | e } =
  match V.get tokens i with
  | Just (from, to, t) ->
      let start =
        if i > 0 then (let _ = lexedAt l filler (at + 1) True (0 - 1) (0 - 1) in at + 1) else at
      in
      let k = V.getOr filler kinds i in
      let stop = start + stringByteLength t in
      let _ = lexedAt l k stop (isTrivia k) from to in
      stop
  | None -> at

-- --- building ----------------------------------------------------------------

-- The tables being written -- kinds, starts, ends, sizes and parents; the next
-- token and the byte it starts at; the slots of the nodes open, innermost
-- last, and how many are; the errors so far, where and what; and whether the
-- root has closed.
use Builder.*

data Builder s k = Builder (Buf s k) (Buf s Int) (Buf s Int) (Buf s Int) (Buf s Int) (StRef s Int) (StRef s Int) (Buf s Int) (StRef s Int) (Buf s Int) (Buf s String) (StRef s Bool)

-- The tree the events describe over `lexemes`, and every error with the byte
-- it was said at. `root` is the kind of the whole file, for the tree of a
-- parse that said nothing at all.
@pub fun build (root : k) (events : Events k) (lexemes : Lexemes k) :
    (Green k, [(Int, String)]) =
  match lexemes with
  | Lexemes text _ _ _ _ los loe ->
      runSt (\() ->
        let b =
          Builder
            (B.buffer ())
            (B.buffer ())
            (B.buffer ())
            (B.buffer ())
            (B.buffer ())
            (stNewRef 0)
            (stNewRef 0)
            (B.buffer ())
            (stNewRef 0)
            (B.buffer ())
            (B.buffer ())
            (stNewRef False)
        in
        let _ = walk b lexemes events 0 (eventCount events) in
        let _ = closeAll b lexemes in
        -- A parse that opened nothing: one root, holding every token.
        let _ =
          if B.len (kindsOf b) == 0
          then
            (let _ = openSlot b root in
              let _ = remaining b lexemes in
              closeTop b)
          else ()
        in match b with
        | Builder kinds starts stops sizes parents _ _ _ _ errAt errMsg _ ->
            let errs = V.map (\i -> (B.at errAt i, B.at errMsg i)) (V.range 0 (B.len errAt)) in
            if arrayLen los == 0
            then
              (
                fromTables text (B.freeze kinds) (B.freeze starts) (B.freeze stops) (B.freeze sizes) (B.freeze parents),
                errs
              )
            else
              -- Each token where its lexeme stands, each node where its tokens
              -- do, and each error where the token it was said at stands.
              let ks = B.freeze kinds in
              let ss = B.freeze starts in
              let zs = B.freeze sizes in
              let lexeme = \at -> placeOf lexemes at in
              let froms =
                V.toArray
                  (V.map
                    (\i -> if arrayGet zs i == 0
                      then
                        M.unwrapOr
                        (0 - 1)
                        (M.map (\j -> arrayGet los j) (lexeme (arrayGet ss i)))
                      else 0 - 1)
                    (V.range 0 (arrayLen ks)))
              in
              let tos =
                V.toArray
                  (V.map
                    (\i -> if arrayGet zs i == 0
                      then
                        M.unwrapOr
                        (0 - 1)
                        (M.map (\j -> arrayGet loe j) (lexeme (arrayGet ss i)))
                      else 0 - 1)
                    (V.range 0 (arrayLen ks)))
              in
              let g = fromTablesAt text ks ss (B.freeze stops) zs (B.freeze parents) froms tos in
              (g, V.map (\e -> (errorPlace lexemes (fst e), snd e)) errs))

fun kindsOf b = match b with | Builder kinds _ _ _ _ _ _ _ _ _ _ _ -> kinds

fun walk b lexemes events (i : Int) (n : Int) =
  if i >= n then ()
  else
    let _ = step b lexemes events i in
    walk b lexemes events (i + 1) n

fun step b lexemes events (i : Int) =
  match b with
  | Builder _ _ _ _ _ cursor offset _ depth errAt errMsg closed ->
      if stGetRef closed then ()
      else if isOpenAt events i then
        let _ = if stGetRef depth > 0 then trivia b lexemes else () in
        openSlot b (openKindAt events i)
      else if isAdvanceAt events i then
        let _ = trivia b lexemes in
        if stGetRef cursor < lexemeCount lexemes then take b lexemes else ()
      else if isCloseAt events i then
        if stGetRef depth <= 1 then closeAll b lexemes else closeTop b
      else
        let _ = trivia b lexemes in
        let _ = B.push errAt (stGetRef offset) in
        let _ = B.push errMsg (messageAt events i) in
        ()

fun lexemeCount ls = match ls with | Lexemes _ ks _ _ _ _ _ -> arrayLen ks

-- The lexeme starting at byte `at` of the text, if one does.
fun placeOf (ls : Lexemes k) (at : Int) : Maybe Int =
  match ls with
  | Lexemes _ _ ends _ _ _ _ ->
      let n = arrayLen ends in
      -- The first lexeme ending after `at` is the one it is in.
      let rec first lo hi =
        if lo >= hi
        then lo
        else
          (let mid = (lo + hi) / 2 in
            if arrayGet ends mid <= at then first (mid + 1) hi else first lo mid)
      in
      let j = first 0 n in
      if j < n and (if j == 0 then 0 else arrayGet ends (j - 1)) == at then Just j else None

-- Where an error said at byte `at` of the text stands: where the next token
-- with a place does, or the last one's end.
fun errorPlace (ls : Lexemes k) (at : Int) : Int =
  match ls with
  | Lexemes _ _ ends _ _ os oe ->
      let n = arrayLen ends in
      let placed = V.filter (\j -> arrayGet os j >= 0) (V.range 0 n) in
      (match V.find (\j -> (if j == 0 then 0 else arrayGet ends (j - 1)) >= at) placed with
       | Just j -> arrayGet os j
       | None ->
           (match V.get placed (V.len placed - 1) with | Just j -> arrayGet oe j | None -> at))

-- A node of kind `k` opening here, inside the one open.
fun openSlot b k =
  match b with
  | Builder kinds starts stops sizes parents _ offset stack depth _ _ _ ->
      let d = stGetRef depth in
      let parent = if d > 0 then B.at stack (d - 1) else 0 - 1 in
      let at = stGetRef offset in
      let slot = B.push kinds k in
      let _ = B.push starts at in
      let _ = B.push stops at in
      let _ = B.push sizes 1 in
      let _ = B.push parents parent in
      let _ = if d < B.len stack then B.put stack d slot else (let _ = B.push stack slot in ()) in
      stSetRef depth (d + 1)

-- The innermost node open, closed here.
fun closeTop b =
  match b with
  | Builder kinds _ stops sizes _ _ offset stack depth _ _ _ ->
      let d = stGetRef depth in
      if d <= 0 then ()
      else
        let slot = B.at stack (d - 1) in
        let _ = B.put sizes slot (B.len kinds - slot) in
        let _ = B.put stops slot (stGetRef offset) in
        stSetRef depth (d - 1)

-- Every trivia token from the cursor on, into the node being read.
fun trivia b lexemes =
  match (b, lexemes) with
  | (Builder _ _ _ _ _ cursor _ _ _ _ _ _, Lexemes _ _ _ ts _ _ _) ->
      let c = stGetRef cursor in
      if c < arrayLen ts and arrayGet ts c then (let _ = take b lexemes in trivia b lexemes) else ()

-- The next token, into the node being read -- nowhere, if none is open.
fun take b lexemes =
  match (b, lexemes) with
  | (Builder _ _ _ _ _ cursor offset stack depth _ _ _, Lexemes _ ks ends _ _ _ _) ->
      let c = stGetRef cursor in
      let from = stGetRef offset in
      let to = arrayGet ends c in
      let d = stGetRef depth in
      let _ = if d > 0 then tokenSlot b (arrayGet ks c) from to (B.at stack (d - 1)) else () in
      let _ = stSetRef cursor (c + 1) in
      stSetRef offset to

-- A token's slot: of kind `k`, from byte `from` to `to`, inside `parent`.
fun tokenSlot b k (from : Int) (to : Int) (parent : Int) =
  match b with
  | Builder kinds starts stops sizes parents _ _ _ _ _ _ _ ->
      let _ = B.push kinds k in
      let _ = B.push starts from in
      let _ = B.push stops to in
      let _ = B.push sizes 0 in
      let _ = B.push parents parent in
      ()

-- Close every open node, the root last, with every token still unread in it.
fun closeAll b lexemes =
  match b with
  | Builder _ _ _ _ _ _ _ _ depth _ _ closed ->
      let d = stGetRef depth in
      if d == 0 then ()
      else if d == 1 then
        let _ = remaining b lexemes in
        let _ = closeTop b in
        stSetRef closed True
      else
        let _ = closeTop b in
        closeAll b lexemes

fun remaining b lexemes =
  match b with
  | Builder _ _ _ _ _ cursor _ _ _ _ _ _ ->
      if stGetRef cursor < lexemeCount lexemes
      then (let _ = take b lexemes in remaining b lexemes)
      else ()

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)
use Lingua.Green (text, dump, fromAt, toAt)
use Lingua.Parser (parser, open, close, advance, error, events)

-- `let x` with a space before, between and after.
def sample : Lexemes String =
  lexemesOf
    " let x\n"
    #["ws", "let", "ws", "ident", "ws"]
    #[1, 4, 5, 6, 7]
    #[True, False, True, False, True]

-- What a parse says, from a script: 0 opens, 1 takes a token, 2 says what is
-- wrong, and 3 closes the innermost node -- the last one as the file.
fun said (script : [Int]) : Events String =
  runSt (\() ->
    let p = parser #["let", "ident"] "eof" "error" (\k -> k) in
    let marks = stNewRef [] in
    let _ =
      V.foldl
        (\u s ->
          if s == 0
          then (let m = open p in stSetRef marks (V.pushBack (stGetRef marks) m))
          else if s == 1 then advance p
          else if s == 2 then error p "expected `=`"
          else
            let ms = stGetRef marks in
            let _ = close p (V.getOr 0 ms (V.len ms - 1)) (if V.len ms == 1 then "File" else "Let")
            in stSetRef marks (V.popBack ms))
        ()
        script in
    events p)

@test fun everyByteIsInTheTree () =
  match build "File" (said [0, 0, 1, 1, 3, 3]) sample with
  | (g, errs) ->
      let a = assertEq (text g) " let x\n" "the file, back" in
      assertEq
        (dump (\k -> k) g)
        "File\n  ws \" \"\n  Let\n    let \"let\"\n    ws \" \"\n    ident \"x\"\n  ws \"\\n\""
        "leading trivia outside the node, trailing trivia at the root"

@test fun anErrorIsAtTheByteItWasSaid () =
  match build "File" (said [0, 1, 2, 3]) sample with
  | (g, errs) -> assertEq errs [(5, "expected `=`")] "where the `x` starts, past the space"

@test fun tokensNeverTakenStillBelong () =
  match build "File" (said [0, 1, 3]) sample with
  | (g, errs) -> assertEq (text g) " let x\n" "the `x` the parser never read is there too"

@test fun givenTokensStandWhereTheyCameFrom () =
  let ls = tokenLexemes "ws" (\k -> k == "ws") ["let", "ident"] [(100, 103, "let"), (7, 8, "x")] in
  match build "File" (said [0, 0, 1, 1, 3, 3]) ls with
  | (g, errs) ->
      let a = assertEq (text g) "let x" "their texts, a space apart" in
      let b = assertEq (fromAt g 4, toAt g 4) (7, 8) "the `x` where it came from" in
      let c = assertEq (fromAt g 3, toAt g 3) (3, 4) "the space where it is" in
      assertEq
        (fromAt g 1, toAt g 1)
        (100, 8)
        "and the node from the first's start to the last's end"

@test fun anErrorInGivenTokensIsWhereTheyStand () =
  let ls = tokenLexemes "ws" (\k -> k == "ws") ["let", "ident"] [(100, 103, "let"), (7, 8, "x")] in
  match build "File" (said [0, 1, 2, 3]) ls with
  | (g, errs) -> assertEq errs [(7, "expected `=`")] "where the `x` stands"

@test fun aParseThatSaidNothingIsOneRoot () =
  match build "File" (said []) sample with
  | (g, errs) ->
      assertEq
        (dump (\k -> k) g)
        "File\n  ws \" \"\n  let \"let\"\n  ws \" \"\n  ident \"x\"\n  ws \"\\n\""
        "every token in it"

-- Whether the token at `r` is on a path that ends in a token `isEnd` holds of,
-- a segment each side of each separator: `a.b.c!` -- each of `a`, `b` and `c`
-- is. What `syntax!`'s `context` entries `ending … via …` ask.
@pub fun onPath (isEnd : Int -> Bool) (isSep : Int -> Bool)
    (isSeg : Int -> Bool) (r : Int) : Bool =
  if isEnd (r + 1) then True
  else if isSep (r + 1) and isSeg (r + 2) then onPath isEnd isSep isSeg (r + 2) else False
