-- A calculator's syntax, from its ungrammar: a lossless tree for any input.
--
-- `meadow run` parses a small program and prints its tree; `meadow test`
-- checks that every input -- right, wrong or empty -- comes back byte for
-- byte, and that errors land where they belong.

use Scythe (lexer!)
use Lingua (syntax!, lang!, pass!)
use Lingua.Green (Green, dump, text)
use Std.Collections.Vector as V
use Std.String as S

-- Whitespace and comments are tokens here -- no `@skip` -- so the tree keeps
-- them.
@derive(Lexer)
data Token
  = @regex("[ \t\r\n]+") Whitespace
  | @regex("//[^\n]*") Comment
  | @token("let") Let
  | @token("=") Equals
  | @token(";") Semi
  | @token("(") LParen
  | @token(")") RParen
  | @token(",") Comma
  | @token("+") Plus
  | @token("-") Minus
  | @token("*") Star
  | @token("/") Slash
  | @regex("[0-9]+") Number String
  | @regex("[a-zA-Z_][a-zA-Z0-9_]*") Ident String

syntax! {
  pub Calc
  lexer Token
  trivia { Whitespace, Comment }
  tokens {
    "let" = Let, "=" = Equals, ";" = Semi, "(" = LParen, ")" = RParen, "," = Comma,
    "+" = Plus, "-" = Minus, "*" = Star, "/" = Slash,
    "ident" = Ident _, "int_number" = Number _
  }
  precedence Expr { left "+" "-", left "*" "/", postfix Call }
  grammar {
    File = Stmt*

    Stmt = Let | ExprStmt
    Let  = "let" name:Name "=" value:Expr ";"
    ExprStmt = Expr ";"

    Expr = Literal | NameRef | Paren | Bin | Call
    Literal   = "int_number"
    NameRef   = "ident"
    Paren = "(" Expr ")"
    Bin   = lhs:Expr op:("+" | "-" | "*" | "/") rhs:Expr
    Call  = callee:Expr ArgList
    ArgList   = "(" args:(Expr ("," Expr)*)? ")"

    Name = "ident"
  }
}

-- The tree of `input`, drawn.
@pub fun drawn (input : String) : String =
  match parseCalc input with
  | (g, errs) -> dump display g

def main =
  let input = "let rate = 2 * (x + 40); // how much\nf(rate, 1);\n" in
  println (drawn input)

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)

fun roundTrips input =
  match parseCalc input with
  | (g, errs) -> assertEq (text g) input "every byte, back"

@test fun everyInputComesBackByteForByte () =
  let a = roundTrips "let x = 1 + 2 * 3;\n" in
  let b = roundTrips "" in
  let c = roundTrips "   // only a comment\n" in
  let d = roundTrips "let = ;;; ) ( 1 2 +" in
  roundTrips "f(1, (2), g(3))(4);"

@test fun multiplicationBindsTighter () =
  assertEq
    (drawn "1 + 2 * 3;")
    "File\n  ExprStmt\n    Bin\n      Literal\n        Number \"1\"\n      Whitespace \" \"\n      Plus \"+\"\n      Whitespace \" \"\n      Bin\n        Literal\n          Number \"2\"\n        Whitespace \" \"\n        Star \"*\"\n        Whitespace \" \"\n        Literal\n          Number \"3\"\n    Semi \";\""
    "2 * 3 is the right side"

@test fun subtractionAssociatesLeft () =
  match parseCalc "1 - 2 - 3;" with
  | (g, errs) ->
      let a = assertEq errs [] "no errors" in
      assertEq
        (V.len (V.filter (\l -> l == "      Bin") (lines (dump display g))))
        1
        "(1 - 2) - 3: the left side is the nested one"

fun lines (s : String) : [String] = S.split "\n" s

@test fun aCallIsReadAfterWhatItCalls () =
  match parseCalc "f(1)(2);" with
  | (g, errs) ->
      let a = assertEq errs [] "no errors" in
      assertEq (V.len (V.filter (\l -> l == "    Call") (lines (dump display g)))) 1 "one call at the top, holding the other"

@test fun aMissingPieceIsSaidWhereItWouldBe () =
  match parseCalc "let x = ;\nlet y = 2;" with
  | (g, errs) ->
      let a = assertEq (text g) "let x = ;\nlet y = 2;" "still every byte" in
      assertEq errs [(8, "expected Expr")] "at the `;`, and the next statement still parses"

@test fun aStrayTokenIsAnErrorAndTheRestParses () =
  match parseCalc ") 1;" with
  | (g, errs) ->
      let a = assertEq (V.len errs) 1 "one error" in
      assertEq (V.any (\l -> l == "  ExprStmt") (lines (dump display g))) True "the `1;` after it"

-- --- the typed AST -----------------------------------------------------------

use Lingua.Red as R

-- What a program's statements leave bound, reading only the typed AST.
fun run (input : String) : [(String, Int)] =
  match parseCalc input with
  | (g, _) ->
      match astCalc g with
      | Just file -> V.foldl step [] (calcFileStmts file)
      | None -> []

fun step env s =
  match s with
  | CalcStmt.Let l ->
      (match (calcLetName l, calcLetValue l) with
       | (Just n, Just v) -> V.pushBack env (R.text (syntaxCalcName n), value env v)
       | _ -> env)
  | CalcStmt.ExprStmt _ -> env

fun value env (e : CalcExpr) : Int =
  match e with
  | CalcExpr.Literal l -> (match calcLiteralNumberToken l with | Just t -> (match S.toInt (R.text t) with | Just n -> n | None -> 0) | None -> 0)
  | CalcExpr.NameRef n -> (match calcNameRefIdentToken n with | Just t -> lookup env (R.text t) | None -> 0)
  | CalcExpr.Paren p -> (match calcParenExpr p with | Just x -> value env x | None -> 0)
  | CalcExpr.Bin b ->
      (match (calcBinLhs b, calcBinOp b, calcBinRhs b) with
       | (Just l, Just op, Just r) -> apply (R.text op) (value env l) (value env r)
       | _ -> 0)
  | CalcExpr.Call c -> 0

fun lookup env name = match V.find (\p -> fst p == name) env with | Just p -> snd p | None -> 0

fun apply op a b = if op == "+" then a + b else if op == "-" then a - b else if op == "*" then a * b else a / b

@test fun theTypedTreeIsReadByLabel () =
  assertEq
    (run "let x = 2 * (3 + 4); // fourteen\nlet y = x - 10 - 1;\n")
    [("x", 14), ("y", 3)]
    "`lhs`, `op` and `rhs`, and names by their labels"

@test fun anArgumentListIsEveryArgument () =
  match parseCalc "f(1, 2, 3);" with
  | (g, _) ->
      match astCalc g with
      | Just file ->
          (match V.get (calcFileStmts file) 0 with
           | Just (CalcStmt.ExprStmt s) ->
               (match calcExprStmtExpr s with
                | Just (CalcExpr.Call c) ->
                    (match calcCallArgList c with
                     | Just args -> assertEq (V.len (calcArgListArgs args)) 3 "three"
                     | None -> assertEq 0 1 "an argument list")
                | _ -> assertEq 0 1 "a call")
           | _ -> assertEq 0 1 "a statement")
      | None -> assertEq 0 1 "a file"

-- --- languages and a pass ------------------------------------------------------

-- The language the grammar implies, and one without binary expressions: an
-- operator is a primitive applied to its arguments.
lang! { pub Surface from Calc }

lang! {
  pub Core extends Surface
  Expr - Bin
  Expr + Prim { op : String, args : [Expr] }
}

-- Everything but `Bin` is copied, its children lowered first.
pass! {
  pub lower : Surface -> Core
    | Bin { lhs, op, rhs } -> Prim { op = op, args = [lhs, rhs] }
}

use Std.Maybe as M
use Lingua.Lang (Meta)

fun core (input : String) : Maybe CoreFile =
  match parseCalc input with
  | (g, _) -> M.map lower (surfaceFromCalc g)

-- What a `Core` program leaves bound.
fun runCore (input : String) : [(String, Int)] =
  match core input with
  | Just f -> (match f with | CoreFile.File r -> V.foldl stepCore [] r.stmts)
  | None -> []

fun stepCore env s =
  match s with
  | CoreStmt.Let r -> (match r.name with | CoreName.Name n -> V.pushBack env (n.ident, evalCore env r.value))
  | CoreStmt.ExprStmt _ -> env

fun evalCore env (e : CoreExpr) : Int =
  match e with
  | CoreExpr.Literal r -> (match S.toInt r.number with | Just n -> n | None -> 0)
  | CoreExpr.NameRef r -> lookup env r.ident
  | CoreExpr.Paren r -> evalCore env r.expr
  | CoreExpr.Prim r ->
      (match (V.get r.args 0, V.get r.args 1) with
       | (Just a, Just b) -> apply r.op (evalCore env a) (evalCore env b)
       | _ -> 0)
  | CoreExpr.Call _ -> 0

@test fun aPassRewritesWhatChangedAndCopiesTheRest () =
  assertEq (runCore "let x = 2 * (3 + 4);\nlet y = x - 10 - 1;") [("x", 14), ("y", 3)] "lowered, and the same answers"

@test fun aRewrittenNodeKeepsWhereItCameFrom () =
  match core "let x = 1 + 2;" with
  | Just (CoreFile.File r) ->
      (match V.get r.stmts 0 with
       | Just (CoreStmt.Let l) -> assertEq (metaCoreExpr l.value) (Meta.Meta 8 13) "the bytes of `1 + 2`"
       | _ -> assertEq 0 1 "a let")
  | _ -> assertEq 0 1 "a program"

@test fun aProgramWithSomethingMissingHasNoSurface () =
  match parseCalc "let x = ;" with
  | (g, _) -> assertEq (M.isSome (surfaceFromCalc g)) False "the tree has an error in it"

-- A pass may do anything an ordinary function may: this one counts the
-- operators it lowers, with `Std.State`.
use Std.State (get, put, runState)

fun tick () = put (get () + 1)

pass! {
  pub lowerCounting : Surface -> Core
    | Bin { lhs, op, rhs } -> (let u = tick () in Prim { op = op, args = [lhs, rhs] })
}

@test fun aPassMayPerformEffects () =
  match parseCalc "let x = 1 + 2 * 3;" with
  | (g, _) ->
      match surfaceFromCalc g with
      | Just s -> (match runState 0 (\() -> lowerCounting s) with | (_, n) -> assertEq n 2 "two operators")
      | None -> assertEq 0 1 "a program"

-- --- queries ------------------------------------------------------------------------

-- The calculator as a compiler of several files, each step a query: a file's
-- text is an input, and everything else is worked out from it and remembered
-- -- re-run only when something it read has changed.
use Lingua (database!)
use Lingua.Query as Q
use Lingua.Query.QueryError.*
use Std.Exn (toResult)
use Std.Result.Result.*

database! {
  pub Session
    | input source (file : Int) : String
    | query tree (file : Int) : Green Calc = fst (parseCalc (querySource file))
    | query program (file : Int) : Maybe CoreFile = M.map lower (surfaceFromCalc (queryTree file))
    | query bindings (file : Int) : [(String, Int)] = (match queryProgram file with | Just (CoreFile.File r) -> V.foldl stepCore [] r.stmts | None -> [])
    | persisted query sum (files : [Int]) : Int = V.foldl (\acc bs -> acc + V.foldl (\a b -> a + snd b) 0 bs) 0 (queryBindingsEach files)
}

fun twoFiles () =
  let db = newSession () in
  let a = setSessionSource db 1 "let x = 2 * 3;" in
  let b = setSessionSource db 2 "let y = 10 - 1;" in
  let c = sessionSum db [1, 2] in
  let d = Q.takeLog db in
  db

@test fun aQueryIsWorkedOutOnceAndRemembered () =
  let db = newSession () in
  let a = setSessionSource db 1 "let x = 2 * 3;" in
  let b = setSessionSource db 2 "let y = 10 - 1;" in
  let c = assertEq (toResult (\() -> sessionSum db [1, 2])) (Ok 15) "6 + 9" in
  let d = assertEq (V.len (Q.takeLog db)) 7 "tree, program and bindings for each file, and the sum" in
  let e = assertEq (toResult (\() -> sessionSum db [1, 2])) (Ok 15) "asked again" in
  assertEq (Q.takeLog db) [] "and nothing run for it"

@test fun anEditReRunsOnlyTheFileItIsIn () =
  let db = twoFiles () in
  let a = setSessionSource db 2 "let y = 10 - 2;" in
  let b = assertEq (toResult (\() -> sessionSum db [1, 2])) (Ok 14) "6 + 8" in
  assertEq (Q.takeLog db) [SessionKey.Tree 2, SessionKey.Program 2, SessionKey.Bindings 2, SessionKey.Sum [1, 2]] "the first file untouched"

@test fun aCommentStopsWhereTheAnswersAreTheSame () =
  -- The comment is in the tree, and the program's `meta` covers it, so both
  -- change; what the file binds does not, so the sum is not run again.
  let db = twoFiles () in
  let a = setSessionSource db 1 "let x = 2 * 3; // six" in
  let b = assertEq (toResult (\() -> sessionSum db [1, 2])) (Ok 15) "still 15" in
  assertEq (Q.takeLog db) [SessionKey.Tree 1, SessionKey.Program 1, SessionKey.Bindings 1] "cut off at the bindings"

@test fun aSessionIsKeptBetweenRuns () =
  -- The sum is `persisted`: written with the files it read and a fingerprint
  -- of each, and read back into a new session -- where, the files being the
  -- same, nothing runs to answer it.
  let db = twoFiles () in
  let path = "target/calc-session.json" in
  let a = assertEq (saveSession db path) (Ok ()) "written" in
  let db2 = newSession () in
  let b = setSessionSource db2 1 "let x = 2 * 3;" in
  let c = setSessionSource db2 2 "let y = 10 - 1;" in
  let d = assertEq (loadSession db2 path) (Ok 1) "the sum, read back" in
  let e = assertEq (toResult (\() -> sessionSum db2 [1, 2])) (Ok 15) "the same answer" in
  let f = assertEq (Q.takeLog db2) [] "and nothing run for it" in
  -- A file that changed since is worked out again, as far as it has to be.
  let db3 = newSession () in
  let g = setSessionSource db3 1 "let x = 2 * 4;" in
  let h = setSessionSource db3 2 "let y = 10 - 1;" in
  let i = loadSession db3 path in
  assertEq (toResult (\() -> sessionSum db3 [1, 2])) (Ok 17) "8 + 9, from the new file"

@test fun aFileNobodySetIsSaidToBe () =
  let db = twoFiles () in
  assertEq (toResult (\() -> sessionSum db [1, 3])) (Err (Unset (SessionKey.Source 3))) "file 3"
