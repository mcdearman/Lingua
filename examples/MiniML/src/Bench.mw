-- How fast the compiler is: each of its phases, timed on a generated
-- program of a few thousand lines -- a front end's work at the size a real
-- one does it, to see where the time goes before anything is made faster.
--
--   meadow run examples/MiniML --release -- bench          -- 2000 `let`s
--   meadow run examples/MiniML --release -- bench 8000
--
-- The phases, each on what the one before made, in bytes of source a second:
-- lexing and parsing into the lossless tree, the typed AST read into
-- `Surface`, resolution and desugaring into `Core`, inference, and running it.

use Lingua.Diagnostic (collect)
use Lingua.Table (tabled)
use MiniML.Syntax
use MiniML.Names
use MiniML.Desugar
use MiniML.Infer
use MiniML.Eval
use MiniML.Types
use MiniML.Compiler
use Std.Thread as Thread
use Std.Exn (toResult)
use Std.Bench (BenchConfig, Report, benchUnitsWith, report)
use Std.Collections.Vector as V
use Std.String as S
use Std.Result.Result.*

-- A program of `n` `let`s, each defining a function from the one before it:
-- arithmetic, a conditional, a closure used at two types -- which inference
-- generalizes -- and a recursive function, in turn. Each is used, so running
-- it goes through all of them -- and each hands the next the argument it was
-- given, so that the recursive ones count down from the same small number and
-- running is as much work as the program is long. (Handing on `x + k` made
-- every `let rec` count down from a number as big as the program, and the run
-- quadratic in it: the program's doing, not the evaluator's.)
@pub fun program (n : Int) : String =
  S.join "" (V.pushBack (V.map line (V.range 0 n)) "f${show (n - 1)} 10\n")

fun line (i : Int) : String =
  let k = show i in
  let prev = if i == 0 then "(fun x -> x)" else "f${show (i - 1)}" in
  let kind = i - (i / 4) * 4 in
  if kind == 0 then "let f${k} = fun x -> ${prev} x + ${k} in\n"
  else if kind == 1 then "let f${k} = fun x -> if x < ${k} then ${prev} x else ${prev} (x - 1) in\n"
  else if kind == 2 then
    "let f${k} = let id = fun y -> y in fun x -> if id true then ${prev} (id x) else 0 in\n"
  else "let rec f${k} n = if n < 2 then ${prev} n else f${k} (n - 1) in\n"

-- Each phase once per sample, three samples: a phase on a big program takes
-- long enough that calibrating further only adds to the wait.
def config : BenchConfig = BenchConfig { warmupNanos = 0, sampleNanos = 1, samples = 3 }

-- Time every phase on a program of `n` `let`s, and say how it went.
@pub fun benchmark (n : Int) =
  let src = program n in
  let bytes = stringByteLength src in
  let u = println "a program of ${show n} lets, ${show bytes} bytes\n" in
  let parsed = parseMini src in
  match (parsed, surfaceFromMini (fst parsed)) with
  | ((_, errs), _) if not (V.isEmpty errs) ->
      println "the generated program does not parse: ${show errs}"
  | (_, None) -> println "the generated program has no surface"
  | (_, Just surface) ->
      let core = fst (fst (collect (\() -> tabled (\() -> desugar (resolved [] surface))))) in
      let a = println "it is ${show (typeOf core)}, and runs to ${show (run core)}\n" in
      report [
        benchUnitsWith config "parse" bytes (\() -> parseMini src),
        benchUnitsWith config "surface" bytes (\() -> surfaceFromMini (fst parsed)),
        benchUnitsWith config "resolve + desugar" bytes (\() ->
          collect (\() -> tabled (\() -> desugar (resolved [] surface)))),
        benchUnitsWith config "infer" bytes (\() -> typed core),
        benchUnitsWith config "run" bytes (\() -> run core)
      ]

-- What the queries cost, and what threads buy: `files` programs of `n` `let`s
-- each, typed seven ways -- straight through the passes, as the session's
-- queries in a batch, and as the session an editor keeps, each of the three
-- one file after another and each file on a thread of its own, and the batch
-- once more with its threads sharing the inputs in a compact region -- and then
-- what only the editor's session can do: asked again with nothing changed,
-- and with one file edited.
@pub fun drivers (files : Int) (n : Int) =
  let srcs = V.map (\i -> program (n + i)) (V.range 0 files) in
  let ids = V.range 1 (files + 1) in
  let bytes = V.foldl (\acc s -> acc + stringByteLength s) 0 srcs in
  let u = println "\n${show files} files of about ${show n} lets, ${show bytes} bytes\n" in
  let filled =
    \db ->
      let u = V.foldl (\acc i -> setSessionSource db i (V.getOr "" srcs (i - 1))) () ids in
      db
  in
  let fresh = \() -> filled (newSession ()) in
  let batch = \() -> filled (batchSession ()) in
  let warm = fresh () in
  let w = toResult (\() -> sessionTypedEach warm ids) in
  let first = V.getOr "" srcs 0 in
  report [
    benchUnitsWith config "passes, in turn" bytes (\() -> V.map straight srcs),
    benchUnitsWith config "passes, threads" bytes (\() -> Thread.parMap straight srcs),
    benchUnitsWith config "batch, in turn" bytes (\() ->
      let db = batch () in
      toResult (\() -> sessionTypedEach db ids)),
    benchUnitsWith config "batch, threads" bytes (\() ->
      let db = parallelSession (batch ()) in
      toResult (\() -> sessionTypedEach db ids)),
    benchUnitsWith config "batch, shared" bytes (\() ->
      let db = sharedSession (batch ()) in
      toResult (\() -> sessionTypedEach db ids)),
    benchUnitsWith config "queries, in turn" bytes (\() ->
      let db = fresh () in
      toResult (\() -> sessionTypedEach db ids)),
    benchUnitsWith config "queries, threads" bytes (\() ->
      let db = parallelSession (fresh ()) in
      toResult (\() -> sessionTypedEach db ids)),
    benchUnitsWith config "queries, unchanged" bytes (\() ->
      toResult (\() -> V.map (\i -> sessionTyped warm i) ids)),
    benchUnitsWith config "queries, 2 edits" bytes (\() ->
      let a = setSessionSource warm 1 "${first} -- edited\n" in
      let b = toResult (\() -> V.map (\i -> sessionTyped warm i) ids) in
      let c = setSessionSource warm 1 first in
      toResult (\() -> V.map (\i -> sessionTyped warm i) ids))
  ]

-- A file's type by the passes alone: what the `typed` query answers, with
-- nothing remembered.
fun straight (src : String) : String =
  match compile [] (parseMini src) with
  | (Just f, _, _) ->
      (match typed f with
       | Ok t -> typeName (programType t)
       | Err _ -> "?")
  | _ -> "?"

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)
use Std.Result (isOk)

@test fun theGeneratedProgramTypesAndRuns () =
  let src = program 40 in
  let a = assertEq (typeOfSource src) (Ok "Int") "an `Int`" in
  assertEq (isOk (runSource src)) True "and runs"
