-- --- reading the call --------------------------------------------------------

-- One section of the call.
data Section
  = Lexer String
  | Trivia [[TokenTree]]
  | Table [(String, Loc, [TokenTree], Maybe String)]
  | Context [(String, Loc, [TokenTree], Maybe String)]
  | Precedence String [(String, [String])]
  | Grammar String Loc Int
  | GrammarTrees [TokenTree] Int
  | Lookahead Int
  | Public

use Section.*

-- A string literal, where it is, and where its text starts: for a raw string
-- `r#"…"#` the text starts past `r`, the hashes and the quote.
def literal : Parser Tokens (String, Loc, Int) =
  P.label "a string"
    (P.token
      (\t ->
        match t with
        | Str s at ->
            (match at with
             | At a b -> Just (s, at, a + (b - a - stringByteLength s + 1) / 2)
             | Nowhere -> Just (s, at, 0))
        | _ -> None)
      [])

def stringOnly : Parser Tokens String = P.map (\l -> match l with | (s, _, _) -> s) literal

fun comma p = P.thenSkip p (P.optional (punct ","))

-- A pattern of the lexer's type, up to the next comma or the end of its braces.
def pattern : Parser Tokens [TokenTree] =
  comma
    (P.bind
      (treesUntil (isPunct ","))
      (\ts -> if V.isEmpty ts then P.fail "expected a pattern" else P.pure ts))

def section : Parser Tokens Section =
  P.choice
    [ P.skipThen (keyword "lexer") (P.map Lexer ident),
      P.pure Trivia |> skip (keyword "trivia") |> keep (group Brace (P.many pattern)),
      P.pure Table |> skip (keyword "tokens") |> keep (group Brace (P.many tokenEntry)),
      P.pure Context |> skip (keyword "context") |> keep (group Brace (P.many tokenEntry)),
      P.pure (\e ls -> Precedence e ls)
        |> skip (keyword "precedence")
        |> keep ident
        |> keep (group Brace (P.many level)),
      P.skipThen (keyword "lookahead") (P.map Lookahead number),
      P.skipThen
        (keyword "grammar")
        (P.choice
          [ P.map
              (\l -> match l with | (s, at, start) -> Grammar s at start)
              literal,
            P.map
              (\ts -> GrammarTrees ts (lastEnd ts))
              (group Brace (treesUntil (\t -> False))) ]) ]

-- Where the last of `ts` ends: what a grammar in braces is said to stop at.
fun lastEnd (ts : [TokenTree]) : Int =
  match V.get ts (V.len ts - 1) with
  | Just t -> (match spanOf t with | At _ b -> b | Nowhere -> 0)
  | None -> 0

-- `"name" = Pattern`, or `"name" as Kind = Pattern`.
def tokenEntry : Parser Tokens (String, Loc, [TokenTree], Maybe String) =
  P.pure (\l n pat -> match l with | (s, at, _) -> (s, at, pat, n))
    |> keep literal
    |> keep (P.optional (P.skipThen (keyword "as") ident))
    |> skip (punct "=")
    |> keep pattern

def level : Parser Tokens (String, [String]) =
  comma
    (P.choice
      [ P.pure (\ops -> ("left", ops))
          |> skip (keyword "left")
          |> keep (P.some stringOnly),
        P.pure (\ops -> ("right", ops)) |> skip (keyword "right") |> keep (P.some stringOnly),
        P.pure (\rs -> ("postfix", rs)) |> skip (keyword "postfix") |> keep (P.some postfixRule) ])

-- A rule a postfix level names: any word but the ones a level starts with.
def postfixRule : Parser Tokens String =
  P.label
    "a rule"
    (P.token
      (\t ->
        match t with
        | Word w _ -> (if V.elem w ["left", "right", "postfix"] then None else Just w)
        | _ -> None)
      [])

def call : Parser Tokens (String, [Section]) =
  P.pure
    (\pub name ss -> (name, if M.isSome pub then V.pushBack ss Public else ss))
    |> keep (P.optional (keyword "pub"))
    |> keep ident
    |> keep (P.many section)

-- --- the macro ---------------------------------------------------------------

@macro
@pub fun syntax (ts : [TokenTree]) : [TokenTree] ! { Mut, Expand | e } =
  match parseTokens call ts with
  | Err failed -> failed
  | Ok (name, sections) -> written name sections

fun written name sections =
  let lexer = V.foldl (\acc s -> match s with | Lexer l -> Just l | _ -> acc) None sections in
  let grammar = grammarOf sections in
  match (lexer, grammar) with
  | (None, _) -> [Fail "`syntax!` needs `lexer`, the Scythe token type it reads" Nowhere]
  | (_, None) -> [Fail "`syntax!` needs a `grammar`, in ungrammar" Nowhere]
  | (Just lx, Just (parsed, base)) ->
      match parsed with
      | Err (off, why) -> [Fail why (inGrammar (if base > 0 then base else 0) off 1)]
      | Ok (defs, start) ->
          let table = V.concatMap (\s -> match s with | Table es -> es | _ -> []) sections in
          let contextual = V.concatMap (\s -> match s with | Context es -> es | _ -> []) sections in
          match tokenNames table contextual with
          | Err failed -> failed
          | Ok names ->
              let spec = {
                name = name,
                  lexer = lx,
                  public = V.any (\s -> match s with | Public -> True | _ -> False) sections,
                  trivia = V.concatMap (\s -> match s with | Trivia ps -> ps | _ -> []) sections,
                  tokens = V.map (\e -> match e with | (s, at, pat, _) -> (s, at, pat)) (V.append table (V.map (\e -> match e with | (s, at, ts, n) -> (s, at, basePattern ts, n)) contextual)),
                  names = names,
                  context = V.map (\e -> match e with | (s, at, ts, _) -> (s, basePattern ts, conditions ts)) contextual,
                  prec = V.foldl (\acc s -> match s with | Precedence e ls -> Just (e, ls) | _ -> acc) None sections,
                  lookahead = V.foldl (\acc s -> match s with | Lookahead k -> k | _ -> acc) lookaheadDefault sections,
                  defs = defs,
                  start = start
              } in
              -- What each rule can begin with and be followed by, and how the
              -- walk that decides a choice reads the rules: made once, for the
              -- checks and the parser both.
              let g = lookGrammar spec (rootOf spec) in
              match check spec g with
              | Just failed -> failed
              | None ->
                  -- The language the grammar implies, for `lang!` and `pass!`.
                  let u = defineAs name (grammarLang spec) in
                  generate spec g

-- How many tokens ahead a choice may look, unless the call says: `lookahead 6`.
def lookaheadDefault : Int = 4

-- The rules, and where their offsets count from: a string's text, or -- for
-- a grammar in braces, whose pieces are where they are in the file -- the
-- file's start. -1 is a string the compiler cannot place.
fun grammarOf sections =
  V.foldl
    (\acc s ->
      match s with
      | Grammar g at start ->
          Just (withBase (parseGrammar g) (if start > 0 then start else 0 - 1), start)
      | GrammarTrees ts stop -> Just (withBase (parseGrammarTrees ts stop) 0, 0)
      | _ -> acc)
    None
    sections

-- Where byte `off` of the grammar is in the file, `n` bytes of it: `start`
-- is where the grammar's text begins -- 0 for one in braces, whose offsets
-- are the file's own -- and -1 where that is not known.
fun inGrammar (start : Int) (off : Int) (n : Int) : Loc =
  if start < 0 or off < 0 then Nowhere else At (start + off) (start + off + n)

-- A parse's rules, with where their offsets count from.
fun withBase r (base : Int) = match r with | Ok ds -> Ok (ds, base) | Err e -> Err e

-- --- what the grammar says ---------------------------------------------------

fun lookupDef spec n = V.find (\d -> defName d == n) spec.defs

-- An enum: a rule that is only an alternation of other rules.
fun isEnum (d : Def) : Bool =
  match defBody d with
  | Alt alts -> V.all (\a -> match a with | Ref _ _ -> True | _ -> False) alts
  | _ -> False

-- The kinds of node a rule's type can hold: its own, or an enum's
-- alternatives', all the way down.
fun kindsOf spec (n : String) : [String] =
  match lookupDef spec n with
  | Just d -> if isEnum d then V.concatMap (\a -> kindsOf spec a) (alternatives d) else [n]
  | None -> []

fun overlaps spec a b = V.any (\x -> V.elem x (kindsOf spec b)) (kindsOf spec a)

fun alternatives (d : Def) : [String] =
  match defBody d with
  | Alt alts -> V.concatMap (\a -> match a with | Ref n _ -> [n] | _ -> []) alts
  | _ -> []

-- The rule a body starts with, if it starts with one.
fun leading (r : Rule) : Maybe String =
  match r with
  | Ref n _ -> Just n
  | Label _ _ x -> leading x
  | Seq xs -> (match V.get xs 0 with | Just x -> leading x | None -> None)
  | _ -> None

-- What follows the first element of a sequence.
fun rest (r : Rule) : [Rule] =
  match r with
  | Seq xs -> V.drop xs 1
  | _ -> []

-- The alternatives of enum `e` that start with `e`: read after a left side.
fun ledAlts spec e =
  V.filter
    (\a -> match lookupDef spec a with
           | Just d -> leading (defBody d) == Just e
           | None -> False)
    (match lookupDef spec e with | Just d -> alternatives d | None -> [])

fun prefixAlts spec e =
  V.filter
    (\a -> not (V.elem a (ledAlts spec e)))
    (match lookupDef spec e with | Just d -> alternatives d | None -> [])

-- Every quoted token the grammar writes, with where.
fun quoted (r : Rule) : [(String, Int)] =
  match r with
  | Tok t at -> [(t, at)]
  | Ref _ _ -> []
  | Seq xs -> V.concatMap quoted xs
  | Alt xs -> V.concatMap quoted xs
  | Opt x -> quoted x
  | Rep x -> quoted x
  | Label _ _ x -> quoted x

fun refs (r : Rule) : [(String, Int)] =
  match r with
  | Tok _ _ -> []
  | Ref n at -> [(n, at)]
  | Seq xs -> V.concatMap refs xs
  | Alt xs -> V.concatMap refs xs
  | Opt x -> refs x
  | Rep x -> refs x
  | Label _ _ x -> refs x

-- --- FIRST sets --------------------------------------------------------------

-- What `r` can begin with, and whether it can be nothing: read off the tables
-- `Lingua.Look` makes of the grammar.
fun firstOf (env : Grammar) (r : Rule) : ([String], Bool) = firstPair env r

-- The rule a whole input is: the first.
fun rootOf spec : String = match V.get spec.defs 0 with | Just d -> defName d | None -> "File"

fun union (a : [String]) (b : [String]) : [String] =
  V.foldl (\acc x -> if V.elem x acc then acc else V.pushBack acc x) a b

fun overlap (a : [String]) (b : [String]) : [String] = V.filter (\x -> V.elem x b) a

-- --- checks ------------------------------------------------------------------

fun check spec (env : Grammar) : Maybe [TokenTree] =
  let problems =
    V.concat
      [ undefinedRefs spec,
        unknownTokens spec,
        duplicateRules spec,
        precedenceCovers spec env,
        fieldClashes spec,
        unplaceable spec,
        reservedRules spec ] in
  match V.get problems 0 with
  | Just (msg, loc) -> Just [Fail msg loc]
  | None -> None

fun undefinedRefs spec =
  V.concatMap
    (\d ->
      V.concatMap
        (\r -> match r with
               | (n, at) ->
                   (match lookupDef spec n with
                    | Just _ -> []
                    | None ->
                        [(
                          "no rule is called `${n}`",
                          inGrammar spec.start at (stringByteLength n)
                        )]))
        (refs (defBody d)))
    spec.defs

fun unknownTokens spec =
  V.concatMap
    (\d ->
      V.concatMap
        (\q -> match q with
               | (t, at) ->
                   (if V.any (\e -> tokName e == t) spec.tokens
                     then []
                     else
                       [(
                         "`'${t}'` is not in `tokens`: say which of the lexer's tokens it is",
                         inGrammar spec.start at (stringByteLength t + 2)
                       )]))
        (quoted (defBody d)))
    spec.defs

-- A rule named as a language's own types are: a language made from the
-- grammar is its tables, `<Language>Program`, `<Language>Arena` and
-- `<Language>Builder`, and a rule's sort would be a second type of one of
-- those names -- reported by the compiler as a type defined twice, at the
-- `lang!`, with nothing to say which rule it was.
fun reservedRules spec =
  V.concatMap
    (\d ->
      if V.elem (defName d) reservedSorts then
        [(
          "a rule cannot be called `${defName d}`: a language made from this grammar calls its own tables `…${defName d}` -- give the rule another name",
          whereDef spec (defName d)
        )]
      else [])
    spec.defs

fun duplicateRules spec =
  V.concatMap
    (\i -> match V.get spec.defs i with
           | Just d ->
               (if V.any (\e -> defName e == defName d) (V.take spec.defs i)
                 then
                   [(
                     "`${defName d}` is defined twice",
                     inGrammar
                     spec.start
                     (defAt d)
                     (stringByteLength (defName d))
                   )]
                 else [])
           | None -> [])
    (V.range 0 (V.len spec.defs))

-- Every alternative that starts with its own enum has to be read after a
-- left side: an operator in the table, or a postfix form named there.
fun precedenceCovers spec env =
  V.concatMap
    (\d ->
      if not (isEnum d) then []
      else
        V.concatMap
          (\a ->
            let covered =
              (match spec.prec with
               | Just (e, ls) ->
                   e == defName d
                     and (postfixes ls a or V.all (\t -> V.elem t (operators ls)) (trigger spec env a))
               | None -> False) in
            if covered then []
            else
              [("`${a}` starts with `${defName d}`: give its operator a place in `precedence ${defName d}`, or name it `postfix`", whereDef spec a)])
        (ledAlts spec (defName d)))
  spec.defs

fun postfixes ls a = V.any (\l -> fst l == "postfix" and V.elem a (snd l)) ls

fun operators ls = V.concatMap (\l -> if fst l == "postfix" then [] else snd l) ls

-- What a left-recursive alternative is recognised by: the start of what
-- follows its left side.
fun trigger spec env a =
  match lookupDef spec a with
  | Just d -> fst (firstOf env (Seq (rest (defBody d))))
  | None -> []

fun firstOfName env n = fst (firstOf env (Ref n 0))

fun whereDef spec n =
  match lookupDef spec n with
  | Just d -> inGrammar spec.start (defAt d) (stringByteLength n)
  | None -> Nowhere

-- --- writing the parser ------------------------------------------------------

fun tokName e = match e with | (t, _, _) -> t

-- The kind a quoted token is: the constructor its pattern starts with, or the
-- name of a kind of its own.
fun tokKind spec t =
  match V.find (\e -> tokName e == t) spec.tokens with
  | Just e -> entryKind spec e
  | None -> "Unknown"

fun entryKind spec e =
  match e with
  | (t, _, pat) -> M.unwrapOr (ctorOf pat) (M.map snd (V.find (\n -> fst n == t) spec.names))

-- Whether a pattern says what its token's text is: `Ident "self"`.
fun literalPattern (pat : [TokenTree]) : Bool =
  V.any (\t -> match t with | Str _ _ -> True | _ -> False) (V.drop pat 1)

-- Whether a token of the pattern has text of its own the pattern does not fix.
fun payload (pat : [TokenTree]) : Bool =
  V.any (\t -> match t with | Str _ _ -> False | _ -> True) (V.drop pat 1)

-- The entries whose kinds are their own, each with the kind's name: named
-- `as`, or after the quoted name -- `line_lower` is `LineLower` -- when that
-- is a word.
fun tokenNames table contextual : Result [TokenTree] [(String, String)] =
  let own =
    V.append
      (V.filter
        (\e -> match e with
               | (_, _, pat, n) -> M.isSome n or literalPattern pat)
        table)
      contextual
  in V.foldl
    (\acc e ->
      match (acc, e) with
      | (Err f, _) -> Err f
      | (Ok ns, (s, at, _, n)) ->
          (match (match n with | Just x -> Just x | None -> camel s) with
                  | Just k ->
                      (if V.any (\x -> snd x == k) ns
                        then Err [Fail "two kinds of token are called `${k}`" at]
                        else Ok (V.pushBack ns (s, k)))
                  | None ->
                      Err [Fail "`${s}` is a kind of its own: name it, `\"${s}\" as Name = …`" at]))
    (Ok [])
    own

-- `line_lower` as `LineLower`; nothing, for what is not a word.
fun camel (s : String) : Maybe String =
  let parts = S.split "_" s in
  if S.isEmpty s
  or not (V.all (\p -> not (S.isEmpty p) and V.all (\i -> let b = toInt (stringByteAt p i) in (b >= 97 and b <= 122) or (b >= 48 and b <= 57)) (V.range 0 (stringByteLength p))) parts)
  then None
  else Just (S.join "" (V.map upperFirstWord parts))

fun upperFirstWord (w : String) : String =
  let b = toInt (stringByteAt w 0) in
  stringSlice "ABCDEFGHIJKLMNOPQRSTUVWXYZ" (b - 97) (b - 96) ++ stringSlice w 1 (stringByteLength w)

-- --- context -----------------------------------------------------------------

-- Where a token has to be for a context entry to hold of it.
data Condition = Before [TokenTree] | After [TokenTree] | Ending [TokenTree] [TokenTree]

use Condition.*

fun isCondWord (t : TokenTree) : Bool =
  match t with
  | Word w _ -> V.elem w ["before", "after", "ending", "via"]
  | _ -> False

-- The pattern of a context entry: what it says before its first condition.
fun basePattern (ts : [TokenTree]) : [TokenTree] =
  match V.find (\i -> M.unwrapOr False (M.map isCondWord (V.get ts i))) (V.range 0 (V.len ts)) with
  | Just i -> V.take ts i
  | None -> ts

fun conditions (ts : [TokenTree]) : [Condition] =
  let starts =
    V.filter
      (\i ->
        M.unwrapOr
          False
          (M.map
            (\t -> match t with
                   | Word w _ -> V.elem w ["before", "after", "ending"]
                   | _ -> False)
            (V.get ts i)))
      (V.range 0 (V.len ts))
  in V.concatMap
    (\k ->
      let at = V.getOr 0 starts k in
      let stop = V.getOr (V.len ts) starts (k + 1) in
      let body = V.drop (V.take ts stop) (at + 1) in
      match V.get ts at with
      | Just (Word "before" _) -> [Before body]
      | Just (Word "after" _) -> [After body]
      | Just (Word "ending" _) ->
          (match V.find (\i -> match V.get body i with | Just (Word "via" _) -> True | _ -> False) (V.range 0 (V.len body)) with
                               | Just v -> [Ending (V.take body v) (V.drop body (v + 1))]
                               | None -> [Ending body []])
      | _ -> [])
    (V.range 0 (V.len starts))

fun ctorOf (pat : [TokenTree]) : String =
  match V.get pat 0 with
  | Just (Word w _) -> w
  | _ -> "Unknown"

-- --- names -------------------------------------------------------------------
--
-- Everything `syntax! { Mini … }` makes is named after `Mini`, so nothing it
-- makes can be a name of the program's own, or of another `syntax!`'s:
--
--   Mini                 the kinds: `Mini.Node<Rule>` for each node rule,
--                        `Mini.Token<Token>` for each of the lexer's tokens,
--                        and
--                        `Mini.ErrorNode`, `Mini.Eof` and `Mini.Unknown`. A
--                        rule and a token of one name are two kinds, and none
--                        of them is one of the three.
--   Mini<Rule>           the typed AST: `MiniIf`, `MiniExpr`
--   asMini<Rule>, syntaxMini<Rule>, mini<Rule><Field>
--                        its casts and accessors
--   parseMini, astMini   the entry points
--   linguaMini_<x>       everything else: rule names start upper case, and the
--                        parser's own helpers lower
--
-- A kind displays as its rule's or token's own name, which is what a tree's
-- dump and an editor's colours read.

fun kindType spec = spec.name

-- The kind of node rule `r`, of the lexer's token `c`, and the three every
-- tree may need.
fun kn spec r = "${spec.name}.Node${r}"

fun kt spec c = "${spec.name}.Token${c}"

fun kx spec c = "${spec.name}.${c}"

-- The kind a quoted token is.
fun kq spec t =
  match V.find (\e -> tokName e == t) spec.tokens with
  | Just e -> kt spec (entryKind spec e)
  | None -> kx spec "Unknown"

-- The typed AST's type for rule `r`.
fun ty spec r = "${spec.name}${r}"

fun fn spec r = "lingua${spec.name}_${r}"

-- Whether the next token is one of `ts`: its kind read once and compared here,
-- where the kind type is known. `LinguaP.at` would compare it too, but as a
-- function over any kind type, called under the `runSt` every parse runs in --
-- and a trait's method is found at compile time only where the types are
-- known, so there it was looked up at run time, at every token.
fun anyOf spec env ts =
  match V.toList ts with
  | Nil -> "False"
  | Cons t Nil -> "(LinguaP.nth p 0 == ${kq spec t})"
  | _ -> "(let k = LinguaP.nth p 0 in ${S.join " or " (V.map (\t -> "k == ${kq spec t}") ts)})"

-- The kinds, as constructor and display name: every node rule, every token
-- the table names and the trivia, and the three every tree may need.
fun kinds spec : [(String, String)] =
  let nodes =
    V.map (\d -> ("Node${defName d}", defName d)) (V.filter (\d -> not (isEnum d)) spec.defs)
  in
  let toks =
    V.map
      (\c -> ("Token${c}", c))
      (union (V.map (entryKind spec) spec.tokens) (V.map ctorOf spec.trivia))
  in V.concat [nodes, toks, V.map (\c -> (c, c)) ["ErrorNode", "Eof", "Unknown"]]

-- The parser, or -- when some choice in the grammar cannot be made by
-- looking `lookahead` tokens ahead -- what that choice is and where.
fun generate spec (env : Grammar) : [TokenTree] ! { Mut | e } =
  let counter = newRef [] in
  let root = rootOf spec in
  let x = Deciding { g = env, problems = newRef [], k = spec.lookahead } in
  let pub = if spec.public then "@pub " else "" in
  let lx = spec.lexer in
  let code =
    V.concat
      [ [Code (header spec pub)],
        classify spec,
        [Code (V.foldl (\acc d -> acc ++ "\n" ++ ruleFun spec env counter x root d) "" spec.defs),
          Code (shared spec counter),
          Code (entry spec pub root lx)],
        typed spec pub root ] in
  match V.get (getRef x.problems) 0 with
  | Just (msg, loc) -> [Fail msg loc]
  | None -> code

-- What deciding the choices of `text`, an ungrammar, costs, looking `k`
-- tokens ahead: what would be said of each that cannot be decided, and each
-- rule with the steps its choices took to walk, the costliest first. For a
-- large grammar, run as a program -- a macro has a budget of its own.
@pub fun lookaheadCost (text : String) (k : Int) :
    ([String], [(String, Int)]) ! { Mut | e } =
  match parseGrammar text with
  | Err (at, why) -> (["${show at}: ${why}"], [])
  | Ok defs ->
      let spec = {
        name = "G",
        lexer = "T",
        public = False,
        trivia = [],
        tokens = [],
        names = [],
        context = [],
        prec = None,
        lookahead = k,
        defs = defs,
        start = 0 - 1
      }
      in
      let root = (match V.get defs 0 with | Just d -> defName d | None -> "File") in
      let x = Deciding { g = lookGrammar spec root, problems = newRef [], k = k } in
      let env = x.g in
      let counter = newRef [] in
      let costs =
        V.map
          (\d ->
            let before = stepsTaken x.g in
            let code = ruleFun spec env counter x root d in
            (defName d, stepsTaken x.g - before))
          defs in
      (V.map fst (getRef x.problems), sortOn (\c -> 0 - snd c) costs)

-- --- choosing ----------------------------------------------------------------
--
-- Every choice the parser makes is decided by `Lingua.Look` before it is
-- written: the tree of tests on the tokens ahead that tells its ways apart.
-- What the grammar looks like to that: each rule's body, an enum with
-- left-recursive alternatives as its others and then what follows a left
-- side, any number of times -- which is how the Pratt loop reads it -- and
-- every place each rule is used, with what is left to read after it there.

-- What deciding needs: the grammar as `Look` walks it, the choices that could
-- not be decided, and how far ahead a choice may look.
record Deciding = { g : Grammar, problems : Ref [(String, Loc)], k : Int }

-- Which choice is being made, for what is said when it cannot be.
data Choosing = Optional | Repeated | Either | Enum [String]

use Choosing.*

fun lookGrammar spec root : Grammar ! { Mut | e } =
  let models = V.map (\d -> (defName d, model spec d)) spec.defs in
  let found = V.foldl (\acc m -> usesIn (fst m) (snd m) [;] acc) H.empty models in
  let led =
    V.concatMap
      (\d -> if isEnum d
        then
          V.map
          (\a -> (a, [(defName d, ledLoop spec (defName d) :: [;])]))
          (ledAlts spec (defName d))
        else [])
      spec.defs
  in
  let uses = V.foldl (\acc l -> H.insert (fst l) (snd l) acc) found led in
  grammar models (V.map (\d -> (defName d, H.getOr [] (defName d) uses)) spec.defs) root

fun model spec d =
  if isEnum d then
    let e = defName d in
    let others = Alt (V.map (\a -> Ref a 0) (prefixAlts spec e)) in
    if V.isEmpty (ledAlts spec e) then others else Seq [others, ledLoop spec e]
  else defBody d

-- What may follow an enum's left side, again and again.
fun ledLoop spec e = Rep (Alt (V.map (\a -> Seq (restOf spec a)) (ledAlts spec e)))

-- Every use of a rule in `r`, a body of rule `caller`, added to `acc`: the
-- rule used, and where -- the caller, and what is left to read after the use.
-- A left-recursive alternative is read inside its enum's loop instead, which
-- `lookGrammar` says.
fun usesIn (caller : String) (r : Rule) (after : List Rule)
    (acc : HashMap String [(String, List Rule)]) : HashMap String
    [(String, List Rule)] =
  match r with
  | Ref m _ -> H.insert m (V.pushBack (H.getOr [] m acc) (caller, after)) acc
  | Tok _ _ -> acc
  | Seq xs ->
      V.foldl
        (\a i -> usesIn caller (V.getOr (Seq []) xs i) (afterElement xs i after) a)
        acc
        (V.range 0 (V.len xs))
  | Alt xs -> V.foldl (\a x -> usesIn caller x after a) acc xs
  | Opt x -> usesIn caller x after acc
  | Rep x -> usesIn caller x (Rep x :: after) acc
  | Label _ _ x -> usesIn caller x after acc

-- The tree that makes a choice in rule `owner`; a choice it cannot make is
-- kept, to be said instead of writing a parser that guesses.
fun choose spec (x : Deciding) (owner : String) (what : Choosing)
    (choices : [Config]) : Tree ! { Mut | e } =
  let greedy = (match what with | Optional -> True | Repeated -> True | _ -> False) in
  let t = decide x.g choices x.k greedy in
  let u =
    (match (clashIn t, what) with
     -- A repetition or an option goes on where it cannot tell: see `Look`.
     | (Just _, Optional) -> ()
     | (Just _, Repeated) -> ()
     | (Just (ts, alts), _) ->
         setRef
           x.problems
           (V.pushBack
             (getRef x.problems)
             (clashMessage owner what ts alts x.k, whereDef spec owner))
     | (None, _) -> ()) in
  t

fun clashMessage (owner : String) (what : Choosing) (ts : [String])
    (alts : [Int]) (k : Int) : String =
  let seen = spelled ts in
  let ends = V.getOr "" ts (V.len ts - 1) == endOfInput in
  let why =
    if ends then ", and nothing after that tells them apart"
    else
      ": ${show k} tokens ahead are not enough to tell them apart -- `lookahead ${show (k + 1)}` looks further, or the grammar can say it another way" in
  match what with
  | Optional ->
      "in `${owner}`, ${seen} could begin what `?` makes optional or what comes after it${why}"
  | Repeated ->
      "in `${owner}`, ${seen} could begin another round of `*` or what comes after it${why}"
  | Either -> "in `${owner}`, ${seen} could begin more than one of its `|` alternatives${why}"
  | Enum names ->
      "`${V.getOr "" names (V.getOr 0 alts 0)}` and `${V.getOr "" names (V.getOr 0 alts 1)}` can both begin ${seen}${why}"

-- The kind a token of a decision is, in the generated code.
fun kindCode spec (t : String) : String = if t == endOfInput then kx spec "Eof" else kq spec t

-- A choice made: the tree's answer bound, and each way it can go.
fun chosen spec counter (t : Tree) (ways : [String]) (otherwise : String)
    : String ! { Mut | e } =
  "(match ${wayOf spec counter t "(0 - 1)"} with"
    ++ S.join "" (V.map (\i -> " | ${show i} -> ${V.getOr "()" ways i}") (V.range 0 (V.len ways)))
    ++ " | _ -> ${otherwise})"

-- What is left to read after element `i` of `xs`, then `after`.
fun afterElement (xs : [Rule]) (i : Int) (after : List Rule) : List Rule =
  L.append (V.toList (V.drop xs (i + 1))) after

fun header spec pub =
  "use Lingua.Parser as LinguaP
use Lingua.Build as LinguaB
use Lingua.Red as LinguaR
use Lingua.Red (Syntax)
use Lingua.Ast as LinguaA
use Lingua.Green as LinguaG
use Scythe as LinguaScythe
use Std.Collections.Vector as LinguaV
use Std.Maybe as LinguaM

@derive(Debug, PartialEq)
${pub}data ${kindType spec} = ${S.join " | " (V.map fst (kinds spec))}

impl Display ${kindType spec} {
  fun display x =
    match x with
${S.join "\n" (V.map (\c -> "    | ${kx spec (fst c)} -> \"${snd c}\"") (kinds spec))}
}

-- How a kind is named in a message: a token as it is written, a node by its
-- rule.
fun ${fn spec "name"} (x : ${kindType spec}) : String =
  match x with
${S.join "\n" (V.map (\e -> "  | ${kt spec (entryKind spec e)} -> \"`${escape (tokName e)}`\"") spec.tokens)}
  | other -> display other
"

-- The lexer's tokens as kinds, each pattern where the table wrote it; and
-- which of them are trivia.
fun classify spec : [TokenTree] =
  let arm = \pat k -> V.concat [[Punct "|" Nowhere], qualify spec pat, [Code "-> ${kt spec k}"]] in
  let tabled =
    V.filter
      (\e -> not (V.any (\c -> match c with | (n, _, _) -> n == tokName e) spec.context))
      spec.tokens
  in
  let fixed = V.filter (\e -> match e with | (_, _, pat) -> literalPattern pat) tabled in
  let open = V.filter (\e -> match e with | (_, _, pat) -> not (literalPattern pat)) tabled in
  V.concat
    [ [Code "fun ${fn spec "kindOf"} (t : ${spec.lexer}) : ${kindType spec} =\n  match t with"],
      V.concatMap (\e -> match e with | (_, _, pat) -> arm pat (entryKind spec e)) (V.append fixed open),
      V.concatMap (\pat -> arm pat (ctorOf pat)) spec.trivia,
      [Code "  | _ -> ${kx spec "Unknown"}\n\nfun ${fn spec "isTrivia"} (x : ${kindType spec}) : Bool =\n  match x with"],
      V.concatMap (\pat -> [Code "| ${kt spec (ctorOf pat)} -> True"]) spec.trivia,
      [Code "| ${kx spec "Unknown"} -> True\n  | _ -> False\n"],
      contextCode spec ]

-- A token's kind where it is: the first context entry that holds of it --
-- its pattern, and each of its conditions -- or the table's kind, `base`.
-- `ts` are the lexer's tokens, `real` the places of those that are not
-- trivia, and `r` the token's place among them.
fun contextCode spec : [TokenTree] =
  if V.isEmpty spec.context then []
  else
    let pats =
      V.concatMap
        (\c -> match c with
               | (_, pat, cs) -> V.pushFront (V.concatMap condPatterns cs) pat)
        spec.context
    in
    let preds =
      V.concatMap
        (\i ->
          V.concat
            [
              [Code "fun ${fn spec "is"}${show i} (t : ${spec.lexer}) : Bool =\n  match t with\n  "],
              [Punct "|" Nowhere],
              qualify spec (V.getOr [] pats i),
              [Code "-> True\n  | _ -> False\n"]
            ])
        (V.range 0 (V.len pats))
    in
    let index =
      \pat -> M.unwrapOr 0 (V.find (\i -> V.get pats i == Just pat) (V.range 0 (V.len pats)))
    in
    let at =
      \off pat ->
        "(match lingua_tok (r + ${off}) with | Just q -> ${fn spec "is"}${show (index pat)} q | None -> False)"
    in
    let segOf =
      \e v ->
        S.join
          " or "
          (V.concatMap
            (\c -> match c with
                   | (_, p, cs) ->
                       (if V.any (\x -> match x with | Ending e2 v2 -> treesText e2 == treesText e and treesText v2 == treesText v | _ -> False) cs
                         then [at "j - r" p]
                         else []))
            spec.context)
    in
    let cond = \c ->
      match c with
      | Before p -> at "1" p
      | After p -> at "0 - 1" p
      | Ending e v ->
          "LinguaB.onPath (\\j -> ${at "j - r" e}) (\\j -> ${at "j - r" v}) (\\j -> ${segOf e v}) r" in
    let rules =
      V.map
      (\c ->
        match c with
        | (name, pat, cs) ->
            "if ${S.join " and " (V.pushFront (V.map cond cs) (at "0" pat))} then ${kt spec (tokKind spec name)} else ")
      spec.context in
    V.concat
    [ preds,
      [ Code
        ("\nfun ${fn spec "contextKind"} (ts : [(${spec.lexer}, Int, Int)]) (real : [Int]) (r : Int) (base : ${kindType spec}) : ${kindType spec} =\n"
          ++ "  let lingua_tok = \\j -> LinguaM.andThen (\\i -> LinguaM.map (\\x -> match x with | (t, _, _) -> t) (LinguaV.get ts i)) (LinguaV.get real j) in\n  "
          ++ S.join "" rules
          ++ "base\n") ] ]

fun condPatterns c = match c with | Before p -> [p] | After p -> [p] | Ending e v -> [e, v]

fun treesText (ts : [TokenTree]) : String = S.join " " (V.map text ts)

-- `Ident _` as `Token.Ident _`, still where it was written.
fun qualify spec pat =
  match V.get pat 0 with
  | Just (Word w at) -> V.pushFront (V.drop pat 1) (Word "${spec.lexer}.${w}" at)
  | _ -> pat

-- `s` as it goes inside a string literal.
fun escape (s : String) : String =
  S.join
    ""
    (V.map
      (\i ->
        let c = stringSlice s i (i + 1) in
        if c == "\""
        then "\\\""
        else if c == "\\" then "\\\\" else if c == "$" then "\\$" else c)
      (V.range 0 (stringByteLength s)))

-- What the rules' functions share, written once: `counter` holds each piece
-- by the code it is -- a choice, a loop -- with the name it was given, so
-- that two rules which make the same choice, or read the same thing any
-- number of times, call one function. A rule's own function is then a call
-- for each thing it reads, in turn, and no more: the choices are functions
-- whose every branch is an answer, and a loop is a function that calls
-- itself -- which is also what a back end that makes a function of every
-- point a call returns to, and of every place two branches meet, is kindest
-- to.
fun hoisted spec counter (kind : String) (key : String)
    (define : String -> String) : String ! { Mut | e } =
  let known = getRef counter in
  match V.find (\k -> match k with | (code, _, _) -> code == key) known with
                      | Just (_, name, _) -> name
                      | None ->
                          let name = fn spec "${kind}${show (V.len known)}" in
                          let u = setRef counter (V.pushBack known (key, name, define name)) in
                          name

-- A choice, as a call: which way to go, by the tokens ahead. One that needs
-- no look is its answer.
fun wayOf spec counter (t : Tree) (otherwise : String) : String ! { Mut | e } =
  match t with
  | Tree.Branch _ _ ->
      let code = wayCode spec counter t otherwise in
      -- A choice every token answers alike is that answer.
      if code == otherwise then code
      else "(${hoisted spec counter "way" code (\name -> "fun ${name} p = ${code}\n")} p)"
  | Tree.Leaf a -> show a
  | Tree.Clash _ alts -> show (V.getOr 0 alts 0)

-- A choice's tree as a `match` on the token it looks at, an arm a token:
-- its answer, or -- where one token does not say -- the choice the next one
-- makes, which is a function of its own.
fun wayCode spec counter (t : Tree) (otherwise : String)
    : String ! { Mut | e } =
  match t with
  | Tree.Branch d arms ->
      -- An arm that answers what no arm would is not written: a `*` or a
      -- `?` asks only whether to go on, and most tokens say no.
      let written =
        V.concatMap
          (\arm ->
            let answer = wayOf spec counter (snd arm) otherwise in
            if answer == otherwise
            then []
            else V.map (\tk -> " | ${kindCode spec tk} -> ${answer}") (fst arm))
          arms in
      if V.isEmpty written then otherwise
      else "(match LinguaP.nth p ${show d} with${S.join "" written} | _ -> ${otherwise})"
  | other -> wayOf spec counter other otherwise

-- The pieces the rules share, and the one that reads a token: the token if
-- it is next, and an error where it would be if it is not.
fun shared spec counter : String ! { Mut | e } =
  "\nfun ${fn spec "tok"} p (k : ${kindType spec}) (missing : String) = if LinguaP.nth p 0 == k then LinguaP.advance p else LinguaP.error p missing\n\n"
    ++ S.join "\n" (V.map (\k -> match k with | (_, _, written) -> written) (getRef counter))

-- A rule's parse function: a node opens, reads its body, and closes; an enum
-- chooses an alternative, then -- if it has left-recursive ones -- reads them
-- after the left side, Pratt style.
fun ruleFun spec env counter x root d =
  let name = defName d in
  if isEnum d then enumFun spec env counter x d else if name == root then
    "fun ${fn spec name} p =
  let m = LinguaP.open p in
  let rec go u =
    let _ = ${body spec env counter x "" [;] name (defBody d)} in
    if LinguaP.atEnd p then () else (let _ = LinguaP.advanceWithError p \"unexpected ${escape name} content\" in go ())
  in
  let _ = go () in
  LinguaP.close p m ${kn spec name}
"
                                                else
                                                  "fun ${fn spec name} p =
  let m = LinguaP.open p in
  let _ = ${body spec env counter x "" [;] name (defBody d)} in
  LinguaP.close p m ${kn spec name}
"

-- The code that reads `r`, answering `()`: in rule `owner`, with `after` left
-- to read once it is done -- which is what a choice in it looks at past its
-- end. `self` is the enum a Pratt tail is read for.
fun body spec env counter x self (after : List Rule) (owner : String) (r : Rule)
    : String ! { Mut | e } =
  let sub = \left y -> body spec env counter x self left owner y in
  match r with
  | Tok t _ -> "(${fn spec "tok"} p ${kq spec t} \"expected `${escape t}`\")"
  | Ref n _ -> "(let _ = ${fn spec n} p in ())"
  | Label _ _ y -> sub after y
  | Seq xs ->
      "("
        ++ V.foldl (\acc i -> acc ++ "let _ = ${sub (afterElement xs i after) (V.getOr (Seq []) xs i)} in ") "" (V.range 0 (V.len xs))
        ++ "())"
  | Opt y ->
      let t =
        choose spec x owner Optional [Config 0 (y :: whole :: after) owner, Config 1 after owner]
      in "(if ${wayOf spec counter t "1"} == 0 then ${sub after y} else ())"
  | Rep y ->
      let t =
        choose
          spec
          x
          owner
          Repeated
          [Config 0 (y :: whole :: Rep y :: after) owner, Config 1 after owner]
      in
      let again = wayOf spec counter t "1" in
      let once = sub (Rep y :: after) y in
      "(${hoisted spec counter "loop" "${again} ${once}" (\name -> "fun ${name} p = if ${again} == 0 then (let _ = ${once} in ${name} p) else ()\n")} p)"
  | Alt xs ->
      let t =
        choose
          spec
          x
          owner
          Either
          (V.map (\i -> Config i (V.getOr (Seq []) xs i :: after) owner) (V.range 0 (V.len xs)))
      in chosen spec counter t
        (V.map (\y -> sub after y) xs)
        "LinguaP.error p \"expected one of ${escape (S.join ", " (V.map (\y -> S.join " " (fst (firstOf env y))) xs))}\""

fun enumFun spec env counter x d =
  let e = defName d in
  let alts = prefixAlts spec e in
  let after = if V.isEmpty (ledAlts spec e) then [;] else ledLoop spec e :: [;] in
  let t =
    choose
      spec
      x
      e
      (Enum alts)
      (V.map (\i -> Config i (Ref (V.getOr "" alts i) 0 :: after) e) (V.range 0 (V.len alts)))
  in
  let dispatch =
    chosen
      spec
      counter
      t
      (V.map (\a -> "${fn spec a} p") alts)
      "(let _ = LinguaP.error p \"expected ${e}\" in 0 - 1)"
  in if V.isEmpty (ledAlts spec e) then
    "fun ${fn spec e} p = ${dispatch}
"
     else
       "fun ${fn spec e} p = ${fn spec ("bp" ++ e)} p 0

fun ${fn spec ("bp" ++ e)} p (minBp : Int) : Int ! { St s | e } =
  let lhs = ${dispatch} in
  if lhs < 0 then lhs else ${fn spec ("led" ++ e)} p minBp lhs

fun ${fn spec ("led" ++ e)} p (minBp : Int) (lhs : Int) : Int ! { St s | e } =
  ${ledBranches spec env counter x e}lhs
"

-- One branch per level of the table and per postfix form: at its trigger and
-- binding tighter than what is being read, wrap the left side and read on.
fun ledBranches spec env counter x e =
  match spec.prec with
  | None -> ""
  | Just (_, ls) ->
      let top = V.len ls + 1 in
      V.foldl
        (\acc i ->
          match V.get ls i with
          | Just (assoc, items) ->
              let lbp = 2 * (i + 1) in
              if assoc == "postfix" then
                acc
                  ++ V.foldl (\acc2 a -> acc2 ++ branch spec env counter x e a (fst (firstOf env (Seq (restOf spec a)))) (2 * top) 0) "" items
              else
                let rbp = if assoc == "right" then lbp - 1 else lbp + 1 in
                acc
                  ++ V.foldl (\acc2 a -> acc2 ++ branch spec env counter x e a items lbp rbp) "" (altsFor spec env e items)
          | None -> acc)
        ""
        (V.range 0 (V.len ls))

-- The left-recursive alternatives whose trigger is among `ops`.
fun altsFor spec env e ops =
  V.filter (\a -> not (V.isEmpty (overlap (trigger spec env a) ops))) (ledAlts spec e)

fun restOf spec a = match lookupDef spec a with | Just d -> rest (defBody d) | None -> []

fun branch spec env counter x e a triggers lbp rbp =
  "if ${anyOf spec env triggers} and ${show lbp} > minBp then
    let m = LinguaP.openBefore p lhs in
    let _ = ${tail spec env counter x e (restOf spec a) rbp} in
    ${fn spec ("led" ++ e)} p minBp (LinguaP.close p m ${kn spec a})
  else "

-- What follows the left side, its last element -- the right side, when it is
-- the enum again -- read at binding power `rbp`.
fun tail spec env counter x e xs rbp =
  "("
    ++ V.foldl (\acc i -> acc ++ "let _ = ${elementAt spec env counter x e xs i rbp} in ") "" (V.range 0 (V.len xs))
    ++ "())"

-- Element `i` of a left side's tail, which the enum's loop comes back to.
fun elementAt spec env counter x e xs i rbp =
  match V.get xs i with
  | Just y ->
      if i == V.len xs - 1 and leading y == Just e and not (isSeq y) then
        "(let _ = ${fn spec ("bp" ++ e)} p ${show rbp} in ())"
      else body spec env counter x e (afterElement xs i (ledLoop spec e :: [;])) e y
  | None -> "()"

fun isSeq x = match x with | Seq _ -> True | _ -> False

-- `parseCalc`: lex, parse, build; and `parseCalcTokens`, the same from
-- tokens given rather than lexed.
fun entry spec pub root lx =
  (if V.isEmpty spec.context then streamed spec lx else gathered spec lx)
    ++ tokensEntry spec pub lx
    ++ parseEntry spec pub root

-- The lexer's tokens, a kind each by the tokens around it: gathered first,
-- then kinded, then given to the builder as `streamed` gives them.
fun gathered spec lx =
  "-- The lexer's tokens, and the text between them it skipped, as trivia: every
-- byte of `input`, in order -- each token's kind by where it is (`context`).
fun ${fn spec "lexemes"} (input : String) =
  match fold${lx} (\\acc t s e -> LinguaV.pushBack acc (t, s, e)) [] input with
  | Err err -> Err err
  | Ok ts ->
      let base = LinguaV.map (\\x -> match x with | (t, _, _) -> ${fn spec "kindOf"} t) ts in
      let real = LinguaV.filter (\\i -> not (${fn spec "isTrivia"} (LinguaV.getOr ${kx spec "Unknown"} base i))) (LinguaV.range 0 (LinguaV.len ts)) in
      let kinds = LinguaV.foldl (\\ks r -> match LinguaV.get real r with | Just i -> LinguaV.set ks i (${fn spec "contextKind"} ts real r (LinguaV.getOr ${kx spec "Unknown"} ks i)) | None -> ks) base (LinguaV.range 0 (LinguaV.len real)) in
      runSt (\\() ->
        let l = LinguaB.lexing ${kx spec "Unknown"} in
        let n = stringByteLength input in
        let last =
          LinguaV.foldl
            (\\at i ->
              match LinguaV.get ts i with
              | Just (_, s, e) ->
                  let _ = if s > at then LinguaB.lexed l ${kx spec "Unknown"} s True else () in
                  let kd = LinguaV.getOr ${kx spec "Unknown"} kinds i in
                  let _ = LinguaB.lexed l kd e (${fn spec "isTrivia"} kd) in
                  e
              | None -> at)
            0
            (LinguaV.range 0 (LinguaV.len ts)) in
        let _ = if last < n then LinguaB.lexed l ${kx spec "Unknown"} n True else () in
        Ok (LinguaB.lexemesFrom input l))
"

fun streamed spec lx =
  "-- The lexer's tokens, and the text between them it skipped, as trivia: every
-- byte of `input`, in order -- as tables, a token at a time, keeping none.
fun ${fn spec "lexemes"} (input : String) =
  runSt (\\() ->
    let l = LinguaB.lexing ${kx spec "Unknown"} in
    let n = stringByteLength input in
    let step = \\at t s e ->
      let _ = if s > at then LinguaB.lexed l ${kx spec "Unknown"} s True else () in
      let kd = ${fn spec "kindOf"} t in
      let _ = LinguaB.lexed l kd e (${fn spec "isTrivia"} kd) in
      e
    in
    match fold${lx} step 0 input with
    | Err err -> Err err
    | Ok at ->
        let _ = if at < n then LinguaB.lexed l ${kx spec "Unknown"} n True else () in
        Ok (LinguaB.lexemesFrom input l))
"

-- Each given token's kind: by the table, and then -- with `context` -- by
-- the tokens around it, as a lexed one's is.
fun tokensEntry spec pub lx =
  let base = "(LinguaV.map (\\x -> match x with | (t, _, _, _) -> ${fn spec "kindOf"} t) tokens)" in
  let kinds = if V.isEmpty spec.context then base else
    "(let ts = LinguaV.map (\\x -> match x with | (t, s, e, _) -> (t, s, e)) tokens in
        let base = ${base} in
        let real = LinguaV.filter (\\i -> not (${fn spec "isTrivia"} (LinguaV.getOr ${kx spec "Unknown"} base i))) (LinguaV.range 0 (LinguaV.len ts)) in
        LinguaV.foldl (\\ks r -> match LinguaV.get real r with | Just i -> LinguaV.set ks i (${fn spec "contextKind"} ts real r (LinguaV.getOr ${kx spec "Unknown"} ks i)) | None -> ks) base (LinguaV.range 0 (LinguaV.len real)))" in
    "
-- `tokens` -- each the lexer's token, the bytes it stands for, and its text,
-- as a macro writes them -- as a tree, and every error with the byte it is
-- at: where the token it was said at stands. The tree's text is the tokens',
-- a space between each two, and each token stands where it came from, each
-- node where its tokens do (`Lingua.Green`).
${pub}fun parse${spec.name}Tokens (tokens : [(${lx}, Int, Int, String)]) =
  let lexemes = LinguaB.tokenLexemes ${kx spec "Unknown"} ${fn spec "isTrivia"} ${kinds} (LinguaV.map (\\x -> match x with | (_, s, e, t) -> (s, e, t)) tokens) in
  ${fn spec "parsed"} lexemes
"

fun parseEntry spec pub root =
  "
-- `input` as a lossless tree, and every error with the byte it is at: a pure
-- function of the text.
${pub}fun parse${spec.name} (input : String) =
  match ${fn spec "lexemes"} input with
  | Err err ->
      (LinguaG.node ${kn spec root} [LinguaG.token ${kx spec "Unknown"} input], [(LinguaScythe.errorAt err, \"the lexer stopped here\")])
  | Ok lexemes -> ${fn spec "parsed"} lexemes

-- Lexemes parsed, and built into a tree.
fun ${fn spec "parsed"} lexemes =
  let kinds = LinguaB.parsedKinds lexemes in
  let events =
    runSt (\\() ->
      let p = LinguaP.parser kinds ${kx spec "Eof"} ${kx spec "ErrorNode"} ${fn spec "name"} in
      let _ = ${fn spec root} p in
      LinguaP.events p) in
  LinguaB.build ${kn spec root} events lexemes
"

-- --- the typed AST -----------------------------------------------------------
--
-- Each node rule a type over `Syntax`, each enum a sum of its alternatives, and
-- each element of a node an accessor named for its label -- ungrammar's
-- contract -- or, without one, for what it is: `name` for a `Name`, `names`
-- for a `Name*`, `letToken` for a `'let'`.

-- A child an accessor reads: a node of a rule, or a token of these quoted
-- names; one, or every one.
data Slot = NodeField String String Bool | TokField String [String] Bool

use Slot.*
use Std.Macro (Expand)

fun fieldName f = match f with | NodeField n _ _ -> n | TokField n _ _ -> n

fun fieldsOf spec (r : Rule) (many : Bool) : [Slot] =
  match r with
  | Tok t _ -> [TokField (lowerFirst (tokKind spec t) ++ "Token") [t] many]
  | Ref n _ -> [NodeField (lowerFirst n ++ (if many then "s" else "")) n many]
  | Label l _ x -> labelled spec l x many
  | Opt x -> fieldsOf spec x many
  | Rep x -> fieldsOf spec x True
  | Seq xs -> V.concatMap (\x -> fieldsOf spec x many) xs
  | Alt xs -> V.concatMap (\x -> fieldsOf spec x many) xs

-- `label:x`: one accessor for all of `x`. Its nodes, when it has any -- all of
-- one rule, as many as there may be -- and otherwise its tokens.
fun labelled spec l x many =
  let inner = fieldsOf spec x many in
  let nodes = V.filter (\f -> match f with | NodeField _ _ _ -> True | _ -> False) inner in
  match V.get nodes 0 with
  | Just (NodeField _ n m) -> [NodeField l n (many or m or V.len nodes > 1)]
  | _ ->
      let toks = V.concatMap (\f -> match f with | TokField _ ts _ -> ts | _ -> []) inner in
      [TokField
        l
        toks
        (many or V.any (\f -> match f with | TokField _ _ m -> m | _ -> False) inner)]

fun fieldsOfDef spec d = if isEnum d then [] else numbered (fieldsOf spec (defBody d) False)

-- A token written more than once, unlabelled -- the `[` of two lists -- is a
-- slot each time, each read by its own accessor: `lBrackToken`, then
-- `lBrackToken2`, and so on. A token says nothing by being there, so it needs
-- no name of the grammar's; two labels the same are still a mistake.
fun numbered (fs : [Slot]) : [Slot] =
  V.map
    (\i ->
      match V.get fs i with
      | Just (TokField n ts many) ->
          let before = V.len (V.filter (\g -> fieldName g == n) (V.take fs i)) in
          if before > 0 and S.endsWith "Token" n
          then TokField "${n}${show (before + 1)}" ts many
          else TokField n ts many
      | Just f -> f
      | None -> TokField "" [] False)
    (V.range 0 (V.len fs))

-- For each of `fieldsOf`'s slots, in the same order, whether it is always
-- there: not under `?` or `*`, and not one way of `|`.
fun presence (r : Rule) (certain : Bool) : [Bool] =
  match r with
  | Tok _ _ -> [certain]
  | Ref _ _ -> [certain]
  | Label _ _ x -> [certain and not (isOptional x)]
  | Opt x -> presence x False
  | Rep x -> presence x False
  | Seq xs -> V.concatMap (\x -> presence x certain) xs
  | Alt xs -> V.concatMap (\x -> presence x False) xs

-- Whether two slots can hold the same child: tokens of a kind in common, or
-- nodes a rule of one could be.
fun sameKind spec (a : Slot) (b : Slot) : Bool =
  match (a, b) with
  | (TokField _ ts _, TokField _ us _) -> V.any (\t -> V.elem t us) ts
  | (NodeField _ n _, NodeField _ m _) -> n == m or overlaps spec m n
  | _ -> False

fun isMany (f : Slot) : Bool = match f with | NodeField _ _ m -> m | TokField _ _ m -> m

-- How many of the slots before slot `i` hold children of its kind: what an
-- accessor skips to come to its own.
fun sameBefore spec (fs : [Slot]) (i : Int) : Int =
  match V.get fs i with
  | Just f -> V.len (V.filter (\g -> sameKind spec g f) (V.take fs i))
  | None -> 0

-- Where each of `fieldsOf`'s slots was written, in the same order: its name
-- -- the label, or the rule or token it is named for -- and, for a node, the
-- rule it holds. -1 for a place there is none.
fun slotsAt (r : Rule) : [(Int, Int)] =
  match r with
  | Tok _ at -> [(at, 0 - 1)]
  | Ref _ at -> [(at, at)]
  | Label _ at x -> [(at, firstRef x)]
  | Opt x -> slotsAt x
  | Rep x -> slotsAt x
  | Seq xs -> V.concatMap slotsAt xs
  | Alt xs -> V.concatMap slotsAt xs

fun firstRef (r : Rule) : Int = match V.get (refs r) 0 with | Just (_, at) -> at | None -> 0 - 1

fun slotsAtDef d = if isEnum d then [] else slotsAt (defBody d)

-- `name` as a token of the generated code: written where the grammar wrote
-- what it is named for, `n` bytes of it, so that hovering there shows it and
-- going to its definition arrives there; or, placed nowhere, as text.
fun named spec (name : String) (at : Int) (n : Int) : TokenTree =
  match inGrammar spec.start at n with
  | Nowhere -> Code name
  | loc -> Word name loc

-- Code, and spanned names, as one list of tokens.
fun tokensOf (parts : [TokenTree]) : [TokenTree] = parts

fun fieldClashes spec =
  V.concatMap
    (\d ->
      let fs = fieldsOfDef spec d in
      V.concatMap
        (\i ->
          match V.get fs i with
          | Just f ->
              if V.any (\g -> fieldName g == fieldName f) (V.take fs i) then
                [(
                  "`${defName d}` has two children that would both be `${fieldName f}`: give them labels",
                  whereDef spec (defName d)
                )]
              else []
          | None -> [])
        (V.range 0 (V.len fs)))
    spec.defs

-- A slot whose children cannot be told from an earlier slot's: one of the
-- same kind that may be missing, or may be several. The tree keeps only the
-- children, so which of them is which could only be guessed -- `Arm = pat:Pat
-- ('when' guard:Expr)? body:Expr` has one `Expr` or two, and the first is the
-- body or the guard. A rule of its own for one of them tells them apart.
fun unplaceable spec =
  V.concatMap
    (\d ->
      if isEnum d then []
      else
        let fs = fieldsOfDef spec d in
        let always = presence (defBody d) True in
        V.concatMap
          (\i ->
            match V.get fs i with
            | Just f ->
                (match V.find (\j -> match V.get fs j with | Just g -> sameKind spec g f and (isMany g or not (V.getOr True always j)) | None -> False) (V.range 0 i) with
                                     | Just j ->
                                         let g = V.getOr f fs j in
                                         [(
                                           "in `${defName d}`, `${fieldName f}` cannot be told from `${fieldName g}` before it, which may ${if isMany g then "be several" else "not be there"}: give one of them a rule of its own",
                                           whereDef spec (defName d)
                                         )]
                                     | None -> [])
            | None -> [])
          (V.range 0 (V.len fs)))
    spec.defs

fun lowerFirst (s : String) : String =
  if stringByteLength s == 0 then s
  else
    let c = stringSlice s 0 1 in
    let b = toInt (stringByteAt s 0) in
    (if b >= 65 and b <= 90
      then stringSlice "abcdefghijklmnopqrstuvwxyz" (b - 65) (b - 64)
      else c)
      ++ stringSlice s 1 (stringByteLength s)

fun upperFirst (s : String) : String =
  if stringByteLength s == 0 then s
  else
    let b = toInt (stringByteAt s 0) in
    (if b >= 97 and b <= 122
      then stringSlice "ABCDEFGHIJKLMNOPQRSTUVWXYZ" (b - 97) (b - 96)
      else stringSlice s 0 1)
      ++ stringSlice s 1 (stringByteLength s)

-- The typed AST. The names it gives a rule -- its type and its cast -- are
-- written where the rule's name is, an accessor where its label is, and the
-- rule a field holds where the grammar names it: a grammar in braces then
-- hovers as what it generates, and what it generates goes to its definition
-- in the grammar.
fun typed spec pub root : [TokenTree] =
  V.concat
    [ [Code "-- --- the typed AST ---------------------------------------------------------\n\n"],
      V.concatMap (\d -> if isEnum d then enumType spec pub d else nodeType spec pub d) spec.defs,
      [Code "\n-- The typed root of a tree `parse${spec.name}` made.\n${pub}fun ast${spec.name} g : Maybe ${ty spec root} = as${ty spec root} (LinguaR.root g)\n"] ]

-- `name` where rule `d`'s name is.
fun atRule spec d name = named spec name (defAt d) (stringByteLength (defName d))

fun nodeType spec pub d : [TokenTree] =
  let r = ty spec (defName d) in
  let kt = kindType spec in
  let fs = fieldsOfDef spec d in
  let ats = slotsAtDef d in
  V.concat
    [ [Code "${pub}data ", atRule spec d r, Code " = ${r}Node (Syntax ${kt})\n\n${pub}fun ", atRule spec d "as${r}",
       Code " (s : Syntax ${kt}) : Maybe ${r} = if LinguaR.kindOf s == ${kn spec (defName d)} then Just (${r}.${r}Node s) else None\n\n${pub}fun syntax${r} (x : ${r}) : Syntax ${kt} = match x with | ${r}.${r}Node s -> s\n"],
      V.concatMap (\i -> accessor spec pub r fs ats i) (V.range 0 (V.len fs)),
      [Code "\n", synonymOf spec pub d, Code "\n"] ]

-- --- the abstract syntax: patterns over the tree -----------------------------
--
-- A node rule is also a pattern, `pattern CalcBin lhs op rhs`, matching a
-- tree node of its kind and binding what it holds: the abstract syntax, read
-- straight off the lossless tree with nothing built. A child that is always
-- there binds as itself, and a node missing one -- a tree with an error in it
-- -- does not match; a child that may be missing binds as a `Maybe`, and one
-- that may be several as a list. Each is the child's `Syntax`, so the patterns
-- nest: `CalcBin (CalcLiteral n) op rhs`. The children a pattern binds are
-- what the language the grammar implies keeps (`grammarLang`): every node,
-- and every token that is labelled or has text of its own -- not `'let'`.
fun synonymOf spec pub d : TokenTree =
  let r = ty spec (defName d) in
  let kt = kindType spec in
  let all = fieldsOfDef spec d in
  let always = presence (defBody d) True in
  let slots =
    V.filter
      (\i -> match V.get all i with
             | Just (TokField name ts _) -> kept spec name ts
             | Just _ -> True
             | None -> False)
      (V.range 0 (V.len all))
  in
  let reads =
    V.map
      (\i ->
        let f = V.getOr (TokField "" [] False) all i in
        let read = "(${lowerFirst r}${upperFirst (fieldName f)} lingua_x)" in
        let whole = isMany f in
        let certain = V.getOr False always i and not whole in
        let back =
          (match f with
           | NodeField _ n _ -> Just "syntax${ty spec n}"
           | TokField _ _ _ -> None)
        in
        let value =
          (match back with
           | Just g ->
               (if whole then "(LinguaV.map ${g} ${read})" else "(LinguaM.map ${g} ${read})")
           | None -> read)
        in
        -- What is matched, what it binds, and what the answer holds.
        if certain then (value, "(Just lingua_v${show i})", "lingua_v${show i}")
        else (value, "lingua_v${show i}", "lingua_v${show i}"))
      slots in
  let params = S.join "" (V.map (\i -> " f${show i}") (V.range 0 (V.len slots))) in
  let answer =
    (match V.len reads with
     | 0 -> "True"
     | 1 -> "[${V.getOr "" (V.map (\x -> match x with | (_, _, v) -> v) reads) 0};]"
     | _ ->
         "[(${S.join ", " (V.map (\x -> match x with | (_, _, v) -> v) reads)});]") in
  let nothing = if V.isEmpty reads then "False" else "[;]" in
  let shape =
    (match V.len reads with
     | 0 -> "True"
     | 1 -> "[f0;]"
     | _ ->
         "[(${S.join ", " (V.map (\i -> "f${show i}") (V.range 0 (V.len reads)))});]") in
  let matched =
    (match V.len reads with
     | 0 -> answer
     | 1 ->
         (match V.get reads 0 with
          | Just (e, pat, _) -> "(match ${e} with | ${pat} -> ${answer} | _ -> ${nothing})"
          | None -> answer)
     | _ ->
         "(match (${S.join ", " (V.map (\x -> match x with | (e, _, _) -> e) reads)}) with | (${S.join ", " (V.map (\x -> match x with | (_, pat, _) -> pat) reads)}) -> ${answer} | _ -> ${nothing})") in
  let view =
    "(\\(lingua_s : Syntax ${kt}) -> if LinguaR.kindOf lingua_s == ${kn spec (defName d)} then (let lingua_x = ${r}.${r}Node lingua_s in ${matched}) else ${nothing})"
  in Code "${pub}pattern ${r}${params} <- (${view} -> ${shape})\n"

-- The accessor for field `i` of rule `r`. Two single children of one rule are
-- told apart by position: `lhs` is the first `Expr`, `rhs` the second. When an
-- earlier child's type can hold a node this one's can -- `func:Expr arg:Atom`,
-- where every `Atom` is an `Expr` -- counting by type would find the earlier
-- child again, so the position among all child nodes is what says which it is.
fun accessor spec pub r fs ats i : [TokenTree] =
  let kt = kindType spec in
  let field = match V.get fs i with | Just f -> fieldName f | None -> "" in
  let name = "${lowerFirst r}${upperFirst field}" in
  let at = V.getOr (0 - 1, 0 - 1) ats i in
  -- The accessor where its label -- or the rule or token it is named for --
  -- is, and the cast to the rule it holds where the grammar names that rule:
  -- a cast, not the type, since a function hovers with its type and goes to
  -- its definition, which is at the rule.
  let fn = named spec name (fst at) (stringByteLength (fieldBare field)) in
  let cast = \n -> named spec "as${ty spec n}" (snd at) (stringByteLength n) in
  let subject = " ${subject0 r}\n" in
  let head = \ret -> [Code "\n${pub}fun ", fn, Code " (x : ${r}) : ${ret} = "] in
  let skip = sameBefore spec fs i in
  match V.get fs i with
  | Just (NodeField _ n True) ->
      if skip == 0
      then V.concat [head "[${ty spec n}]", [Code "LinguaA.childrenOf ", cast n, Code subject]]
      else
        V.concat
          [
            head "[${ty spec n}]",
            [Code "LinguaA.childrenOfFrom ", cast n, Code " ${show skip}${subject}"]
          ]
  | Just (NodeField _ n False) ->
      let prior = V.take fs i in
      let overlapping =
        V.any
          (\f -> match f with
                 | NodeField _ m _ -> m != n and overlaps spec m n
                 | _ -> False)
          prior
      in
      let single = V.all (\f -> match f with | NodeField _ _ many -> not many | _ -> True) prior in
      if overlapping and single then
        let k = V.len (V.filter (\f -> match f with | NodeField _ _ _ -> True | _ -> False) prior)
        in V.concat
          [
            head "Maybe ${ty spec n}",
            [Code "LinguaA.nthNodeAs ", cast n, Code " ${show k}${subject}"]
          ]
      else
        let before =
          V.len
            (V.filter
              (\f -> match f with
                     | NodeField _ m False -> m == n
                     | _ -> False)
              prior)
        in V.concat
          [
            head "Maybe ${ty spec n}",
            [Code "LinguaA.nthChild ", cast n, Code " ${show before}${subject}"]
          ]
  | Just (TokField _ ts True) ->
      V.concat
        [
          head "[Syntax ${kt}]",
          [Code
            "LinguaA.tokensOfFrom [${S.join ", " (V.map (\t -> kq spec t) ts)}] ${show skip}${subject}"]
        ]
  | Just (TokField _ ts False) ->
      V.concat
        [
          head "Maybe (Syntax ${kt})",
          [Code
            "LinguaA.nthTokenOf [${S.join ", " (V.map (\t -> kq spec t) ts)}] ${show skip}${subject}"]
        ]
  | None -> []

fun subject0 r = "(syntax${r} x)"

-- Enum `e`'s cast: each alternative tried in turn, its cast where the enum
-- names it -- in groups, since a piece of code has to balance its own
-- brackets.
fun enumCast spec e (written : [(String, Int)]) : TokenTree =
  V.foldr (\w acc -> Group Paren (alternative spec e w acc) Nowhere) (Code "None") written

fun alternative spec e w acc =
  match w with
  | (a, at) ->
      [
        Code "match ",
        named spec "as${ty spec a}" at (stringByteLength a),
        Code " s with | Just y -> Just (${e}.${a} y) | None -> ",
        acc
      ]

fun enumType spec pub d : [TokenTree] =
  let e = ty spec (defName d) in
  let kt = kindType spec in
  let alts = alternatives d in
  let written = refs (defBody d) in
  let cast = enumCast spec e written in
  V.concat
    [ [Code "${pub}data ", atRule spec d e, Code " = ${S.join " | " (V.map (\a -> "${a} ${ty spec a}") alts)}\n\n${pub}fun ", atRule spec d "as${e}",
       Code " (s : Syntax ${kt}) : Maybe ${e} = ", cast,
       Code
         "\n\n${pub}fun syntax${e} (x : ${e}) : Syntax ${kt} =\n  match x with\n${S.join "\n" (V.map (\a -> "  | ${e}.${a} y -> syntax${ty spec a} y") alts)}\n\n"] ]

-- --- the language the grammar implies ----------------------------------------
--
-- What `lang! { Surface from Calc }` starts from. An enum is a sort, its
-- alternatives its productions; a node rule that is no enum's alternative is
-- a sort of one production. A production's fields are its slots in the typed
-- AST -- the same names, read by the same accessors -- less the tokens that
-- say nothing: a token is kept when it is labelled or carries text of its own
-- (`Ident _`), and `'let'` and `';'` are not.

fun grammarLang spec : Lang =
  let enums = V.filter isEnum spec.defs in
  let alts = V.concatMap alternatives enums in
  let enumSorts =
    V.map (\d -> Sort (defName d) (V.map (\a -> prodOf spec a) (alternatives d))) enums
  in
  let loners =
    V.map
      (\d -> Sort (defName d) [prodOf spec (defName d)])
      (V.filter (\d -> not (isEnum d) and not (V.elem (defName d) alts)) spec.defs)
  in
  let root = (match V.get spec.defs 0 with | Just d -> defName d | None -> "File") in
  let tokenKinds = V.map fst (V.filter (\c -> S.startsWith "Token" (fst c)) (kinds spec)) in
  let trivia = V.map (\p -> "Token${ctorOf p}") spec.trivia in
  let tokenFieldsOf =
    V.concatMap
      (\d ->
        if isEnum d then []
        else
          V.concatMap
            (\f -> match f with
                   | TokField name ts _ ->
                       (if kept spec name ts
                         then
                           [TokenField
                             (defName d)
                             (fieldBare name)
                             (V.map (\t -> "Token${tokKind spec t}") ts)]
                         else [])
                   | _ -> [])
            (fieldsOfDef spec d))
      spec.defs in
  Lang
    spec.name
    root
    (V.append enumSorts loners)
    spec.name
    []
    (AsTrees tokenKinds trivia tokenFieldsOf)
    []

-- The production of rule `r`: an enum inside an enum is a production holding
-- that enum's sort.
fun prodOf spec r =
  match lookupDef spec r with
  | Just d ->
      if isEnum d then Prod r [Field (lowerFirst r) (TSort r) "" False]
      else
        let slots = fieldsOfDef spec d in
        let opts = optsOf (defBody d) False in
        Prod
          r
          (V.concatMap
            (\i -> fieldOf spec r (V.get slots i) (V.getOr False opts i))
            (V.range 0 (V.len slots)))
  | None -> Prod r []

fun fieldOf spec r slot opt =
  let accessorOf = \name -> "${lowerFirst (ty spec r)}${upperFirst name}" in
  let shape = \many base -> if many then TMany base else if opt then TOpt base else base in
  match slot with
  | Just (NodeField name n many) -> [Field name (shape many (TSort n)) (accessorOf name) False]
  | Just (TokField name ts many) ->
      if kept spec name ts
      then [Field (fieldBare name) (shape many (TPrim "String")) (accessorOf name) True]
      else []
  | None -> []

-- Whether a token slot says anything: labelled, or a token with text.
fun kept spec name ts =
  V.len ts > 1
    or not (V.any (\t -> unnumbered name == lowerFirst (tokKind spec t) ++ "Token") ts)
    or V.any (\t -> match V.find (\e -> tokName e == t) spec.tokens with | Just (_, _, pat) -> payload pat | None -> False) ts

-- A slot's name without the number `numbered` gave it.
fun unnumbered (name : String) : String =
  let n = stringByteLength name in
  let digits =
    V.foldl
      (\acc i -> if acc == i and i < n and isDigitAt name (n - 1 - i) then acc + 1 else acc)
      0
      (V.range 0 n)
  in stringSlice name 0 (n - digits)

fun isDigitAt (s : String) (i : Int) : Bool =
  toInt (stringByteAt s i) >= 48 and toInt (stringByteAt s i) <= 57

-- `numberToken` is a field `number`, and `numberToken2` one `number2`.
fun fieldBare name =
  let base = unnumbered name in
  let number = stringSlice name (stringByteLength base) (stringByteLength name) in
  let n = stringByteLength base in
  if n > 5 and stringSlice base (n - 5) n == "Token"
  then stringSlice base 0 (n - 5) ++ number
  else name

-- For each slot, in the order `fieldsOf` makes them, whether it may be
-- missing: under `?`, or one way of an `|` that could have gone another.
fun optsOf (r : Rule) (opt : Bool) : [Bool] =
  match r with
  | Tok _ _ -> [opt]
  | Ref _ _ -> [opt]
  | Label _ _ x -> [opt or isOptional x]
  | Opt x -> optsOf x True
  | Rep x -> optsOf x opt
  | Seq xs -> V.concatMap (\x -> optsOf x opt) xs
  | Alt xs -> V.concatMap (\x -> optsOf x True) xs

fun isOptional x = match x with | Opt _ -> True | _ -> False
