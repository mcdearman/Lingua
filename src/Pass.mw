-- --- reading -----------------------------------------------------------------

-- A name, and where it was written.

fun comma p = P.thenSkip p (P.optional (punct ","))

-- A field's type as written: a name -- applied, maybe, to type variables of
-- the language's, `MType s` -- `[T]` or `Maybe T`. Fields are separated by
-- commas, which is what tells a variable from the next field's name.
data Written = WName String | WMany Written | WMaybe Written

use Written.*

def written : Parser Tokens Written =
  P.choice
    [ P.map WMany (group Bracket (P.defer (\u -> written))),
      P.skipThen (keyword "Maybe") (P.map WMaybe (P.defer (\u -> written))),
      P.pure (\n vs -> WName (S.join " " (V.pushFront vs n)))
        |> keep ident
        |> keep (P.many typeVar) ]

-- A type variable a written type is applied to: a lower-case name.
def typeVar : Parser Tokens String =
  P.token
    (\t ->
      match t with
      | Word w _ -> (if lowerStart w then Just w else None)
      | _ -> None)
    []

fun lowerStart (w : String) : Bool =
  stringByteLength w > 0
    and toInt (stringByteAt w 0) >= 97
    and toInt (stringByteAt w 0) <= 122

def fieldDecl : Parser Tokens (String, Written) =
  comma
    (P.pure (\n t -> (n, t))
      |> keep ident
      |> skip (punct ":")
      |> keep written)

-- A change to the language extended: `Sort - Prod`, `Sort + Prod { fields }`,
-- or `Sort * { fields }` -- the fields added to every production of the sort.
data Delta = Remove String String Loc | Add String Loc String [(String, Written)] | Every String Loc [(String, Written)]

use Delta.*

-- The sort, and then what is done to it -- each a function of the sort.
def delta : Parser Tokens Delta =
  P.pure (\s change -> change s)
    |> keep named
    |> keep
         (P.choice
           [ P.pure (\p s -> Remove (fst s) (fst p) (snd p))
               |> skip (punct "-")
               |> keep named,
             P.pure (\p fs s -> Add (fst s) (snd s) p fs)
               |> skip (punct "+")
               |> keep ident
               |> keep (group Brace (P.many fieldDecl)),
             P.pure (\fs s -> Every (fst s) (snd s) fs)
               |> skip (punct "*")
               |> keep (group Brace (P.many fieldDecl)) ])

-- Where a language comes from.
-- Where a language comes from: a grammar, another language it changes, or --
-- written out whole -- nothing but what it says.
data Source = FromGrammar String Loc | Extends String Loc [Delta] | Written [Delta]

use Source.*

-- A type parameter of a language: a lower-case name that is not one of the
-- words a language's declaration goes on with.
def typeParam : Parser Tokens String =
  P.token
    (\t ->
      match t with
      | Word w _ ->
          (if lowerStart w and not (V.elem w ["from", "extends", "with"]) then
            Just w
            else None)
      | _ -> None)
    []

-- `with In, set`: what a language is written with besides its tables --
-- `In`, each reading function again for a program being written; `set`, a
-- field written again on a node already written.
def asked : Parser Tokens [(String, Loc)] =
  P.map
    (\o -> M.unwrapOr [] o)
    (P.optional
      (P.pure (\first more -> V.pushFront more first)
        |> skip (keyword "with")
        |> keep named
        |> keep (P.many (P.skipThen (punct ",") named))))

def langCall : Parser Tokens (Bool, String, [String], Source, [(String, Loc)]) =
  P.pure
    (\pub name params src ->
      (M.isSome pub, name, params, fst src, snd src))
    |> keep (P.optional (keyword "pub"))
    |> keep ident
    |> keep (P.many typeParam)
    |> keep
         (P.choice
           [ P.pure (\g w -> (FromGrammar (fst g) (snd g), w))
               |> skip (keyword "from")
               |> keep named
               |> keep asked,
             P.pure (\b w ds -> (Extends (fst b) (snd b) ds, w))
               |> skip (keyword "extends")
               |> keep named
               |> keep asked
               |> keep (P.many delta),
             P.pure (\w ds -> (Written ds, w))
               |> keep asked
               |> keep (P.many delta) ])

-- --- lang! -------------------------------------------------------------------

@macro
@pub fun lang (ts : [TokenTree]) : [TokenTree] ! { Expand | e } =
  match parseTokens langCall ts with
  | Err failed -> failed
  | Ok (pub, name, params, src, extras) ->
      match V.find (\w -> not (V.elem (fst w) ["In", "set"])) extras with
      | Just w ->
          [Fail
            "a language is written `with In` -- its readers again, for a program being written -- or `with set` -- a field written again -- or both; not `${fst w}`"
            (snd w)]
      | None ->
          match baseOf src with
          | Err failed -> failed
          | Ok base ->
              match built name params base src with
              | Err failed -> failed
              | Ok made ->
                  let l = withAsked made (V.map fst extras) in
                  if isTreeLang l and not (V.isEmpty extras)
                  then
                    [Fail
                      "`${name}` is a tree language: its programs are trees, not tables, and there is nothing of them to write `with`"
                      (M.unwrapOr Nowhere (M.map snd (V.get extras 0)))]
                  else
                    let u = defineAs name l in
                    [Code (langCode (if pub then "@pub " else "") l)]

-- What a language starts from: the grammar's or the other language's, or --
-- written out whole -- a language of nothing, whose whole program is the sort
-- it says first.
fun baseOf (src : Source) : Result [TokenTree] Lang ! { Expand | e } =
  match src with
  | Written ds -> Ok (Lang "" (firstSort ds) [] "" [] AsTables [])
  | FromGrammar g at -> found g at
  | Extends b at _ -> found b at

fun found (n : String) (at : Loc) : Result [TokenTree] Lang ! { Expand | e } =
  match lookupAs n with
  | Err why -> Err [Fail "no language or grammar is called `${n}`" at]
  | Ok base -> Ok base

fun firstSort (ds : [Delta]) : String =
  match V.get ds 0 with
  | Just (Remove s _ _) -> s
  | Just (Add s _ _ _) -> s
  | Just (Every s _ _) -> s
  | None -> ""

-- The language `name` makes of `base`.
-- A language takes its base's type parameters, and any it declares.
fun built (name : String) (params : [String]) (base : Lang) (src : Source)
    : Result [TokenTree] Lang =
  let ps =
    V.append
      (langParams base)
      (V.filter (\p -> not (V.elem p (langParams base))) params)
  in
  match src with
  | FromGrammar g _ ->
      Ok (Lang name (langRoot base) (langSorts base) g ps AsTables [])
  | Written ds ->
      -- Every sort it writes, empty, first: a field may name one written
      -- further down.
      let sorts =
        V.foldl
          (\acc d -> let n = firstSort [d] in if V.elem n acc
            then acc
            else V.pushBack acc n)
          []
          ds
      in
      V.foldl
        (\acc d -> match acc with | Err e -> Err e | Ok l -> change l d)
        (Ok
          (Lang
            name
            (langRoot base)
            (V.map (\n -> Sort n []) sorts)
            ""
            ps
            AsTables
            []))
        ds
  | Extends _ _ ds ->
      V.foldl
        (\acc d -> match acc with | Err e -> Err e | Ok l -> change l d)
        -- A language extending a tree language is one too, of kinds of its own.
        (Ok
          (if isTreeLang base
            then
              Lang
              name
              (langRoot base)
              (langSorts base)
              name
              ps
              (langKeeping base)
              []
            else Lang name (langRoot base) (langSorts base) "" ps AsTables []))
        ds

fun change (l : Lang) (d : Delta) : Result [TokenTree] Lang =
  match d with
  | Remove s p at ->
      (match findSort l s with
       | None -> Err [Fail "no sort is called `${s}`" at]
       | Just sort ->
           if not (V.any (\q -> prodName q == p) (sortProds sort))
           then Err [Fail "`${s}` has no `${p}`" at]
           else
             Ok
               (withSort l (Sort s (V.filter (\q -> prodName q != p) (sortProds sort)))))
  | Add s at p fs ->
      if V.elem s reservedSorts
      then
        Err
          [Fail
            "a sort cannot be called `${s}`: the language calls its own tables `${langName l}${s}` -- give the sort another name"
            at]
      else
        let sort = M.unwrapOr (Sort s []) (findSort l s) in
        let l2 = withSort l sort in
        let fields =
          V.map (\f -> Field (fst f) (resolve l2 (snd f)) "" False) fs
        in
        let added =
          withSort
            l2
            (Sort
              s
              (V.pushBack
                (V.filter (\q -> prodName q != p) (sortProds sort))
                (Prod p fields)))
        in
        if not (isTreeLang l) then Ok added
        else if
        V.any
            (\x ->
              sortName x != s and V.any (\q -> prodName q == p) (sortProds x))
            (langSorts l)
        then
          -- A tree's node is of a kind, and a kind is a rule's name: one of
          -- a name to a language.
          Err
            [Fail
              "`${langName l}` is a tree language, and has a `${p}` already: a node's kind is its rule's name, so two sorts cannot each have one"
              at]
        else
          -- A tree's node is its children: nodes, or a token, `String`.
          (match V.find (\f -> not (childTy (fieldTy f))) fields with
           | Just f ->
               Err
                 [Fail
                   "`${p}`'s `${fieldName f}`: a node of a tree holds nodes of a sort, or a token, `String`"
                   at]
           | None ->
               let toks =
                 V.concatMap
                   (\f -> if tokenTy (fieldTy f)
                     then [TokenField p (fieldName f) []]
                     else [])
                   fields
               in
               Ok
                 (withKeeping added (match langKeeping added with | AsTrees ts tv fs0 -> AsTrees ts tv (V.append fs0 toks) | AsTables -> AsTables)))
  | Every s at fs ->
      if isTreeLang l
      then
        Err
          [Fail
            "a tree's node is its children: a field cannot be added to every production of `${s}`"
            at]
      else
        (match findSort l s with
         | None -> Err [Fail "no sort is called `${s}`" at]
         | Just sort ->
             let fields =
               V.map (\f -> Field (fst f) (resolve l (snd f)) "" False) fs
             in
             let widened =
               \q ->
                 Prod
                   (prodName q)
                   (V.append
                     (V.filter
                       (\g ->
                         not
                           (V.any
                             (\f -> fieldName f == fieldName g)
                             fields))
                       (prodFields q))
                     fields)
             in
             Ok (withSort l (Sort s (V.map widened (sortProds sort)))))

-- Whether a field of type `t` is what a tree's node can hold: a node of a
-- sort, or a token -- one, maybe one, or several.
fun childTy t =
  match t with
  | TSort _ -> True
  | TPrim n -> n == "String"
  | TOpt x -> childTy x
  | TMany x -> childTy x

fun tokenTy t =
  match t with
  | TPrim _ -> True
  | TOpt x -> tokenTy x
  | TMany x -> tokenTy x
  | TSort _ -> False

fun withKeeping l k =
  Lang
    (langName l)
    (langRoot l)
    (langSorts l)
    (langGrammar l)
    (langParams l)
    k
    (langWith l)

fun withAsked l (asked : [String]) =
  Lang
    (langName l)
    (langRoot l)
    (langSorts l)
    (langGrammar l)
    (langParams l)
    (langKeeping l)
    asked

-- Whether a language was written `with In`, or `with set`.
fun readsWriting l = V.elem "In" (langWith l)

fun rewrites l = V.elem "set" (langWith l)

-- `l` with `sort` in place of its sort of that name, or added.
fun withSort l sort =
  let others = V.filter (\x -> sortName x != sortName sort) (langSorts l) in
  let had = V.any (\x -> sortName x == sortName sort) (langSorts l) in
  let sorts =
    if had
    then
      V.map
        (\x -> if sortName x == sortName sort then sort else x)
        (langSorts l)
    else V.pushBack others sort
  in
  Lang
    (langName l)
    (langRoot l)
    sorts
    (langGrammar l)
    (langParams l)
    (langKeeping l)
    (langWith l)

-- A written type: a sort of the language, or any other type by its name.
fun resolve l w =
  match w with
  | WMany x -> TMany (resolve l x)
  | WMaybe x -> TOpt (resolve l x)
  | WName n -> if M.isSome (findSort l n) then TSort n else TPrim n

-- --- a language's code -------------------------------------------------------
--
-- A language is written out as tables, not as a type of node. Every node of a
-- program is a row: its production, where it came from, and where its fields
-- start in one table of slots -- and a node is the number of its row. A field
-- that is a node, a number or a truth is one slot; a list, or a `Maybe`, is
-- where its elements start in the slots, how many first; anything else is
-- kept in a column of its own type, the slot saying where. A program of a
-- hundred thousand nodes is a handful of arrays: passing it, walking it and
-- dropping it move no count and free nothing per node.
--
-- For a language `Core` the code has
--
--   type CoreExpr = Int                   a node of a sort, by its row
--   data CoreProgram                      the tables, and the root's row
--   data CoreArena, CoreBuilder lst       the tables, and those being written
--   newCoreBuilder, freezeCore            to start writing one, and to finish
--   newCoreExprLam b meta param body      a node, written: its row
--   data CoreExprKind, kindCoreExpr a e   which production a node is
--   coreExprLamBody a e                   a field of a node
--   metaCoreExpr a e                      where a node came from
--   data CoreExprView, viewCoreExpr a e   a node as a value to match on
--
-- each a line over what `Lingua.Lang` reads and writes every language's rows
-- with. Written `with In`, a language also has each reading function again,
-- suffixed `In`, reading a builder while it is written -- what a pass reads
-- the nodes it has just made with; and `with set`, `setCoreExprLamParam b e v`,
-- a field written again on a node already written.

fun lowerOf l = lowerFirst (langName l)

-- Every production of the language: a production's tag is its place here.
fun allProds l = V.concatMap sortProds (langSorts l)

-- A production is one of its sort's: two sorts may each have one of a name.
-- Its tag is its place among them all, sort by sort.
fun tagOf l (s : Sort) (p : Prod) : Int =
  let before = V.takeWhile (\x -> sortName x != sortName s) (langSorts l) in
  V.foldl (\acc x -> acc + V.len (sortProds x)) 0 before
    + indexOf (prodName p) (V.map prodName (sortProds s))

-- What a production is called in the names written for it: its sort's name
-- and its own -- `ExprLam`, `PatVar` -- so that `newCoreExprLam` and
-- `corePatVarName` say which they are of. The one production of a sort of
-- its own name is that name once: `newCoreName`, not `newCoreNameName`.
fun prodId (s : Sort) (p : Prod) : String =
  if V.len (sortProds s) == 1 and prodName p == sortName s then prodName p
  else sortName s ++ prodName p

-- The same, of the sort of that name in `l`: what a pass writes its target's
-- nodes with.
fun prodIdIn l (sort : String) (p : String) : String =
  match findSort l sort with
  | Just s -> prodId s (Prod p [])
  | None -> p

fun indexOf x xs =
  V.foldl
    (\acc i -> if acc < 0 and V.get xs i == Just x then i else acc)
    (0 - 1)
    (V.range 0 (V.len xs))

-- The types kept in columns of their own: every field type that is neither a
-- node, a number nor a truth, once each.
fun columns l : [String] =
  V.foldl
    (\acc n -> if V.elem n acc then acc else V.pushBack acc n)
    []
    (V.concatMap
      (\p -> V.concatMap (\f -> primsOf (fieldTy f)) (prodFields p))
      (allProds l))

fun primsOf t =
  match t with
  | TPrim n -> if n == "Int" or n == "Bool" then [] else [n]
  | TMany x -> primsOf x
  | TOpt x -> primsOf x
  | TSort _ -> []

fun columnOf l n = indexOf n (columns l)

-- The type `t` of language `l`, applied to the language's type parameters.
fun applied l t =
  if V.isEmpty (langParams l) then t else "(${t} ${S.join " " (langParams l)})"

fun params l = S.join "" (V.map (\p -> " ${p}") (langParams l))

fun arenaTy l = applied l "${langName l}Arena"

fun programTy l = applied l "${langName l}Program"

fun builderTy l = "(${langName l}Builder lst${params l})"

fun paren t = if V.len (S.split " " t) > 1 then "(${t})" else t

-- A field's value, as its type says: a node is its row.
fun valueTy l t =
  match t with
  | TSort n -> "${langName l}${n}"
  | TMany x -> "[${valueTy l x}]"
  | TOpt x -> "(Maybe ${valueTy l x})"
  | TPrim n -> paren n

-- A language's rows, read: an arena's `a`, or a builder's `b` -- and the
-- functions of `Lingua.Lang` that read each.
fun rows l (builder : Bool) : String =
  if builder then "(lingua${langName l}_w b)" else "(lingua${langName l}_t a)"

fun column l (builder : Bool) (k : Int) : String =
  if builder
  then "(lingua${langName l}_b${show k} b)"
  else "(lingua${langName l}_c${show k} a)"

fun reader (builder : Bool) (f : String) : String =
  if builder then "LinguaL.${f}In" else "LinguaL.${f}"

-- Field `i` of node `e`, read as its type says.
fun fieldRead l (builder : Bool) (t : Ty) (i : String) : String =
  decode l builder t "${reader builder "slot"} ${rows l builder} e ${i}" 0

-- The value of type `t` a slot holding `raw` stands for. `d` numbers the
-- names a list inside a list binds.
fun decode l (builder : Bool) (t : Ty) (raw : String) (d : Int) : String =
  match t with
  | TSort _ -> raw
  | TPrim n ->
      if n == "Int" then raw
      else if n == "Bool" then "(${raw} != 0)"
      else if builder
      then "LinguaBuf.at ${column l True (columnOf l n)} (${raw})"
      else "arrayGet ${column l False (columnOf l n)} (${raw})"
  | TMany x ->
      let from = "${reader builder "listFrom"} ${rows l builder} (${raw})" in
      if isWord x then from
      else
        (let i = "lingua_i${show d}" in
          "LinguaV.map (\\${i} -> ${decode l builder x i (d + 1)}) (${from})")
  | TOpt x ->
      let from = "${reader builder "maybeFrom"} ${rows l builder} (${raw})" in
      if isWord x then from
      else
        (let i = "lingua_i${show d}" in
          "LinguaM.map (\\${i} -> ${decode l builder x i (d + 1)}) (${from})")

-- The slot a value `v` of type `t` is written as: itself, or where it went
-- -- in builder `b`, whose rows are `lingua_w`.
fun encode l (t : Ty) (v : String) (d : Int) : String =
  match t with
  | TSort _ -> v
  | TPrim n ->
      if n == "Int" then v
      else if n == "Bool" then "(if ${v} then 1 else 0)"
      else "LinguaBuf.push ${column l True (columnOf l n)} (${v})"
  | TMany x -> "LinguaL.list lingua_w (${elements l x v d})"
  | TOpt x ->
      let y = "lingua_y${show d}" in
      "LinguaL.list lingua_w (match ${v} with | Just ${y} -> [${encode l x y (d + 1)}] | None -> [])"

fun elements l x v d =
  if isWord x then v
  else
    let y = "lingua_y${show d}" in
    "LinguaV.map (\\${y} -> ${encode l x y (d + 1)}) (${v})"

-- Whether a value of type `t` is its own slot.
fun isWord t =
  match t with | TSort _ -> True | TPrim n -> n == "Int" | _ -> False

fun header =
  "use Lingua.Lang (Meta, LangTables, LangWriting)
use Lingua.Lang as LinguaL
use Lingua.Red as LinguaR
use Lingua.Buf as LinguaBuf
use Lingua.Buf (Buf)
use Std.Maybe as LinguaM
use Std.Collections.Vector as LinguaV
"

fun langCode pub (l : Lang) : String =
  if isTreeLang l then treeLangCode pub l
  else
    V.foldl
    (\acc x -> acc ++ x)
    ""
    (V.concat
      [ [header, tablesCode pub l],
        V.map (\s -> sortCode pub l s) (langSorts l),
        V.map (\s -> patternCode pub l s) (langSorts l),
        V.concatMap
          (\s -> V.map (\p -> prodCode pub l s p) (sortProds s))
          (langSorts l),
        [if langGrammar l == "" then "" else fromCode pub l] ])

-- What only a language written `with In` has.
fun whenReading l (code : String) : String = if readsWriting l then code else ""

fun tablesCode pub l =
  let n = langName l in
  let lower = lowerOf l in
  let cols = columns l in
  let ks = V.range 0 (V.len cols) in
  let colTys = S.join "" (V.map (\c -> " #[${c}]") cols) in
  let colBufs = S.join "" (V.map (\c -> " (Buf lst (${c}))") cols) in
  let bufs = S.join "" (V.map (\i -> " (LinguaBuf.buffer ())") ks) in
  let bound = S.join "" (V.map (\i -> " lingua_c${show i}") ks) in
  let frozen =
    S.join "" (V.map (\i -> " (LinguaBuf.freeze lingua_c${show i})") ks)
  in
  let pick =
    \ctor k ->
      "${ctor} _${S.join "" (V.map (\i -> if i == k then " x" else " _") ks)} -> x"
  in
  "
-- `${n}`'s tables, as a program's are kept: its rows (`Lingua.Lang`), and the
-- columns the fields that are neither nodes, numbers nor truths are kept in.
${pub}data ${n}Arena${params l} = ${n}Arena LangTables${colTys}

-- The same, being written.
${pub}data ${n}Builder lst${params l} = ${n}Builder (LangWriting lst)${colBufs}

-- A `${n}` program: its tables, and its root.
${pub}data ${n}Program${params l} = ${n}Program ${arenaTy l} Int

${pub}fun ${lower}Arena (p : ${programTy l}) : ${arenaTy l} = match p with | ${n}Program a _ -> a

${pub}fun ${lower}Root (p : ${programTy l}) : Int = match p with | ${n}Program _ r -> r

fun lingua${n}_t (a : ${arenaTy l}) : LangTables = match a with | ${n}Arena t${S.join "" (V.map (\i -> " _") ks)} -> t

fun lingua${n}_w (b : ${builderTy l}) = match b with | ${n}Builder w${S.join "" (V.map (\i -> " _") ks)} -> w
${S.join "" (V.map (\k -> "\nfun lingua${n}_c${show k} (a : ${arenaTy l}) = match a with | ${pick "${n}Arena" k}\n\nfun lingua${n}_b${show k} (b : ${builderTy l}) = match b with | ${pick "${n}Builder" k}\n") ks)}
-- Empty tables, to write a program into.
${pub}fun new${n}Builder () = ${n}Builder (LinguaL.writing ())${bufs}

-- What has been written, as a program's tables.
${pub}fun freeze${n} (b : ${builderTy l}) = match b with | ${n}Builder lingua_w${bound} -> ${n}Arena (LinguaL.frozen lingua_w)${frozen}

-- Where a node starts and ends.
${pub}fun ${lower}Start (a : ${arenaTy l}) (e : Int) : Int = LinguaL.startOf ${rows l False} e

${pub}fun ${lower}End (a : ${arenaTy l}) (e : Int) : Int = LinguaL.endOf ${rows l False} e
${whenReading l "
${pub}fun ${lower}StartIn (b : ${builderTy l}) (e : Int) = LinguaL.startIn ${rows l True} e

${pub}fun ${lower}EndIn (b : ${builderTy l}) (e : Int) = LinguaL.endIn ${rows l True} e
"}"

fun sortCode pub l s =
  let n = langName l in
  let t = "${n}${sortName s}" in
  let prods = sortProds s in
  "
-- A `${sortName s}` of a `${n}` program: the row of its node.
${pub}type ${t} = Int
${if V.isEmpty prods then "" else kindCode pub l s ++ viewCode pub l s ++ copyCode pub l s ++ S.join "" (V.map (\f -> shared pub l s f) (common prods))}"

-- A node copied out with everything under it, as a program of its own whose
-- root it is: what a query answers when what matters is one part of a
-- program, so that the same part is the same value whatever is around it --
-- a comment after it, a declaration before it. `Lingua.Green.subtree` is the
-- same for a tree.
fun copyCode pub l s =
  let n = langName l in
  let lower = lowerOf l in
  let t = "${n}${sortName s}" in
  let copied = copyArm l t s in
  "
fun ${lower}Copy${sortName s} (lingua_src : ${arenaTy l}) lingua_out (e : Int) =
  match kind${t} lingua_src e with
${S.join "\n" (V.map copied (sortProds s))}

-- `${t}` `e` of `a`, and everything under it, as a program of its own.
${pub}fun sub${t} (a : ${arenaTy l}) (e : Int) : ${programTy l} =
  runSt (\\() ->
    let lingua_out = new${n}Builder () in
    let lingua_r = ${lower}Copy${sortName s} a lingua_out e in
    ${n}Program (freeze${n} lingua_out) lingua_r)
"

-- One production's arm of a copy: the node written again, its nodes copied.
fun copyArm l t s p =
  let n = langName l in
  let lower = lowerOf l in
  let fs =
    V.map
      (\f ->
        " (${copyField l (fieldTy f) "${lower}${prodId s p}${upperFirst (fieldName f)} lingua_src e"})")
      (prodFields p)
  in
  "  | ${t}Kind.${prodName p} -> new${n}${prodId s p}Span lingua_out (${lower}Start lingua_src e) (${lower}End lingua_src e)${S.join "" fs}"

fun copyField l t v =
  match t with
  | TSort n -> "${lowerOf l}Copy${n} lingua_src lingua_out (${v})"
  | TMany x -> "LinguaV.map (\\y -> ${copyField l x "y"}) (${v})"
  | TOpt x -> "LinguaM.map (\\y -> ${copyField l x "y"}) (${v})"
  | TPrim _ -> v

fun kindCode pub l s =
  let n = langName l in
  let t = "${n}${sortName s}" in
  let prods = sortProds s in
  let decide = "${lowerOf l}${sortName s}Kind" in
  let last = V.getOr (Prod "" []) prods (V.len prods - 1) in
  let tests =
    V.map
      (\p -> " | ${show (tagOf l s p)} -> ${t}Kind.${prodName p}")
      (V.take prods (V.len prods - 1))
  in
  "
-- Which production a `${t}` is.
@derive(Debug, PartialEq)
${pub}data ${t}Kind = ${S.join " | " (V.map prodName prods)}

fun ${decide} (tag : Int) : ${t}Kind = match tag with${S.join "" tests} | _ -> ${t}Kind.${prodName last}

${pub}fun kind${t} (a : ${arenaTy l}) (e : Int) : ${t}Kind = ${decide} (LinguaL.tag ${rows l False} e)

-- Where a `${t}` came from.
${pub}fun meta${t} (a : ${arenaTy l}) (e : Int) : Meta = LinguaL.metaAt ${rows l False} e
${whenReading l "
${pub}fun kind${t}In (b : ${builderTy l}) (e : Int) = ${decide} (LinguaL.tagIn ${rows l True} e)

${pub}fun meta${t}In (b : ${builderTy l}) (e : Int) = LinguaL.metaIn ${rows l True} e
"}"

fun viewCode pub l s =
  let n = langName l in
  let t = "${n}${sortName s}" in
  let prods = sortProds s in
  let fieldsTy =
    \p ->
      S.join
        ", "
        (V.pushFront
          (V.map
            (\f -> "${fieldName f} : ${valueTy l (fieldTy f)}")
            (prodFields p))
          "meta : Meta")
  in
  let arm = viewArm l t s in
  "
-- A `${t}` as a value to match on: its production, where it came from and its
-- fields -- the nodes among them rows still.
${pub}data ${t}View${params l} = ${S.join " | " (V.map (\p -> "${prodName p} ({ ${fieldsTy p} })") prods)}

${pub}fun view${t} (a : ${arenaTy l}) (e : Int) : ${applied l "${t}View"} =
  match kind${t} a e with
${S.join "\n" (V.map (arm "" "a") prods)}
${whenReading l "
${pub}fun view${t}In (b : ${builderTy l}) (e : Int) =
  match kind${t}In b e with
${S.join "\n" (V.map (arm "In" "b") prods)}
"}"

-- A `${t}` node with its arena, `(a, e)`, as if its productions were
-- constructors: `match (a, e) with | CoreExprLam x b -> …`. Each is a pattern
-- synonym, of a view of the node's kind and fields, and together they cover
-- the sort -- and once inlined nothing is left of them but the switch on the
-- kind and the reads of the fields the arm uses.
fun patternCode pub l s =
  let n = langName l in
  let t = "${n}${sortName s}" in
  let prods = sortProds s in
  let names = V.map (\p -> "${n}${prodId s p}") prods in
  "
${S.join "\n" (V.map (synonymCode pub l t s) prods)}

${pub}pattern ${S.join " | " names}
"

-- One production's synonym, and the view it is of, written in it: what the
-- node's fields are when it is that production, in the shape a synonym's
-- matcher answers -- `True` for none, `[x;]` for one, `[(x, y);]` for more.
-- In the synonym rather than beside it, so the matcher is one function, which
-- is inlined where it is used.
fun synonymCode pub l t s p =
  let n = langName l in
  let fs = prodFields p in
  let params = V.map (\f -> "f${upperFirst (fieldName f)}") fs in
  let reads =
    V.map (\f -> "${lowerOf l}${prodId s p}${upperFirst (fieldName f)} a e") fs
  in
  let view =
    "(\\(t : (${arenaTy l}, Int)) -> match t with | (a, e) -> (match kind${t} a e with | ${t}Kind.${prodName p} -> ${answer reads} | _ -> ${nothing (V.len fs)}))"
  in
  "
${pub}pattern ${n}${prodId s p} ${S.join " " params} <- (${view} -> ${answer params})
"

-- What a synonym's matcher answers for `xs`, and when there is nothing to.
fun answer (xs : [String]) : String =
  match V.len xs with
  | 0 -> "True"
  | 1 -> "[${S.join "" xs};]"
  | _ -> "[(${S.join ", " xs});]"

fun nothing (k : Int) : String = if k == 0 then "False" else "[;]"

-- One production's arm of a view: the node's fields read into a value, by
-- the functions with `suffix` from `src`.
fun viewArm l t s (suffix : String) (src : String) p =
  let fs =
    V.map
      (\f ->
        "${fieldName f} = ${lowerOf l}${prodId s p}${upperFirst (fieldName f)}${suffix} ${src} e")
      (prodFields p)
  in
  "  | ${t}Kind.${prodName p} -> ${t}View.${prodName p} { ${S.join ", " (V.pushFront fs "meta = meta${t}${suffix} ${src} e")} }"

-- The fields every one of `prods` has, as the first has them -- what a `*`
-- in a `lang!` gives a whole sort. A sort of one production has none: its
-- fields are its production's.
fun common prods =
  match V.get prods 0 with
  | Just first ->
      if V.len prods < 2
      then []
      else
        V.filter
          (\f -> V.all (\p -> V.any (\g -> g == f) (prodFields p)) prods)
          (prodFields first)
  | None -> []

fun fieldIndex p n = indexOf n (V.map fieldName (prodFields p))

-- A field every production of a sort has, read off whichever it is: where it
-- is among the fields depends on the production.
fun shared pub l s f =
  let n = langName l in
  let t = "${n}${sortName s}" in
  let name = fieldName f in
  let prods = sortProds s in
  let read = sharedReader l s f prods in
  "
-- The `${name}` of a `${t}`, whichever production it is.
${pub}fun ${name}${t} (a : ${arenaTy l}) (e : Int) : ${valueTy l (fieldTy f)} = ${read False}
${whenReading l "
${pub}fun ${name}${t}In (b : ${builderTy l}) (e : Int) = ${read True}
"}"

-- A shared field read off node `e`, where its production keeps it.
fun sharedReader l s f prods (builder : Bool) =
  let place =
    S.join
      ""
      (V.map
        (\p ->
          " | ${show (tagOf l s p)} -> ${show (fieldIndex p (fieldName f))}")
        prods)
  in
  "(let lingua_j = (match ${reader builder "tag"} ${rows l builder} e with${place} | _ -> 0) in ${fieldRead l builder (fieldTy f) "lingua_j"})"

def noField : Field = Field "" (TPrim "Int") "" False

-- A production's constructor -- a node written, in `meta`, or in the bytes
-- from `lingua_s` to `lingua_t` -- and its fields' readers. A node of up to
-- four fields is written by one call; of more, a field at a time.
fun prodCode pub l s p =
  let n = langName l in
  let fs = prodFields p in
  let idx = V.range 0 (V.len fs) in
  let fieldOf = \i -> V.getOr noField fs i in
  let ps =
    S.join
      ""
      (V.map
        (\i -> " (lingua_f${show i} : ${valueTy l (fieldTy (fieldOf i))})")
        idx)
  in
  let args = S.join "" (V.map (\i -> " lingua_f${show i}") idx) in
  -- A field that is its own slot is written as it is; any other is put
  -- where it goes first, since a list is written into the slots too.
  let slotOf =
    \i -> if isWord (fieldTy (fieldOf i))
          then "lingua_f${show i}"
          else "lingua_v${show i}"
  in
  let encoded =
    S.join
      ""
      (V.map
        (\i -> if isWord (fieldTy (fieldOf i))
          then ""
          else
            "let lingua_v${show i} = ${encode l (fieldTy (fieldOf i)) "lingua_f${show i}" 0} in ")
        idx)
  in
  let tag = show (tagOf l s p) in
  let id = prodId s p in
  let written =
    (if V.len fs <= 4
      then
        "LinguaL.node${show (V.len fs)} lingua_w ${tag} lingua_s lingua_t${S.join "" (V.map (\i -> " ${slotOf i}") idx)}"
      else
        "let lingua_first = LinguaL.mark lingua_w in ${S.join "" (V.map (\i -> "let _ = LinguaL.field lingua_w ${slotOf i} in ") idx)}LinguaL.node lingua_w ${tag} lingua_s lingua_t lingua_first") in
    "
-- A `${prodName p}` node, written: its row.
${pub}fun new${n}${id} (b : ${builderTy l}) (m : Meta)${ps} = new${n}${id}Span b (LinguaL.metaStart m) (LinguaL.metaEnd m)${args}

${pub}fun new${n}${id}Span (b : ${builderTy l}) (lingua_s : Int) (lingua_t : Int)${ps} = let lingua_w = lingua${n}_w b in ${encoded}${written}
${S.join "" (V.map (\i -> accessor pub l s p i) idx)}"

-- Field `i` of production `p`, read off a node.
fun accessor pub l s p i =
  let n = langName l in
  let f = V.getOr noField (prodFields p) i in
  let name = "${lowerOf l}${prodId s p}${upperFirst (fieldName f)}" in
  "
${pub}fun ${name} (a : ${arenaTy l}) (e : Int) : ${valueTy l (fieldTy f)} = ${fieldRead l False (fieldTy f) (show i)}
${whenReading l "
${pub}fun ${name}In (b : ${builderTy l}) (e : Int) = ${fieldRead l True (fieldTy f) (show i)}
"}${if rewrites l then setter pub l s p i f else ""}"

-- A field of one thing -- a node, a number, a truth, a text -- written again
-- on a node already written: what a pass that fixes up what it wrote uses.
fun setter pub l s p i f =
  match fieldTy f with
  | TMany _ -> ""
  | TOpt _ -> ""
  | t ->
      let n = langName l in
      "
${pub}fun set${n}${prodId s p}${upperFirst (fieldName f)} (b : ${builderTy l}) (e : Int) (lingua_v : ${valueTy l t}) = LinguaL.setSlot (lingua${n}_w b) e ${show i} (${encode l t "lingua_v" 0})
"

-- The conversion from the typed AST of the grammar the language was read off:
-- a function per sort, writing each node into the tables and answering its
-- row, or -1 for a tree with something missing in it.
fun fromCode pub l =
  let lower = lowerOf l in
  let n = langName l in
  let g = langGrammar l in
  V.foldl (\acc s -> acc ++ fromSort pub l lower s) "" (langSorts l) ++ "
-- The `${n}` program a tree `parse${g}` made, if nothing is missing from it.
${pub}fun ${lower}From${g} lingua_g : Maybe ${programTy l} =
  runSt (\\() ->
    let lingua_out = new${n}Builder () in
    match ast${g} lingua_g with
    | Just lingua_f -> (let lingua_r = ${lower}Of${langRoot l} lingua_out lingua_f in if lingua_r < 0 then None else Just (${n}Program (freeze${n} lingua_out) lingua_r))
    | None -> None)
"

fun fromSort pub l lower s =
  let g = langGrammar l in
  let prods = sortProds s in
  let single =
    V.len prods == 1
      and (match V.get prods 0 with | Just p -> prodName p == sortName s | None -> False)
  in
  if single then
    "
fun ${lower}Of${sortName s} lingua_out (y : ${g}${sortName s}) = ${build l lower s (V.getOr (Prod "" []) prods 0)}
"
  else
    "
fun ${lower}Of${sortName s} lingua_out (x : ${g}${sortName s}) =
  match x with
${S.join "\n" (V.map (\p -> "  | ${g}${sortName s}.${prodName p} y -> ${build l lower s p}") prods)}
"

-- A production from typed node `y`: each field converted, in turn, and the
-- node written only if every one was there.
fun build l lower s p =
  let fs = prodFields p in
  let made =
    "new${langName l}${prodId s p}Span lingua_out (LinguaR.offset lingua_sy) (LinguaR.endOffset lingua_sy)${S.join "" (V.map (\i -> " v${show i}") (V.range 0 (V.len fs)))}"
  in
  "(let lingua_sy = syntax${langGrammar l}${prodName p} y in ${V.foldr (\i acc -> convert lower (V.getOr noField fs i) i acc) made (V.range 0 (V.len fs))})"

-- One field of typed node `y`, converted and bound to `v<i>`, then `rest` --
-- or -1, if it is missing.
fun convert lower f i rest =
  let v = "v${show i}" in
  let acc = "${fieldAccessor f} y" in
  let fail = "(0 - 1)" in
  if fieldAccessor f == "" then
    (match fieldTy f with
     | TSort n ->
         "(let ${v} = ${lower}Of${n} lingua_out y in if ${v} < 0 then ${fail} else ${rest})"
     | _ -> "(let ${v} = y in ${rest})")
  else if fieldIsToken f then
    (match fieldTy f with
     | TMany _ -> "(let ${v} = LinguaV.map LinguaR.text (${acc}) in ${rest})"
     | TOpt _ -> "(let ${v} = LinguaM.map LinguaR.text (${acc}) in ${rest})"
     | _ ->
         "(match ${acc} with | Just lingua_t${show i} -> (let ${v} = LinguaR.text lingua_t${show i} in ${rest}) | None -> ${fail})")
  else
    match fieldTy f with
    | TMany (TSort n) ->
        "(let ${v} = LinguaV.map (\\lingua_z -> ${lower}Of${n} lingua_out lingua_z) (${acc}) in if LinguaV.any (\\lingua_z -> lingua_z < 0) ${v} then ${fail} else ${rest})"
    | TOpt (TSort n) ->
        "(match (match ${acc} with | None -> Just None | Just lingua_z -> (let lingua_w = ${lower}Of${n} lingua_out lingua_z in if lingua_w < 0 then None else Just (Just lingua_w))) with | None -> ${fail} | Just ${v} -> ${rest})"
    | TSort n ->
        "(match ${acc} with | Just lingua_z${show i} -> (let ${v} = ${lower}Of${n} lingua_out lingua_z${show i} in if ${v} < 0 then ${fail} else ${rest}) | None -> ${fail})"
    | _ -> "(let ${v} = ${acc} in ${rest})"

-- --- a tree language's code --------------------------------------------------
--
-- A tree language's program is a lossless tree of kinds of its own: a node's
-- kind says which production it is, and its fields are its children. For a
-- language `Grouped` the code has
--
--   data Grouped                            its kinds: `Grouped.NodeInfix`,
--                                           its grammar's tokens,
--                                           `Grouped.Unknown`, …
--   GroupedInfix lhs op rhs                 a production as a pattern over
--                                           `Syntax Grouped`
--   groupedIsTrivia, groupedIsToken         what a node's fields pass over,
--                                           and a token
--
-- and a pass writes one with `Lingua.Rewrite`.

-- The kinds of node a tree language's trees hold: every production that is
-- not an enum inside an enum, once.
fun treeNodes l : [String] =
  V.foldl
    (\acc p -> if V.elem p acc then acc else V.pushBack acc p)
    []
    (V.concatMap
      (\s ->
        V.concatMap
          (\p -> if innerEnum l p then [] else [prodName p])
          (sortProds s))
      (langSorts l))

fun treeLangCode pub l : String =
  let n = langName l in
  let lower = lowerOf l in
  let nodes = treeNodes l in
  let ctors =
    V.concat
      [
        V.map (\p -> "Node${p}") nodes,
        treeTokens l,
        ["ErrorNode", "Eof", "Unknown"]
      ]
  in
  let shown =
    \c -> if S.startsWith "Node" c
          then stringSlice c 4 (stringByteLength c)
          else if S.startsWith "Token" c
          then stringSlice c 5 (stringByteLength c)
          else c
  in
  let trivia =
    V.pushBack
      (V.map (\t -> "lingua_k == ${n}.${t}") (treeTrivia l))
      "lingua_k == ${n}.Unknown"
  in
  let tokens = V.map (\t -> "lingua_k == ${n}.${t}") (treeTokens l) in
  "use Lingua.Red as LinguaR
use Lingua.Red (Syntax)
use Lingua.Rewrite as LinguaW
use Std.Collections.Vector as LinguaV

@derive(Debug, PartialEq)
${pub}data ${n} = ${S.join " | " ctors}

impl Display ${n} {
  fun display x =
    match x with
${S.join "\n" (V.map (\c -> "    | ${n}.${c} -> \"${shown c}\"") ctors)}
}

-- Whether a kind of `${n}`'s trees is trivia, which a node's fields pass over.
${pub}fun ${lower}IsTrivia (lingua_k : ${n}) : Bool = ${S.join " or " trivia}

-- Whether a kind of `${n}`'s trees is a token's.
${pub}fun ${lower}IsToken (lingua_k : ${n}) : Bool = ${if V.isEmpty tokens then "False" else S.join " or " tokens}
"
    ++ S.join "" (V.concatMap (\s -> V.concatMap (\p -> if innerEnum l p then [] else [treePattern pub l p]) (sortProds s)) (langSorts l))

-- Production `p` as a pattern over the tree: its node, its fields bound off
-- the node's children -- one as itself, and the pattern fails without it;
-- maybe one as a `Maybe`; several as a list.
fun treePattern pub l p : String =
  let n = langName l in
  let lower = lowerOf l in
  let fs = prodFields p in
  let accepts = \f ->
    let t = fieldTy f in
    if tokenTy t then
      (match V.find (\tf -> match tf with | TokenField q x _ -> q == prodName p and x == fieldName f) (tokenFields l) with
                            | Just (TokenField _ _ ks) ->
                                (if V.isEmpty ks
                                  then "${lower}IsToken"
                                  else
                                    "(\\lingua_k -> ${S.join " or " (V.map (\k -> "lingua_k == ${n}.${k}") ks)})")
                            | _ -> "${lower}IsToken")
    else
      let ks =
        V.concatMap
          (kindsOfProd l)
          (M.unwrapOr [] (M.map sortProds (findSort l (sortOfTy t))))
      in
      if V.isEmpty ks
      then "(\\lingua_k -> False)"
      else
        "(\\lingua_k -> ${S.join " or " (V.map (\k -> "lingua_k == ${k}") ks)})" in
        let many = \f -> match fieldTy f with | TMany _ -> True | _ -> False in
        let opt = \f -> match fieldTy f with | TOpt _ -> True | _ -> False in
        let wants =
          S.join
          ", "
          (V.map
            (\f -> "(${accepts f}, ${if many f then "True" else "False"})")
            fs)
        in
        let reads =
          V.map
          (\i ->
            let f = V.getOr (Field "" (TPrim "") "" False) fs i in
            let got = "(LinguaV.getOr [] lingua_c ${show i})" in
            if many f then (got, "lingua_v${show i}", "lingua_v${show i}")
            else if opt f
            then
              (
                "(LinguaV.get ${got} 0)",
                "lingua_v${show i}",
                "lingua_v${show i}"
              )
            else
              (
                "(LinguaV.get ${got} 0)",
                "(Just lingua_v${show i})",
                "lingua_v${show i}"
              ))
          (V.range 0 (V.len fs)) in
          let third = \x -> match x with | (_, _, v) -> v in
          let second = \x -> match x with | (_, pat, _) -> pat in
          let first = \x -> match x with | (e, _, _) -> e in
          let params =
            S.join "" (V.map (\i -> " f${show i}") (V.range 0 (V.len fs)))
          in
          let nothing = if V.isEmpty fs then "False" else "[;]" in
          let answer =
            (match V.len fs with
             | 0 -> "True"
             | 1 -> "[${third (V.getOr ("", "", "") reads 0)};]"
             | _ -> "[(${S.join ", " (V.map third reads)});]") in
            let shape =
              (match V.len fs with
               | 0 -> "True"
               | 1 -> "[f0;]"
               | _ ->
                   "[(${S.join ", " (V.map (\i -> "f${show i}") (V.range 0 (V.len fs)))});]") in
              let matched =
                (match V.len fs with
                 | 0 -> answer
                 | 1 ->
                     "(match ${first (V.getOr ("", "", "") reads 0)} with | ${second (V.getOr ("", "", "") reads 0)} -> ${answer} | _ -> ${nothing})"
                 | _ ->
                     "(match (${S.join ", " (V.map first reads)}) with | (${S.join ", " (V.map second reads)}) -> ${answer} | _ -> ${nothing})") in
                let body =
                  if V.isEmpty fs
                  then matched
                  else
                    "(let lingua_c = LinguaW.slotsOf ${lower}IsTrivia [${wants}] lingua_s in ${matched})"
                in
                "\n${pub}pattern ${n}${prodName p}${params} <- ((\\(lingua_s : Syntax ${n}) -> if LinguaR.kindOf lingua_s == ${n}.Node${prodName p} then ${body} else ${nothing}) -> ${shape})\n"

-- The sort a field's type holds nodes of.
fun sortOfTy t =
  match t with
  | TSort x -> x
  | TOpt x -> sortOfTy x
  | TMany x -> sortOfTy x
  | TPrim _ -> ""

-- --- pass! -------------------------------------------------------------------

-- A case: the production, where it was written, the fields it names, the
-- ones of those it takes `later`, the ones it takes `raw`, and its body.
-- A case: the production it is for -- `Var`, or `Pat.Var` where two sorts
-- have one of that name -- where that was written, the fields it names,
-- which of them it takes `later` and which `raw`, and its body.
data Case = Case String Loc [(String, Loc)] [String] [String] [TokenTree]

use Case.*
use Std.Macro (Expand)

-- A field a case names: how it takes it -- `later`, `raw`, or as it is
-- translated, "" -- and the name.
def caseField : Parser Tokens (String, (String, Loc)) =
  comma
    (P.pure (\m n -> (M.unwrapOr "" m, n))
      |> keep
           (P.optional
             (P.choice
               [ P.map (\u -> "later") (keyword "later"),
                 P.map (\u -> "raw") (keyword "raw") ]))
      |> keep named)

def caseP : Parser Tokens Case =
  P.pure
    (\p of fs body ->
      Case
        (match of with | Just q -> "${fst p}.${fst q}" | None -> fst p)
        (snd p)
        (V.map snd fs)
        (V.map (\f -> fst (snd f)) (V.filter (\f -> fst f == "later") fs))
        (V.map (\f -> fst (snd f)) (V.filter (\f -> fst f == "raw") fs))
        body)
    |> skip (punct "|")
    |> keep named
    |> keep (P.optional (P.skipThen (punct ".") named))
    |> keep (group Brace (P.many caseField))
    |> skip (punct "->")
    |> keep (treesUntil (isPunct "|"))

-- A name, and where it was written.
type Named = (String, Loc)

def passCall : Parser Tokens (Bool, Named, Named, Named, Maybe String, [Case]) =
  P.pure (\pub name src dst ctx cs -> (M.isSome pub, name, src, dst, ctx, cs))
    |> keep (P.optional (keyword "pub"))
    |> keep named
    |> skip (punct ":")
    |> keep named
    |> skip (punct "->")
    |> keep named
    |> keep (P.optional (P.skipThen (keyword "with") ident))
    |> keep (P.many caseP)

@macro
@pub fun pass (ts : [TokenTree]) : [TokenTree] ! { Expand | e } =
  match parseTokens passCall ts with
  | Err failed -> failed
  | Ok (pub, name, src, dst, ctx, cases) ->
      match (lookupAs (fst src), lookupAs (fst dst)) with
      | (Err _, _) -> [Fail "no language is called `${fst src}`" (snd src)]
      | (_, Err _) -> [Fail "no language is called `${fst dst}`" (snd dst)]
      | (Ok from, Ok to) ->
          match passProblems name from to cases with
          | Just failed -> failed
          | None ->
              passCode
                (if pub then "@pub " else "")
                (fst name)
                ctx
                from
                to
                cases

-- What a pass cannot be written for, each where it is.
fun passProblems name from to cases =
  let direction =
    if isTree to and not (isTree from)
    then
      [Fail
        "`${fst name}` would write a tree of `${langName to}` from `${langName from}`'s tables: a pass writes a tree from a tree"
        (snd name)]
    else [] in
      let unknown =
        V.concatMap
        (\c -> match c with
               | Case p at fs _ _ _ ->
                   (let found = meant from p in
                     match V.get found 0 with
                     | None ->
                         [Fail "`${langName from}` has no production `${p}`" at]
                     | Just (_, prod) ->
                         if V.len found > 1
                         then [Fail (whichOf from p found) at]
                         else
                           V.concatMap
                             (\f ->
                               if V.any (\g -> fieldName g == fst f) (prodFields prod)
                               then []
                               else
                                 [Fail "`${p}` has no field `${fst f}`" (snd f)])
                             fs))
        cases in
        let uncovered =
          V.concatMap
          (\s ->
            V.concatMap
            (\p ->
              if V.any (isFor s p) cases then []
              else if copies to s p then []
              else if isTree from and innerEnum from p then []
              else
                [Fail "`${langName to}` has no `${prodName p}` as `${langName from}` has it: `${fst name}` needs a case for it" (snd name)])
            (sortProds s))
          (if isTree to then [] else translated from to cases) in
          -- To a tree: a node no case is for is kept, as the node of its name
          -- in the
          -- target -- which the target has to have.
          let unkept =
            if not (isTree to) then []
            else
              let targets = treeNodes to in
              V.concatMap
              (\n -> if V.any (\c -> caseName c == n) cases or V.elem n targets
                then []
                else
                  [Fail
                    "`${langName to}` has no `${n}` as `${langName from}` has it: `${fst name}` needs a case for it"
                    (snd name)])
              (treeNodes from) in
              match V.get (V.concat [direction, unknown, uncovered, unkept]) 0 with
              | Just f -> Just [f]
              | None -> None

fun caseName c = match c with | Case p _ _ _ _ _ -> p

-- Whether a case is for production `p` of sort `s`: by its name, or by its
-- sort's and its name.
fun isFor (s : Sort) (p : Prod) c : Bool =
  caseName c == prodName p or caseName c == "${sortName s}.${prodName p}"

-- What is said of a name two sorts have a production of.
fun whichOf l (name : String) (found : [(Sort, Prod)]) : String =
  let sorts = V.map (\x -> sortName (fst x)) found in
  "`${langName l}` has a `${name}` in ${S.join " and " (V.map (\x -> "`${x}`") sorts)}: say which, ${S.join " or " (V.map (\x -> "`${x}.${name}`") sorts)}"

-- The productions of `l` a case written `name` could be for, each with its
-- sort.
fun meant l (name : String) : [(Sort, Prod)] =
  V.concatMap
    (\s ->
      V.concatMap
        (\p -> if isFor s p (Case name Nowhere [] [] [] [])
          then [(s, p)]
          else [])
        (sortProds s))
    (langSorts l)

-- Whether `l` is a grammar's own language: its programs are trees.
fun isTree l = isTreeLang l

-- The sorts of `from` the pass has a function for. From tables, the ones the
-- target has too, as before; from a tree, the ones it can come to from the
-- root -- every one, when it writes a tree, which it may rebuild anywhere.
fun translated from to cases : [Sort] =
  if isTree to then langSorts from
  else if isTree from then
    let reached = reachable from cases in
    V.filter (\s -> V.elem (sortName s) reached) (langSorts from)
  else V.filter (\s -> M.isSome (findSort to (sortName s))) (langSorts from)

-- The sorts a pass from a tree comes to: the root's, and those of the fields
-- it translates -- a case's, those it names and takes translated; a copy's,
-- all.
fun reachable from cases : [String] =
  let rec go (todo : [String]) (seen : [String]) =
    match V.get todo 0 with
    | None -> seen
    | Just s ->
        let rest = V.drop todo 1 in
        if V.elem s seen then go rest seen
        else
          go
            (V.append
              rest
              (M.unwrapOr
                []
                (M.map
                  (\sort ->
                    V.concatMap
                      (\p -> sortsNeeded cases sort p)
                      (sortProds sort))
                  (findSort from s))))
            (V.pushBack seen s)
  in
  go [langRoot from] []

fun sortsNeeded cases s p =
  let fields =
    (match V.find (isFor s p) cases with
     | Just (Case _ _ fs _ raws _) ->
         V.filter
           (\f ->
             V.any (\g -> fst g == fieldName f) fs
               and not (V.elem (fieldName f) raws))
           (prodFields p)
     | None -> prodFields p) in
    V.concatMap (\f -> sortsIn (fieldTy f)) fields

fun sortsIn t =
  match t with
  | TSort n -> [n]
  | TMany x -> sortsIn x
  | TOpt x -> sortsIn x
  | TPrim _ -> []

-- A grammar's production that is an enum inside an enum: it holds the inner
-- enum's sort, and a node of it is a node of one of that enum's rules.
fun innerEnum from p =
  match findSort from (prodName p) with
  | Just s -> not (isLoner s)
  | None -> False

-- The sort of one rule that is not an enum's alternative.
fun isLoner s =
  V.len (sortProds s) == 1
    and M.map prodName (V.get (sortProds s) 0) == Just (sortName s)

-- The kinds a node of production `p` of a grammar can be.
fun kindsOfProd from p : [String] =
  if innerEnum from p
  then
    M.unwrapOr
      []
      (M.map
        (\s -> V.concatMap (kindsOfProd from) (sortProds s))
        (findSort from (prodName p)))
  else ["${langName from}.Node${prodName p}"]

fun prodIn l p =
  V.find (\q -> prodName q == p) (V.concatMap sortProds (langSorts l))

-- Whether production `p` of sort `s` can be copied into `to` as it is: the
-- same production in the same sort, with the same fields.
fun copies to s p =
  match findSort to (sortName s) with
  | Just t ->
      V.any
        (\q ->
          prodName q == prodName p
            and V.map fieldName (prodFields q) == V.map fieldName (prodFields p))
        (sortProds t)
  | None -> False

fun passCode pub pass ctx from to cases : [TokenTree] =
  if isTree from
  then treePassCode pub pass ctx from to cases
  else tablePassCode pub pass ctx from to cases

fun tablePassCode pub pass ctx from to cases : [TokenTree] =
  let sorts = translated from to cases in
  let c = given ctx in
  let fromN = langName from in
  let toN = langName to in
  V.concat
    [ [Code "use Std.Maybe as LinguaM\nuse Std.Collections.Vector as LinguaV\n"],
      V.concatMap (\s -> sortPass pub pass ctx from to cases s) sorts,
      [Code (if stateful from to then "" else "\n-- `${pass}`: a `${fromN}` program as a `${toN}` one, written into tables of its own.\n${pub}fun ${pass} ${c}lingua_p = runSt (\\() -> ${pass}St ${c}lingua_p)\n"),
        Code
          "\n-- `${pass}`, writing its tables inside the caller's `runSt`: for a pass whose cases\n-- use the caller's state too. A function using two `runSt`s' state at once is\n-- not one Meadow can type, so a `runSt` of its own would be one too many.\n${pub}fun ${pass}St ${c}lingua_p =\n  match lingua_p with\n  | ${fromN}Program lingua_a lingua_r ->\n      let lingua_out = new${toN}Builder () in\n      let lingua_root = ${pass}${langRoot from} lingua_a lingua_out ${c}lingua_r in\n      ${toN}Program (freeze${toN} lingua_out) lingua_root\n"] ]

-- Whether a pass goes to or from a language with type parameters: one whose
-- values -- `MType s`, cells of a `runSt`'s -- belong to some `runSt`. Such a
-- pass writes its tables in that `runSt`, and has no entry with one of its
-- own: using two `runSt`s' state at once is not something Meadow can type.
fun stateful from to =
  not (V.isEmpty (langParams from)) or not (V.isEmpty (langParams to))

-- The context as a function takes it, a parameter or an argument: its name
-- and a space, or nothing.
fun given ctx = match ctx with | Just c -> "${c} " | None -> ""

-- A sort's function: the node's production decides the arm, read off the
-- source's tables, and each arm answers the row it wrote into the target's.
fun sortPass pub pass ctx from to cases s =
  let st = "${langName from}${sortName s}" in
  if V.isEmpty (sortProds s)
  then
    [Code
      "\n${pub}fun ${pass}${sortName s} lingua_src lingua_out ${given ctx}lingua_x = lingua_x\n"]
  else
    V.concat
      [ [Code "\n${pub}fun ${pass}${sortName s} lingua_src lingua_out ${given ctx}lingua_x =\n  match kind${st} lingua_src lingua_x with"],
        V.concatMap (\p -> arm pass ctx from to cases s p) (sortProds s),
        [Code "\n"] ]

fun arm pass ctx from to cases s p =
  let st = "${langName from}${sortName s}" in
  let c = given ctx in
  let fl = lowerFirst (langName from) in
  let read = \f -> "${fl}${prodId s p}${upperFirst f} lingua_src lingua_x" in
  match V.find (isFor s p) cases with
  | Just (Case _ _ fs lates raws body) ->
      let span =
        "let lingua_ms = ${fl}Start lingua_src lingua_x in let lingua_me = ${fl}End lingua_src lingua_x in "
      in
      let here =
        if mentions "here" body
        then "let here = LinguaL.spanMeta lingua_ms lingua_me in "
        else ""
      in
      let out =
        if mentions "out" body then "let out = lingua_out in " else ""
      in
      let src =
        if mentions "src" body then "let src = lingua_src in " else ""
      in
      let binds = S.join "" (V.map (bindField pass ctx p lates raws read) fs) in
      [
        Code "\n  | ${st}Kind.${prodName p} -> ${span}${here}${out}${src}${binds}",
        Group Paren (rewrite to (sortName s) body) Nowhere
      ]
  | None ->
      let fields =
        V.map
          (\f -> " (${translate pass c (fieldTy f) (read (fieldName f))})")
          (prodFields p)
      in
      [Code
        "\n  | ${st}Kind.${prodName p} -> new${langName to}${prodIdIn to (sortName s) (prodName p)}Span lingua_out (${fl}Start lingua_src lingua_x) (${fl}End lingua_src lingua_x)${S.join "" fields}"]

-- A field a case names, bound: translated already; taken `later`, a
-- function from a context to the child translated in it; or taken `raw`, the
-- child as the source has it.
fun bindField pass ctx p lates raws read f =
  let t = fieldTyOf p (fst f) in
  if V.elem (fst f) lates
  then
    "let ${fst f} = ${laterOf ctx (\c x w -> translate pass c x w) t (read (fst f))} in "
  else if V.elem (fst f) raws then "let ${fst f} = ${read (fst f)} in "
  else "let ${fst f} = ${translate pass (given ctx) t (read (fst f))} in "

-- A field taken `later`: a function from a context to the child translated in
-- it -- or, for several children, one each, and for a child that may be
-- missing, one if it is there. Each child is then translated in the context
-- it is in: a `let`'s second binding in the one its first made, a pattern's
-- view in the one what is left of it binds.
fun laterOf ctx (tr : String -> Ty -> String -> String) (t : Ty) (v : String)
    : String =
  match t with
  | TMany x -> "LinguaV.map (\\y -> ${laterOf ctx tr x "y"}) (${v})"
  | TOpt x -> "LinguaM.map (\\y -> ${laterOf ctx tr x "y"}) (${v})"
  | _ ->
      (match ctx with
       | Just _ -> "(\\lingua_c -> ${tr "lingua_c " t v})"
       | None -> "(\\() -> ${tr "" t v})")

fun fieldTyOf p n =
  M.unwrapOr
    (TPrim "")
    (M.map fieldTy (V.find (\f -> fieldName f == n) (prodFields p)))

-- --- a pass from a tree ------------------------------------------------------
--
-- A sort's function takes a node of the tree, `Syntax`, and asks its kind which
-- of the sort's productions it is; the production's pattern binds its fields.
-- To tables, a node's function answers the row it wrote; to a tree, a piece of
-- the new tree (`Lingua.Rewrite`).

fun treePassCode pub pass ctx from to cases : [TokenTree] =
  let c = given ctx in
  let root = langRoot from in
  let toN = langName to in
  let entry =
    if isTree to then
      "\n-- `${pass}`: a `${langName from}` tree as a `${toN}` one, kept where nothing changed.\n${pub}fun ${pass} ${c}lingua_root =\n  let lingua_src = LinguaW.sourceOfWith ${pass}Kind lingua_root in\n  LinguaW.green lingua_src (${pass}${root} lingua_src lingua_src ${c}lingua_root)\n"
        ++ kindConvCode pub pass from to
    else
      (if stateful from to
        then ""
        else
          "\n-- `${pass}`: a `${langName from}` tree as a `${toN}` program, written into tables of its own.\n${pub}fun ${pass} ${c}lingua_root = runSt (\\() -> ${pass}St ${c}lingua_root)\n")
        ++ "\n-- `${pass}`, writing its tables inside the caller's `runSt`.\n${pub}fun ${pass}St ${c}lingua_root =\n  let lingua_out = new${toN}Builder () in\n  let lingua_r = ${pass}${root} () lingua_out ${c}lingua_root in\n  ${toN}Program (freeze${toN} lingua_out) lingua_r\n" in
      V.concat
      [ [Code "use Std.Maybe as LinguaM\nuse Std.Collections.Vector as LinguaV\nuse Lingua.Red as LinguaR\nuse Lingua.Rewrite as LinguaW\nuse Lingua.Lang as LinguaL\n"],
        V.concatMap (\s -> treeSortPass pub pass ctx from to cases s) (translated from to cases),
        (if isTree to then [Code (anyCode pub pass ctx from)] else []),
        [Code entry] ]

-- Each kind of `from`'s trees as the kind of `to`'s of the same name: what a
-- node or token kept is in the tree written.
fun kindConvCode pub pass from to : String =
  let f = langName from in
  let t = langName to in
  if f == t then "\nfun ${pass}Kind (lingua_k : ${f}) : ${t} = lingua_k\n"
  else
    let targets = treeNodes to in
    let targetToks = treeTokens to in
    let nodes = V.filter (\n -> V.elem n targets) (treeNodes from) in
    let toks = V.filter (\k -> V.elem k targetToks) (treeTokens from) in
    "\nfun ${pass}Kind (lingua_k : ${f}) : ${t} =\n  match lingua_k with\n"
      ++ S.join "" (V.map (\n -> "  | ${f}.Node${n} -> ${t}.Node${n}\n") nodes)
      ++ S.join "" (V.map (\k -> "  | ${f}.${k} -> ${t}.${k}\n") toks)
      ++ "  | ${f}.Eof -> ${t}.Eof\n  | ${f}.Unknown -> ${t}.Unknown\n  | _ -> ${t}.ErrorNode\n"

-- What a node no production matched is: nothing, in tables -- the tree a
-- pass reads has no errors -- and in a tree, itself, its children translated.
fun fallbackOf pass ctx to : String =
  if isTree to then rebuildCode pass ctx else "(0 - 1)"

fun rebuildCode pass ctx : String =
  "LinguaW.rebuild lingua_src (\\lingua_y -> ${pass}Any lingua_src lingua_out ${given ctx}lingua_y) lingua_x"

fun treeSortPass pub pass ctx from to cases s : [TokenTree] =
  let fallback = fallbackOf pass ctx to in
  let prods = sortProds s in
  let arms =
    if V.len prods == 1
    then V.concatMap (\p -> treeArm pass ctx from to cases s p fallback) prods
    else
      -- An arm of a `match` on the kind for each kind a production can be:
      -- one switch, where a chain of `==` tested them one by one.
      V.concat
        [ [Code "match lingua_k with"],
          V.concatMap
            (\p ->
              V.concatMap
                (\k ->
                  V.concat
                    [
                      [Code " | ${k} -> "],
                      treeArm pass ctx from to cases s p fallback
                    ])
                (kindsOfProd from p))
            prods,
          [Code " | _ -> ", Code fallback] ] in
      V.concat
      [ [Code "\n${pub}fun ${pass}${sortName s} lingua_src lingua_out ${given ctx}lingua_x =\n  let lingua_k = LinguaR.kindOf lingua_x in\n  "],
        arms,
        [Code "\n"] ]

-- A production's arm: its case, or -- with none -- the node copied into the
-- target's tables, or kept in its tree.
fun treeArm pass ctx from to cases s p fallback : [TokenTree] =
  let c = given ctx in
  let fields = prodFields p in
  let inner = innerEnum from p in
  -- Each piece of code balances its own brackets: the arm is a group of them.
  let open =
    if inner then "let lingua_f0 = lingua_x in "
    else
      "match lingua_x with | ${langName from}${prodName p}${S.join "" (V.map (\i -> " lingua_f${show i}") (V.range 0 (V.len fields)))} -> " in
      let close = if inner then "" else " | _ -> ${fallback}" in
      let span =
        "let lingua_ms = LinguaR.offset lingua_x in let lingua_me = LinguaR.endOffset lingua_x in "
      in
      match V.find (isFor s p) cases with
      | Just (Case _ _ fs lates raws body) ->
          let here =
            if mentions "here" body
            then "let here = LinguaL.spanMeta lingua_ms lingua_me in "
            else ""
          in
          let out =
            if mentions "out" body then "let out = lingua_out in " else ""
          in
          let binds =
            S.join
            ""
            (V.map (\f -> treeBind pass ctx from to p lates raws (fst f)) fs)
          in
          let answer =
            if isTree to
            then
              [
                Code "LinguaW.cover lingua_src (fst (LinguaR.textRange lingua_x)) (snd (LinguaR.textRange lingua_x)) ",
                Group Paren (rewrite to (sortName s) body) Nowhere
              ]
            else [Group Paren (rewrite to (sortName s) body) Nowhere]
          in
          [Group
            Paren
            (V.concat
              [
                [Code (open ++ span ++ here ++ out ++ binds)],
                answer,
                [Code close]
              ])
            Nowhere]
      | None ->
          if inner
          then [Code "${pass}${prodName p} lingua_src lingua_out ${c}lingua_x"]
          else if isTree to then [Code (rebuildCode pass ctx)]
          else
            let args =
              S.join
              ""
              (V.map
                (\i ->
                  " (${translateTree pass c to (M.unwrapOr (TPrim "") (M.map fieldTy (V.get fields i))) "lingua_f${show i}"})")
                (V.range 0 (V.len fields)))
            in
            [Group
              Paren
              [Code
                (open
                  ++ "new${langName to}${prodIdIn to (sortName s) (prodName p)}Span lingua_out (LinguaR.offset lingua_x) (LinguaR.endOffset lingua_x)${args}"
                  ++ close)]
              Nowhere]

-- A field a case names, bound: as the tree has it (`raw`), translated, or --
-- taken `later` -- a function from a context to the child translated in it.
fun treeBind pass ctx from to p lates raws (n : String) : String =
  let i =
    M.unwrapOr
      0
      (V.find
        (\j -> M.map fieldName (V.get (prodFields p) j) == Just n)
        (V.range 0 (V.len (prodFields p))))
  in
  let v = "lingua_f${show i}" in
  let t = fieldTyOf p n in
  if V.elem n raws then "let ${n} = ${v} in "
  else if V.elem n lates
  then
    "let ${n} = ${laterOf ctx (\c x w -> translateTree pass c to x w) t v} in "
  else "let ${n} = ${translateTree pass (given ctx) to t v} in "

-- A child of a tree translated: a node by its sort's function, a token as its
-- text -- or, to a tree, kept as it is.
fun translateTree pass c to t v =
  match t with
  | TSort n -> "${pass}${n} lingua_src lingua_out ${c}(${v})"
  | TMany x -> "LinguaV.map (\\y -> ${translateTree pass c to x "y"}) (${v})"
  | TOpt x -> "LinguaM.map (\\y -> ${translateTree pass c to x "y"}) (${v})"
  | TPrim _ ->
      if isTree to then "LinguaW.kept (${v})" else "LinguaR.text (${v})"

-- To a tree: any node, by its kind, to its sort's function; what a rebuilt
-- node's children go through.
fun anyCode pub pass ctx from : String =
  let pairs =
    V.foldl
      (\acc pr -> if V.any (\q -> fst q == fst pr) acc
        then acc
        else V.pushBack acc pr)
      []
      (V.concatMap (\s -> V.concatMap (\p -> if innerEnum from p then [] else [("${langName from}.Node${prodName p}", sortName s)]) (sortProds s)) (langSorts from)) in
    -- One `match` on the kind, which compiles to one switch: a chain of `==`
    -- tested the kinds one by one, for every node of the tree.
    "\n${pub}fun ${pass}Any lingua_src lingua_out ${given ctx}lingua_x =\n  match LinguaR.kindOf lingua_x with\n"
    ++ S.join "" (V.map (\pr -> "  | ${fst pr} -> ${pass}${snd pr} lingua_src lingua_out ${given ctx}lingua_x\n") pairs)
    ++ "  | _ -> "
    ++ rebuildCode pass ctx
    ++ "\n"

-- Whether word `w` is written anywhere in `ts`.
fun mentions (w : String) (ts : [TokenTree]) : Bool =
  V.any
    (\t -> match t with
           | Word x _ -> x == w
           | Group _ inner _ -> mentions w inner
           | _ -> False)
    ts

-- A child, translated by the pass in context `c` (see `given`): a node by its
-- sort's function, a list or an option inside, anything else as it is.
fun translate pass c t v =
  match t with
  | TSort n -> "${pass}${n} lingua_src lingua_out ${c}(${v})"
  | TMany x -> "LinguaV.map (\\y -> ${translate pass c x "y"}) (${v})"
  | TOpt x -> "LinguaM.map (\\y -> ${translate pass c x "y"}) (${v})"
  | TPrim _ -> v

-- A case's body, with each `Prod { … }` of the target language written into
-- its tables -- where the node it replaces came from -- and each of the
-- target's reading functions reading what has been written so far. Everything
-- else, and the case's own tokens, stay where they were written.
fun rewrite to (cur : String) (ts : [TokenTree]) : [TokenTree] =
  rewriteWith to cur (targetReaders to) ts

fun rewriteWith to (cur : String) readers (ts : [TokenTree]) : [TokenTree] =
  match
    V.foldl
      (\acc i ->
        match acc with
        | (done, skip) ->
            if skip then (done, False)
            else
              (match V.get ts i with
               | Just (Word w at) -> placed to cur readers ts i w at done
               | Just (Group d inner at) ->
                   (
                     V.pushBack done (Group d (rewriteWith to cur readers inner) at),
                     False
                   )
               | Just t -> (V.pushBack done t, False)
               | None -> (done, False)))
      ([], False)
      (V.range 0 (V.len ts)) with
      | (done, _) -> done

-- Word `w`, at `i`: a production of the target written with its fields, a
-- reading function of the target's, or itself.
-- `Prod { … }` is the production of that name of the sort being written, if
-- it has one, and otherwise the only one of that name; `Sort.Prod { … }` says
-- which.
fun placed to (cur : String) readers ts i w at done =
  let braced =
    (match V.get ts (i + 1) with
     | Just (Group Brace inner _) -> Just inner
     | _ -> None)
  in
  let sortBefore =
    (match (V.get ts (i - 2), qualified ts i) with
     | (Just (Word q _), True) -> (if i >= 2 then findSort to q else None)
     | _ -> None) in
    let all = meant to w in
    let chosen =
      (match sortBefore with
       | Just s -> V.filter (\x -> sortName (fst x) == sortName s) all
       | None ->
           (if qualified ts i then []
             else
               let own = V.filter (\x -> sortName (fst x) == cur) all in
               if V.isEmpty own then all else own)) in
      match (braced, V.get chosen 0) with
      | (Just inner, Just (s, prod)) ->
          if V.len chosen > 1
          then (V.pushBack done (Fail (whichOf to w chosen) at), False)
          else
            -- Written `Sort.Prod`, the sort and its dot are already there: taken
            -- back.
            let kept =
              if M.isSome sortBefore then V.take done (V.len done - 2) else done
            in
            (
              V.append kept (construct to cur readers w (sortName s) prod inner at),
              True
            )
      | _ ->
          if V.elem w readers and not (qualified ts i) then
            -- A reader of the target's reads what is being written: the target
            -- has to have been written `with In`.
            (if readsWriting to
              then
                (
                  V.pushBack done (Group Paren [Word "${w}In" at, Word "lingua_out" Nowhere] Nowhere),
                  False
                )
              else
                (
                  V.pushBack done (Fail "`${w}` here reads the `${langName to}` being written, and `${langName to}` has no readers for that: write `with In` after what it extends or is read from -- `${langName to} extends … with In`" at),
                  False
                ))
          else (V.pushBack done (Word w at), False)

-- `Prod { f = …, … }`: the node written, its fields in the production's
-- order.
fun construct to (cur : String) readers w (sort : String) prod inner at :
    [TokenTree] =
  let fields = fieldsGiven inner in
  let missing =
    V.filter
      (\f -> not (V.any (\g -> fst g == fieldName f) fields))
      (prodFields prod)
  in
  match V.get missing 0 with
  | Just f -> [Fail "`${w}` needs its `${fieldName f}`" at]
  | None ->
      if isTree to then
        -- A node of the tree, of its fields in the rule's order.
        let parts =
          V.map
            (\f ->
              let shape =
                (match fieldTy f with
                 | TMany _ -> ""
                 | TOpt _ -> "LinguaW.maybe "
                 | _ -> "LinguaW.one ")
              in
              [
                Code shape,
                Group
                  Paren
                  (rewriteWith to cur readers (valueOf fields (fieldName f)))
                  Nowhere
              ])
            (prodFields prod) in
          let listed =
            V.concat
              (V.map
                (\i ->
                  V.append
                    (if i > 0 then [Punct "," Nowhere] else [])
                    (V.getOr [] parts i))
                (V.range 0 (V.len parts)))
          in
          [ Group
            Paren
            [ Word "LinguaW.node" at,
              Code "lingua_src ${langName to}.Node${w}",
              Group
                Paren
                [Code "LinguaV.concat", Group Bracket listed Nowhere]
                Nowhere ]
            Nowhere ]
      else
        [ Group
          Paren
          (V.concat
            [[
              Word "new${langName to}${prodIdIn to sort w}Span" at,
              Code "lingua_out lingua_ms lingua_me"
            ],
              V.map
                (\f ->
                  Group
                    Paren
                    (rewriteWith to cur readers (valueOf fields (fieldName f)))
                    Nowhere)
                (prodFields prod) ])
          Nowhere ]

-- The fields a record literal gives: `name = value`, or `name` for a value
-- of that name.
fun fieldsGiven (ts : [TokenTree]) : [(String, [TokenTree])] =
  V.concatMap
    (\part ->
      match (V.get part 0, V.get part 1) with
      | (Just (Word n _), Just t) ->
          if isPunct "=" t then [(n, V.drop part 2)] else []
      | (Just (Word n at), None) -> [(n, [Word n at])]
      | _ -> [])
    (splitCommas ts)

fun splitCommas ts =
  match V.foldl (\acc t -> match acc with | (done, cur) -> (if isPunct "," t then (V.pushBack done cur, []) else (done, V.pushBack cur t))) ([], []) ts with
                           | (done, cur) ->
                               if V.isEmpty cur
                               then done
                               else V.pushBack done cur

fun valueOf fields n =
  M.unwrapOr [] (M.map snd (V.find (\g -> fst g == n) fields))

-- Every reading function the target language has: what a case reads the
-- nodes it has made with, from the tables being written.
fun targetReaders to : [String] =
  if isTree to then [] else
    let n = langName to in
    let lower = lowerFirst n in
    V.concat
    [ ["${lower}Start", "${lower}End"],
      V.concatMap
        (\s ->
          V.append
            [
              "kind${n}${sortName s}",
              "meta${n}${sortName s}",
              "view${n}${sortName s}"
            ]
            (V.map
              (\f -> "${fieldName f}${n}${sortName s}")
              (common (sortProds s))))
        (langSorts to),
      V.concatMap
        (\s ->
          V.concatMap
            (\p ->
              V.map
                (\f -> "${lower}${prodId s p}${upperFirst (fieldName f)}")
                (prodFields p))
            (sortProds s))
        (langSorts to) ]

fun qualified ts i =
  i > 0 and M.isSome (M.keepIf (isPunct ".") (V.get ts (i - 1)))

fun upperFirst (s : String) : String =
  if stringByteLength s == 0 then s
  else
    let b = toInt (stringByteAt s 0) in
    (if b >= 97 and b <= 122
      then stringSlice "ABCDEFGHIJKLMNOPQRSTUVWXYZ" (b - 97) (b - 96)
      else stringSlice s 0 1)
      ++ stringSlice s 1 (stringByteLength s)

fun lowerFirst (s : String) : String =
  if stringByteLength s == 0 then s
  else
    let b = toInt (stringByteAt s 0) in
    (if b >= 65 and b <= 90
      then stringSlice "abcdefghijklmnopqrstuvwxyz" (b - 65) (b - 64)
      else stringSlice s 0 1)
      ++ stringSlice s 1 (stringByteLength s)
