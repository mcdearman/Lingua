-- `lsp!`: a language server, from what a Lingua compiler already has.
--
--   lsp! {
--     pub Server "miniml" for Session
--     | text = setSessionSource
--     | diagnostics = diagnosticsOf
--     | tree = treeOf
--     | hover = hoverAt
--     | definition = definitionAt
--     | references = referencesAt
--     | completion = completionAt
--     | symbols = symbolsOf
--   }
--
-- A server keeps its compiler's database -- `for Session` makes it with
-- `newSession` -- and answers the editor from its queries: an edit sets a
-- file's text, and what it changed is all that is worked out again. Each
-- feature is a function of the database, a file, and -- where the editor
-- points at something -- a byte offset into it:
--
--   text          db -> Int -> String -> ()        set a file's text
--   diagnostics   db -> Int -> [Diagnostic]        what is wrong in it
--   tree          db -> Int -> Green k             its lossless tree: semantic
--                                                  tokens, folding and
--                                                  selection ranges, all read
--                                                  off it here
--   hover         db -> Int -> Int -> Maybe (Meta, String)
--   definition    db -> Int -> Int -> [(Int, Meta)]
--   references    db -> Int -> Int -> [(Int, Meta)]  -- highlights and rename too
--   completion    db -> Int -> Int -> [(String, String)]
--   symbols       db -> Int -> [(String, String, Meta)]
--
-- Only `text` is needed; the server says it can do what it was given. Where
-- a feature answers places, each is a file and a `Meta` in it. What is
-- written is `serveServer ()`, the server, on standard input and output.
--
-- The protocol is below: messages framed by `Content-Length`, positions in
-- UTF-16 code units, and the documents the editor has open.

use Std.Collections.Vector as V
use Std.Collections.HashMap as HashMap
use Std.String as S
use Std.Maybe as M
use Std.Char as C
use Std.Json as J
use Std.Json (Json)
use Std.Console (Console, readLine, readExact, writeOutput)
use Lingua.Lang (Meta)
use Lingua.Lang.Meta.*
use Lingua.Diagnostic (Diagnostic, Severity)
use Lingua.Diagnostic.Diagnostic.*
use Lingua.Green as G
use Lingua.Green (Green)
use Lingua.Red as R

-- --- messages -----------------------------------------------------------------------

-- The next message, or `None` when the editor has gone.
@pub fun readMessage () : Maybe Json ! { Console | e } =
  match contentLength 0 with
  | None -> None
  | Just n ->
      (match readExact n with
       | None -> None
       | Just body -> Just (match J.parse body with | Ok j -> j | Err _ -> J.jNull ()))

fun contentLength (n : Int) : Maybe Int ! { Console | e } =
  match readLine () with
  | None -> None
  | Just line ->
      if S.trim line == "" then (if n > 0 then Just n else contentLength n)
      else if S.startsWith "Content-Length:" line then contentLength (M.unwrapOr 0 (S.toInt (S.trim (S.drop line 15))))
      else contentLength n

@pub fun send (j : Json) : () ! { Console | e } =
  let body = J.render j in
  writeOutput "Content-Length: ${show (stringByteLength body)}\r\n\r\n${body}"

fun reply id result = send (J.jObject [("jsonrpc", J.jString "2.0"), ("id", id), ("result", result)])

fun replyError id code message =
  send (J.jObject [("jsonrpc", J.jString "2.0"), ("id", id), ("error", J.jObject [("code", J.jInt code), ("message", J.jString message)])])

fun notify method params = send (J.jObject [("jsonrpc", J.jString "2.0"), ("method", J.jString method), ("params", params)])

-- --- positions ----------------------------------------------------------------------

-- Where each line of `t` starts, in bytes.
@pub fun lineStarts (t : String) : [Int] =
  V.foldl (\acc i -> if toInt (stringByteAt t i) == 10 then V.pushBack acc (i + 1) else acc) [0] (V.range 0 (stringByteLength t))

fun lineOf (starts : [Int]) (offset : Int) : Int =
  V.foldl (\acc i -> if V.getOr 0 starts i <= offset then i else acc) 0 (V.range 0 (V.len starts))

-- How many UTF-16 code units `s` is: what the protocol counts a column in.
fun units (s : String) : Int = V.foldl (\n c -> n + (if C.code c >= 65536 then 2 else 1)) 0 (S.chars s)

fun clamp t offset = max 0 (min offset (stringByteLength t))

-- Byte `offset` of `t` as a line and a column.
@pub fun position (t : String) (starts : [Int]) (offset : Int) : (Int, Int) =
  let o = clamp t offset in
  let l = lineOf starts o in
  (l, units (stringSlice t (V.getOr 0 starts l) o))

-- A line and a column of `t` as a byte offset.
@pub fun offsetOf (t : String) (starts : [Int]) (line : Int) (col : Int) : Int =
  let len = stringByteLength t in
  let st = min len (V.getOr len starts line) in
  let stop = V.getOr len starts (line + 1) in
  let walked =
    V.foldl
      (\acc c -> match acc with
                 | (u, b) -> if u >= col then acc else (u + (if C.code c >= 65536 then 2 else 1), b + utf8Len (C.code c)))
      (0, 0)
      (S.chars (stringSlice t st stop)) in
    st + snd walked

fun utf8Len n = if n < 128 then 1 else if n < 2048 then 2 else if n < 65536 then 3 else 4

fun posJson p = J.jObject [("line", J.jInt (fst p)), ("character", J.jInt (snd p))]

@pub fun rangeJson (t : String) (starts : [Int]) (m : Meta) : Json =
  match m with
  | Meta a b -> J.jObject [("start", posJson (position t starts a)), ("end", posJson (position t starts b))]

-- The byte a request's `position` is at.
@pub fun offsetIn (t : String) (params : Json) : Int =
  let p = J.get "position" params in
  let n = \k -> M.unwrapOr 0 (M.andThen J.asInt (M.andThen (J.get k) p)) in
  offsetOf t (lineStarts t) (n "line") (n "character")

-- --- the documents open -------------------------------------------------------------

-- Each open document's file and text, by its URI; and its URI, by its file.
@pub data Docs = Docs (HashMap String Int) (HashMap Int String) (HashMap Int String) Int

fun emptyDocs () = Docs HashMap.empty HashMap.empty HashMap.empty 1

@pub fun uriOf (d : Docs) (file : Int) : String = match d with | Docs _ u _ _ -> HashMap.getOr "" file u

@pub fun textOf (d : Docs) (file : Int) : String = match d with | Docs _ _ t _ -> HashMap.getOr "" file t

@pub fun fileOf (d : Docs) (uri : String) : Maybe Int = match d with | Docs f _ _ _ -> HashMap.lookup uri f

@pub fun openFiles (d : Docs) : [Int] = match d with | Docs _ u _ _ -> HashMap.keys u

-- `uri` holding `text`: its file, a new one the first time.
fun withText (d : Docs) (uri : String) (text : String) : (Docs, Int) =
  match d with
  | Docs f u t next ->
      (match HashMap.lookup uri f with
       | Just file -> (Docs f u (HashMap.insert file text t) next, file)
       | None -> (Docs (HashMap.insert uri next f) (HashMap.insert next uri u) (HashMap.insert next text t) (next + 1), next))

-- --- serving ------------------------------------------------------------------------

-- A language server, until the editor says `exit`: `setText` told of every
-- edit, `diagnose` asked what is wrong in each open file after it, and
-- `answer` given every other request -- its method, the file it is about,
-- the file's text and the byte it points at -- answering `None` for one it
-- cannot.
@pub fun serve name features setText diagnose answer =
  loop name features setText diagnose answer (emptyDocs ())

fun loop name features setText diagnose answer docs =
  match readMessage () with
  | None -> ()
  | Just msg ->
      let method = M.unwrapOr "" (M.andThen J.asString (J.get "method" msg)) in
      let id = J.get "id" msg in
      let params = M.unwrapOr (J.jNull ()) (J.get "params" msg) in
      let uri = M.unwrapOr "" (M.andThen J.asString (J.path ["textDocument", "uri"] params)) in
      if method == "exit" then ()
      else if method == "initialize" then
        (let u = reply (M.unwrapOr (J.jNull ()) id) (initialized name features) in
          loop name features setText diagnose answer docs)
      else if method == "shutdown" then
        (let u = reply (M.unwrapOr (J.jNull ()) id) (J.jNull ()) in
          loop name features setText diagnose answer docs)
      else if method == "textDocument/didOpen" or method == "textDocument/didChange" then
        (let text = (if method == "textDocument/didOpen" then M.andThen J.asString (J.path ["textDocument", "text"] params) else lastChange params) in
          match text with
          | None -> loop name features setText diagnose answer docs
          | Just t ->
              (match withText docs uri t with
               | (d2, file) ->
                   (let u = setText file t in
                     let w = publishAll name diagnose d2 in
                     loop name features setText diagnose answer d2)))
      else if method == "textDocument/didClose" then
        (let u = notify "textDocument/publishDiagnostics" (J.jObject [("uri", J.jString uri), ("diagnostics", J.jArray [])]) in
          loop name features setText diagnose answer docs)
      else
        match id with
        | None -> loop name features setText diagnose answer docs
        | Just i ->
            (let u =
              (match fileOf docs uri with
               | None -> reply i (J.jNull ())
               | Just file ->
                   (let t = textOf docs file in
                     match answer docs method file t (offsetIn t params) params with
                     | Just r -> reply i r
                     | None -> replyError i (0 - 32601) "`${method}` is not something this server does")) in
              loop name features setText diagnose answer docs)

-- The whole text of the last change: the server asks for whole documents.
fun lastChange params =
  match M.andThen J.asArray (J.get "contentChanges" params) with
  | Just cs -> M.andThen (\c -> M.andThen J.asString (J.get "text" c)) (V.get cs (V.len cs - 1))
  | None -> None

-- What is wrong in every open file: one edit can change what another says.
fun publishAll name diagnose docs =
  V.foldl
    (\u file ->
      let t = textOf docs file in
      let starts = lineStarts t in
      notify "textDocument/publishDiagnostics"
        (J.jObject [("uri", J.jString (uriOf docs file)), ("diagnostics", J.jArray (V.map (diagnosticJson name (uriOf docs file) t starts) (diagnose file)))]))
    ()
    (openFiles docs)

fun diagnosticJson name uri t starts (d : Diagnostic) =
  match d with
  | Diagnostic sev msg at labels notes ->
      J.jObject
        [ ("range", rangeJson t starts at),
          ("severity", J.jInt (severityCode sev)),
          ("source", J.jString name),
          ("message", J.jString (S.join "\n" (V.pushFront notes msg))),
          ("relatedInformation", J.jArray (V.map (\l -> J.jObject [("location", J.jObject [("uri", J.jString uri), ("range", rangeJson t starts (fst l))]), ("message", J.jString (snd l))]) labels)) ]

fun severityCode s = match s with | Severity.Error -> 1 | Severity.Warning -> 2 | Severity.Advice -> 3

-- What the server can do, from the features it was given.
fun initialized name features =
  let has = \f -> V.elem f features in
  let when = \f fields -> if has f then fields else [] in
  J.jObject
    [ ("capabilities",
        J.jObject
          (V.concat
            [ [("positionEncoding", J.jString "utf-16"), ("textDocumentSync", J.jObject [("openClose", J.jBool True), ("change", J.jInt 1)])],
              when "tree"
                [ ("semanticTokensProvider", J.jObject [("legend", J.jObject [("tokenTypes", J.jArray (V.map J.jString tokenTypes)), ("tokenModifiers", J.jArray [])]), ("full", J.jBool True)]),
                  ("foldingRangeProvider", J.jBool True),
                  ("selectionRangeProvider", J.jBool True) ],
              when "hover" [("hoverProvider", J.jBool True)],
              when "definition" [("definitionProvider", J.jBool True)],
              when "references" [("referencesProvider", J.jBool True), ("documentHighlightProvider", J.jBool True), ("renameProvider", J.jObject [("prepareProvider", J.jBool True)])],
              when "completion" [("completionProvider", J.jObject [])],
              when "symbols" [("documentSymbolProvider", J.jBool True)] ])),
      ("serverInfo", J.jObject [("name", J.jString name)]) ]

-- --- answers ------------------------------------------------------------------------

@pub fun hoverReply (t : String) (h : Maybe (Meta, String)) : Json =
  match h with
  | None -> J.jNull ()
  | Just (m, what) -> J.jObject [("contents", J.jObject [("kind", J.jString "markdown"), ("value", J.jString what)]), ("range", rangeJson t (lineStarts t) m)]

fun locationJson docs (p : (Int, Meta)) =
  let t = textOf docs (fst p) in
  J.jObject [("uri", J.jString (uriOf docs (fst p))), ("range", rangeJson t (lineStarts t) (snd p))]

@pub fun locationsReply (docs : Docs) (ps : [(Int, Meta)]) : Json = J.jArray (V.map (locationJson docs) ps)

-- The places in `file` among `ps`, for the editor to light up.
@pub fun highlightsReply (t : String) (file : Int) (ps : [(Int, Meta)]) : Json =
  let starts = lineStarts t in
  J.jArray (V.map (\p -> J.jObject [("range", rangeJson t starts (snd p))]) (V.filter (\p -> fst p == file) ps))

-- The name the editor is on, if it is one that can be renamed: one of `ps`.
@pub fun prepareRenameReply (t : String) (file : Int) (offset : Int) (ps : [(Int, Meta)]) : Json =
  match V.find (\p -> fst p == file and within offset (snd p)) ps with
  | Just p -> rangeJson t (lineStarts t) (snd p)
  | None -> J.jNull ()

fun within o m = match m with | Meta a b -> a <= o and o <= b

@pub fun newName (params : Json) : String = M.unwrapOr "" (M.andThen J.asString (J.get "newName" params))

-- Every one of `ps` made `name`.
@pub fun renameReply (docs : Docs) (ps : [(Int, Meta)]) (name : String) : Json =
  let files = V.foldl (\acc p -> if V.elem (fst p) acc then acc else V.pushBack acc (fst p)) [] ps in
  J.jObject
    [ ("changes",
        J.jObject
          (V.map
            (\f ->
              let t = textOf docs f in
              let starts = lineStarts t in
              (uriOf docs f, J.jArray (V.map (\p -> J.jObject [("range", rangeJson t starts (snd p)), ("newText", J.jString name)]) (V.filter (\p -> fst p == f) ps))))
            files)) ]

@pub fun completionReply (items : [(String, String)]) : Json =
  J.jArray (V.map (\i -> J.jObject [("label", J.jString (fst i)), ("detail", J.jString (snd i))]) items)

@pub fun symbolsReply (t : String) (xs : [(String, String, Meta)]) : Json =
  let starts = lineStarts t in
  J.jArray
    (V.map
      (\x -> match x with
             | (n, k, m) -> J.jObject [("name", J.jString n), ("kind", J.jInt (symbolKind k)), ("range", rangeJson t starts m), ("selectionRange", rangeJson t starts m)])
      xs)

fun symbolKind k =
  if k == "function" then 12 else if k == "variable" then 13 else if k == "module" then 2
                                                             else if k == "type" then 5 else if k == "constant" then 14 else 13

-- --- read off the tree --------------------------------------------------------------

-- What a token can be, to an editor's colours.
def tokenTypes : [String] = ["keyword", "variable", "number", "string", "comment", "operator"]

-- What token `t`, of a kind called `name`, is -- read off the name the
-- grammar gave its kind, and the text: a word the grammar spells out is a
-- keyword, anything else it spells out an operator. `None` for what an
-- editor does not colour.
@pub fun tokenClass (name : String) (t : String) : Maybe Int =
  let has = \w -> S.contains w name in
  if has "Whitespace" or has "Error" or S.trim t == "" then None
  else if has "Comment" then Just 4
  else if has "Ident" or has "Name" then Just 1
  else if has "String" or has "Str" then Just 3
  else if has "Number" or has "Int" or has "Float" or V.all C.isDigit (S.chars t) then Just 2
  else if V.all (\c -> C.isAlpha c or c == '_') (S.chars t) then Just 0
  else Just 5

-- Every token of `s`, where it is.
fun allTokens s = if R.isTokenOf s then [s] else V.concatMap allTokens (R.children s)

fun allNodes s = if R.isTokenOf s then [] else V.pushFront (V.concatMap allNodes (R.children s)) s

-- Every token of the tree coloured, as the protocol encodes them: each
-- line by line, from where the last one was.
@pub fun tokensReply (t : String) (g : Green k) (kindName : k -> String) : Json =
  let starts = lineStarts t in
  let pieces =
    V.concatMap
      (\tok ->
        match tokenClass (kindName (R.kindOf tok)) (R.text tok) with
        | None -> []
        | Just c ->
            (match R.range tok with
             | (a, b) -> V.map (\seg -> (fst seg, snd seg, c)) (lineSegments t starts a b)))
      (allTokens (R.root g)) in
    J.jObject [("data", J.jArray (V.map J.jInt (encode pieces)))]

fun encode pieces =
  match
    V.foldl
      (\acc p -> match (acc, p) with
                 | ((out, pl, pc), (pos, len, c)) ->
                     (match pos with
                      | (l, col) -> (V.append out [l - pl, (if l == pl then col - pc else col), len, c, 0], l, col)))
      ([], 0, 0)
      pieces with
      | (out, _, _) -> out

-- Bytes `a` to `b` of `t`, a piece per line: where each starts, and how
-- long it is -- the protocol's tokens do not cross lines.
fun lineSegments t starts a b =
  let first = lineOf starts a in
  let last = lineOf starts (max a (b - 1)) in
  V.concatMap
    (\l ->
      let from = max a (V.getOr 0 starts l) in
      let lineEnd = V.getOr (stringByteLength t) starts (l + 1) in
      let to = min b lineEnd in
      let piece = S.trimEnd (stringSlice t from to) in
      if S.isEmpty piece then [] else [(position t starts from, units piece)])
    (V.range first (last + 1))

-- A fold for every node that takes more than one line.
@pub fun foldingReply (t : String) (g : Green k) : Json =
  let starts = lineStarts t in
  let spans =
    V.concatMap
      (\n -> match R.range n with
             | (a, b) -> (let l1 = lineOf starts a in let l2 = lineOf starts (max a (b - 1)) in if l2 > l1 then [(l1, l2)] else []))
      (allNodes (R.root g)) in
    let kept = V.foldl (\acc s -> if V.any (\k -> fst k == fst s) acc then acc else V.pushBack acc s) [] spans in
    J.jArray (V.map (\s -> J.jObject [("startLine", J.jInt (fst s)), ("endLine", J.jInt (snd s))]) kept)

-- For each position asked about: the token there, and each node around it,
-- innermost first -- what "expand selection" walks out through.
@pub fun selectionReply (t : String) (g : Green k) (params : Json) : Json =
  let starts = lineStarts t in
  let positions = M.unwrapOr [] (M.andThen J.asArray (J.get "positions" params)) in
  let root = R.root g in
  J.jArray
    (V.map
      (\p ->
        let n = \k -> M.unwrapOr 0 (M.andThen J.asInt (J.get k p)) in
        let at = offsetOf t starts (n "line") (n "character") in
        let chain = (match R.tokenAt at root with | Just tok -> V.pushFront (R.ancestors tok) tok | None -> [root]) in
        let ranges = V.foldl (\acc s -> if V.any (\r -> r == R.range s) acc then acc else V.pushBack acc (R.range s)) [] chain in
        V.foldr (\r parent -> J.jObject (V.append [("range", rangeJson t starts (Meta (fst r) (snd r)))] (if J.isNull parent then [] else [("parent", parent)]))) (J.jNull ()) ranges)
      positions)

-- --- lsp! ---------------------------------------------------------------------------

use Std.Macro (TokenTree, Loc, isPunct)
use Std.Macro.TokenTree.*
use Std.Macro.Loc.*
use Std.Macro.Parse (Tokens, parseTokens, ident, keyword, punct, stringLit)
use Std.String.Parse as P
use Std.String.Parse (Parser)

-- The features a server can be given, and what each does.
def features : [String] = ["text", "diagnostics", "tree", "hover", "definition", "references", "completion", "symbols"]

def namedP : Parser Tokens (String, Loc) = P.label "a name" (P.token (\t -> match t with | Word w at -> Just (w, at) | _ -> None) [])

-- `| hover = hoverAt`: a feature, where it was written, and the function.
def featureP : Parser Tokens ((String, Loc), String) =
  P.skipThen (punct "|") (P.bind namedP (\f -> P.skipThen (punct "=") (P.map (\fn -> (f, fn)) ident)))

def lspCall : Parser Tokens (Bool, String, String, String, [((String, Loc), String)]) =
  P.bind (P.optional (keyword "pub")) (\pub ->
    P.bind ident (\name ->
      P.bind stringLit (\lang ->
        P.skipThen (keyword "for") (P.bind ident (\db ->
          P.map (\fs -> (M.isSome pub, name, lang, db, fs)) (P.some featureP))))))

@macro
@pub fun lsp (ts : [TokenTree]) : [TokenTree] ! { Expand | e } =
  match parseTokens lspCall ts with
  | Err failed -> failed
  | Ok (pub, name, lang, db, fs) ->
      match V.find (\f -> not (V.elem (fst (fst f)) features)) fs with
      | Just f -> [Fail "a server has no feature `${fst (fst f)}`: the features are ${S.join ", " (V.map (\x -> "`${x}`") features)}" (snd (fst f))]
      | None ->
          if not (V.any (\f -> fst (fst f) == "text") fs) then [Fail "a server needs `text`: how the editor's text is given to the compiler" Nowhere]
          else [Code (lspCode (if pub then "@pub " else "") name lang db fs)]

fun lspCode pub name lang db fs =
  let fn = \f -> M.unwrapOr "" (M.map snd (V.find (\x -> fst (fst x) == f) fs)) in
  let has = \f -> V.any (\x -> fst (fst x) == f) fs in
  let arm = \f method reply -> if has f then "    else if method == \"${method}\" then Just (${reply})\n" else "" in
  let tree = "(${fn "tree"} db file)" in
  let refs = "(${fn "references"} db file offset)" in
  "use Lingua.Lsp as LinguaLsp
use Std.Collections.Vector as LinguaV

-- A language server for ${lang}, on standard input and output, until the
-- editor says `exit`.
${pub}fun serve${name} () =
  let db = new${db} () in
  LinguaLsp.serve
    \"${lang}\"
    [${S.join ", " (V.map (\f -> "\"${fst (fst f)}\"") fs)}]
    (\\file t -> ${fn "text"} db file t)
    (\\file -> ${if has "diagnostics" then "${fn "diagnostics"} db file" else "[]"})
    (\\docs method file t offset params ->
    if False then None
${arm "hover" "textDocument/hover" "LinguaLsp.hoverReply t (${fn "hover"} db file offset)"}${arm "tree" "textDocument/semanticTokens/full" "LinguaLsp.tokensReply t ${tree} display"}${arm "tree" "textDocument/foldingRange" "LinguaLsp.foldingReply t ${tree}"}${arm "tree" "textDocument/selectionRange" "LinguaLsp.selectionReply t ${tree} params"}${arm "definition" "textDocument/definition" "LinguaLsp.locationsReply docs (${fn "definition"} db file offset)"}${arm "references" "textDocument/references" "LinguaLsp.locationsReply docs ${refs}"}${arm "references" "textDocument/documentHighlight" "LinguaLsp.highlightsReply t file ${refs}"}${arm "references" "textDocument/prepareRename" "LinguaLsp.prepareRenameReply t file offset ${refs}"}${arm "references" "textDocument/rename" "LinguaLsp.renameReply docs ${refs} (LinguaLsp.newName params)"}${arm "completion" "textDocument/completion" "LinguaLsp.completionReply (${fn "completion"} db file offset)"}${arm "symbols" "textDocument/documentSymbol" "LinguaLsp.symbolsReply t (${fn "symbols"} db file)"}    else None)
"

-- --- tests --------------------------------------------------------------------------

use Std.Test (assertEq)

@test fun aColumnIsCountedInUtf16 () =
  -- `é` is two bytes and one unit; `𝑥` four bytes and two units.
  let t = "é = 1\n𝑥 + y" in
  let starts = lineStarts t in
  let a = assertEq (V.map (position t starts) [0, 2, 3, 7, 11, 12]) [(0, 0), (0, 1), (0, 2), (1, 0), (1, 2), (1, 3)] "each byte's place" in
  assertEq (V.map (\p -> offsetOf t starts (fst p) (snd p)) [(0, 1), (1, 2), (1, 4)]) [2, 11, 13] "and back"

@test fun aTokenIsColouredByItsKindAndItsText () =
  assertEq
    (V.map (\p -> tokenClass (fst p) (snd p)) [("Let", "let"), ("Ident", "x"), ("Number", "12"), ("Plus", "+"), ("Comment", "-- hi"), ("Whitespace", " ")])
    [Just 0, Just 1, Just 2, Just 5, Just 4, None]
    "keyword, name, number, operator, comment, nothing"

@test fun tokensAreEncodedFromTheOneBefore () =
  assertEq
    (encode [((0, 0), 3, 0), ((0, 4), 2, 1), ((1, 2), 1, 5)])
    [0, 0, 3, 0, 0, 0, 4, 2, 1, 0, 1, 2, 1, 5, 0]
    "the same line from its column, the next from the start"
