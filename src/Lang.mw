-- Languages: what an intermediate language is, as `lang!` and `pass!` read it.
--
-- A language is a set of sorts -- `Expr`, `Stmt` -- each a choice of
-- productions -- `Bin`, `Literal` -- each a record of fields. `syntax!`
-- leaves the language its grammar implies as a compile-time binding, `lang!`
-- makes new ones from it or from each other, and `pass!` reads the two it goes
-- between. They cross between those macros as `Datum`s, which is what `Reflect`
-- is for.
--
-- Every production a language generates also holds a `meta` its declaration
-- does not mention: where the node came from.

use Std.Collections.Vector as V
use Std.Maybe.Maybe.*
use Std.Macro (Datum, Reflect, toDatum, fromDatum)
use Std.Result.Result.*
use Lingua.Red (Syntax, range)
use Lingua.Buf as B
use Lingua.Buf (Buf)
use Ty.*
use Keeping.*

-- What a field holds: a node of a sort of the same language, several, maybe
-- one, or an ordinary Meadow type, by name.
@derive(Reflect, PartialEq)
@pub data Ty = TSort String | TMany Ty | TOpt Ty | TPrim String

-- A field: its name, what it holds, and -- in a language read off a grammar --
-- the typed-AST accessor that reads it and whether that answers a token.
@derive(Reflect, PartialEq)
@pub data Field = Field String Ty String Bool

-- A production: its name and its fields.
@derive(Reflect, PartialEq)
@pub data Prod = Prod String [Field]

-- A sort: its name and its productions.
@derive(Reflect, PartialEq)
@pub data Sort = Sort String [Prod]

-- A token field of a tree's node: its production, its name, and the kinds of
-- token it holds -- any token, when there are none.
@derive(Reflect, PartialEq)
@pub data TokenField = TokenField String String [String]

-- How a language's programs are kept: as tables -- a node a row -- or as
-- trees, a node a node of a lossless tree whose kinds are the language's own.
-- A tree language knows the kinds of token its trees hold, which of them are
-- trivia, and which a token field reads.
@derive(Reflect, PartialEq)
@pub data Keeping
  = AsTables
  | AsTrees [String] [String] [TokenField]

-- A language: its name, the sort a whole program is, its sorts, -- when it
-- was read off a grammar -- which grammar, the type parameters its types take
-- (`Inferring s`, whose nodes hold types made of cells of a `runSt`'s), how
-- its programs are kept, and what it asked for besides (`with In, set`).
@derive(Reflect, PartialEq)
@pub data Lang
  = Lang String String [Sort] String [String] Keeping [String]

-- What no sort may be called: a language's own types are its name and these
-- -- `CoreProgram`, `CoreArena`, `CoreBuilder` -- and a sort's type is its
-- name after the language's too.
@pub def reservedSorts : [String] = ["Program", "Arena", "Builder"]

@pub fun langName (l : Lang) : String = match l with | Lang n _ _ _ _ _ _ -> n

@pub fun langRoot (l : Lang) : String = match l with | Lang _ r _ _ _ _ _ -> r

@pub fun langSorts (l : Lang) : [Sort] = match l with | Lang _ _ ss _ _ _ _ -> ss

@pub fun langGrammar (l : Lang) : String = match l with | Lang _ _ _ g _ _ _ -> g

@pub fun langParams (l : Lang) : [String] = match l with | Lang _ _ _ _ ps _ _ -> ps

@pub fun langKeeping (l : Lang) : Keeping = match l with | Lang _ _ _ _ _ k _ -> k

-- What a language asked for besides its tables: `In`, its readers again for
-- a program being written; `set`, a field written again.
@pub fun langWith (l : Lang) : [String] = match l with | Lang _ _ _ _ _ _ w -> w

-- Whether a language's programs are trees.
@pub fun isTreeLang (l : Lang) : Bool =
  match langKeeping l with
  | AsTrees _ _ _ -> True
  | AsTables -> False

-- A tree language's kinds of token, its trivia's, and its token fields'.
@pub fun treeTokens (l : Lang) : [String] =
  match langKeeping l with
  | AsTrees ts _ _ -> ts
  | AsTables -> []

@pub fun treeTrivia (l : Lang) : [String] =
  match langKeeping l with
  | AsTrees _ tv _ -> tv
  | AsTables -> []

@pub fun tokenFields (l : Lang) : [TokenField] =
  match langKeeping l with
  | AsTrees _ _ fs -> fs
  | AsTables -> []

@pub fun sortName (s : Sort) : String = match s with | Sort n _ -> n

@pub fun sortProds (s : Sort) : [Prod] = match s with | Sort _ ps -> ps

@pub fun prodName (p : Prod) : String = match p with | Prod n _ -> n

@pub fun prodFields (p : Prod) : [Field] = match p with | Prod _ fs -> fs

@pub fun fieldName (f : Field) : String = match f with | Field n _ _ _ -> n

@pub fun fieldTy (f : Field) : Ty = match f with | Field _ t _ _ -> t

@pub fun fieldAccessor (f : Field) : String = match f with | Field _ _ a _ -> a

@pub fun fieldIsToken (f : Field) : Bool = match f with | Field _ _ _ t -> t

-- The sort a production belongs to.
@pub fun sortOfProd (l : Lang) (p : String) : Maybe Sort =
  V.find (\s -> V.any (\q -> prodName q == p) (sortProds s)) (langSorts l)

@pub fun findSort (l : Lang) (n : String) : Maybe Sort =
  V.find (\s -> sortName s == n) (langSorts l)

-- --- what every node carries -------------------------------------------------

-- Where a node came from: the bytes of the source it was read from.
@derive(Debug, Display, PartialEq)
@pub data Meta = Meta Int Int

-- Where a syntax node is.
@pub fun metaOf (s : Syntax k) : Meta = match range s with | (a, b) -> Meta a b

-- A made-up node's: nowhere in particular.
@pub def noMeta : Meta = Meta 0 0

-- The bytes from `a` up to `b`.
@pub fun spanMeta (a : Int) (b : Int) : Meta = Meta a b

@pub fun metaStart (m : Meta) : Int = match m with | Meta a _ -> a

@pub fun metaEnd (m : Meta) : Int = match m with | Meta _ b -> b

-- --- what a language's tables stand on ---------------------------------------
--
-- Every language keeps its programs the same way, so what reads and writes
-- them is written once, here, and a language's own functions -- `coreExprLamBody`,
-- `newCoreExprLam` -- are a line each over these. A node is a row: its
-- production's tag, the bytes it came from, and where its fields start in the
-- slots. A field is one slot: a node's row, a number or a truth itself; for
-- a list or a `Maybe`, where its elements start in the slots, how many first;
-- for anything else, where it is in a column of its own type, which the
-- language keeps beside these.

-- A program's rows: each node's tag, where it starts and ends, and where its
-- fields start; and the slots.
@pub data LangTables
  = LangTables #[Int] #[Int] #[Int] #[Int] #[Int]

-- The same, being written.
@pub data LangWriting s
  = LangWriting (Buf s Int) (Buf s Int) (Buf s Int) (Buf s Int) (Buf s Int)

-- Empty rows, to write a program into.
@pub fun writing () : LangWriting s ! { St s | e } =
  LangWriting (B.buffer ()) (B.buffer ()) (B.buffer ()) (B.buffer ()) (B.buffer ())

-- What has been written, as a program's.
@pub fun frozen (w : LangWriting s) : LangTables ! { St s | e } =
  match w with
  | LangWriting ks ss es fs xs ->
      LangTables (B.freeze ks) (B.freeze ss) (B.freeze es) (B.freeze fs) (B.freeze xs)

-- Reading a program.

@pub fun tag (t : LangTables) (e : Int) : Int =
  match t with | LangTables ks _ _ _ _ -> arrayGet ks e

@pub fun startOf (t : LangTables) (e : Int) : Int =
  match t with | LangTables _ ss _ _ _ -> arrayGet ss e

@pub fun endOf (t : LangTables) (e : Int) : Int =
  match t with | LangTables _ _ es _ _ -> arrayGet es e

@pub fun metaAt (t : LangTables) (e : Int) : Meta =
  match t with
  | LangTables _ ss es _ _ -> Meta (arrayGet ss e) (arrayGet es e)

-- Field `i` of node `e`: its slot.
@pub fun slot (t : LangTables) (e : Int) (i : Int) : Int =
  match t with
  | LangTables _ _ _ fs xs -> arrayGet xs (arrayGet fs e + i)

-- The slots of the list that starts at slot `at`.
@pub fun listFrom (t : LangTables) (at : Int) : [Int] =
  match t with
  | LangTables _ _ _ _ xs -> V.map (\i -> arrayGet xs (at + 1 + i)) (V.range 0 (arrayGet xs at))

-- The slot of the `Maybe` that starts at slot `at`, if it has one.
@pub fun maybeFrom (t : LangTables) (at : Int) : Maybe Int =
  match t with
  | LangTables _ _ _ _ xs -> if arrayGet xs at == 0 then None else Just (arrayGet xs (at + 1))

-- Reading a program being written.

@pub fun tagIn (w : LangWriting s) (e : Int) : Int ! { St s | e } =
  match w with | LangWriting ks _ _ _ _ -> B.at ks e

@pub fun startIn (w : LangWriting s) (e : Int) : Int ! { St s | e } =
  match w with | LangWriting _ ss _ _ _ -> B.at ss e

@pub fun endIn (w : LangWriting s) (e : Int) : Int ! { St s | e } =
  match w with | LangWriting _ _ es _ _ -> B.at es e

@pub fun metaIn (w : LangWriting s) (e : Int) : Meta ! { St s | e } =
  match w with
  | LangWriting _ ss es _ _ -> Meta (B.at ss e) (B.at es e)

@pub fun slotIn (w : LangWriting s) (e : Int) (i : Int) : Int ! { St s | e } =
  match w with
  | LangWriting _ _ _ fs xs -> B.at xs (B.at fs e + i)

@pub fun listFromIn (w : LangWriting s) (at : Int) : [Int] ! { St s | e } =
  match w with
  | LangWriting _ _ _ _ xs -> V.map (\i -> B.at xs (at + 1 + i)) (V.range 0 (B.at xs at))

@pub fun maybeFromIn (w : LangWriting s) (at : Int) : Maybe Int ! { St s | e } =
  match w with
  | LangWriting _ _ _ _ xs -> if B.at xs at == 0 then None else Just (B.at xs (at + 1))

-- Writing one.

-- `xs` written into the slots, how many first: where they start. What a list
-- field -- or a `Maybe` one, a list of none or one -- holds.
@pub fun list (w : LangWriting s) (xs : [Int]) : Int ! { St s | e } =
  match w with
  | LangWriting _ _ _ _ slots ->
      let at = B.push slots (V.len xs) in
      let _ = V.foldl (\u x -> (let _ = B.push slots x in ())) () xs in
      at

-- Where the next node's fields will start.
@pub fun mark (w : LangWriting s) : Int ! { St s | e } =
  match w with | LangWriting _ _ _ _ xs -> B.len xs

-- The next field of the node being written.
@pub fun field (w : LangWriting s) (v : Int) : () ! { St s | e } =
  match w with
  | LangWriting _ _ _ _ xs -> (let _ = B.push xs v in ())

-- A node of production `k`, from byte `from` to `to`, whose fields start at
-- `first`: its row.
@pub fun node (w : LangWriting s) (k : Int) (from : Int) (to : Int) (first : Int)
    : Int ! { St s | e } =
  match w with
  | LangWriting ks ss es fs _ ->
      let _ = B.push ss from in
      let _ = B.push es to in
      let _ = B.push fs first in
      B.push ks k

-- A node and its fields at once, for the productions that have few: one call
-- where there would be one a field.
@pub fun node0 (w : LangWriting s) (k : Int) (from : Int) (to : Int) : Int ! { St s | e } =
  node w k from to (mark w)

@pub fun node1 (w : LangWriting s) (k : Int) (from : Int) (to : Int) (a : Int)
    : Int ! { St s | e } =
  match w with
  | LangWriting _ _ _ _ xs -> (let first = B.push xs a in node w k from to first)

@pub fun node2 (w : LangWriting s) (k : Int) (from : Int) (to : Int) (a : Int) (b : Int)
    : Int ! { St s | e } =
  match w with
  | LangWriting _ _ _ _ xs ->
      (let first = B.push xs a in
       let _ = B.push xs b in
       node w k from to first)

@pub fun node3 (w : LangWriting s) (k : Int) (from : Int) (to : Int) (a : Int) (b : Int) (c : Int)
    : Int ! { St s | e } =
  match w with
  | LangWriting _ _ _ _ xs ->
      (let first = B.push xs a in
       let _ = B.push xs b in
       let _ = B.push xs c in
       node w k from to first)

@pub fun node4 (w : LangWriting s) (k : Int) (from : Int) (to : Int) (a : Int) (b : Int) (c : Int)
    (d : Int)
    : Int ! { St s | e } =
  match w with
  | LangWriting _ _ _ _ xs ->
      (let first = B.push xs a in
       let _ = B.push xs b in
       let _ = B.push xs c in
       let _ = B.push xs d in
       node w k from to first)

-- Field `i` of node `e`, written again.
@pub fun setSlot (w : LangWriting s) (e : Int) (i : Int) (v : Int) : () ! { St s | e } =
  match w with
  | LangWriting _ _ _ fs xs -> B.put xs (B.at fs e + i) v

-- --- what a conversion from the typed AST stands on --------------------------

-- Every element converted, or `None` if any could not be.
@pub fun allOf (xs : [Maybe a]) : Maybe [a] =
  V.foldl
    (\acc x ->
      match (acc, x) with
      | (Just ys, Just y) -> Just (V.pushBack ys y)
      | _ -> None)
    (Just [])
    xs

-- An optional child converted: `Just None` when it is not there, `None` when
-- it is and could not be.
@pub fun optOf (f : a -> Maybe b) (x : Maybe a) : Maybe (Maybe b) =
  match x with
  | None -> Just None
  | Just y -> (match f y with | Just z -> Just (Just z) | None -> None)

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)

@test fun aLanguageSurvivesItsTripThroughADatum () =
  let l =
    Lang
      "Core"
      "File"
      [Sort "Expr" [Prod "Lit" [Field "value" (TPrim "String") "" False]]]
      "Core"
      ["s"]
      (AsTrees ["TokenInt"] ["TokenSpace"] [TokenField.TokenField "Lit" "value" ["TokenInt"]])
      ["In"]
  in assertEq (fromDatum (toDatum l)) (Ok l) "the same language back"

@test fun allOfIsNoneIfAnyIs () =
  let a = assertEq (allOf [Just 1, Just 2]) (Just [1, 2]) "all there" in
  assertEq (allOf [Just 1, None]) None "one missing"
