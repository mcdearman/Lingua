-- Running a program. Evaluation runs inside a query, so it is pure: a
-- recursive function is a closure that knows its own name, rather than a
-- cell tied into a knot.

use Lingua.Diagnostic (Diagnostic, errorAt)
use MiniML.Desugar
use MiniML.Desugar.Core.Expr as Expr
use Std.Exn (raise, toResult)
use Std.Collections.Vector as V
use Std.Collections.List as L
use Std.String as S

-- A value. A function holds its parameter's id and the environment it was
-- made in, binders by id; a recursive one binds its own id again each time it
-- is applied: no cell, and so nothing to mutate.
data Value
  = Int Int
  | Bool Bool
  | Closure Int CoreExpr (List (Int, Value))
  | Rec Int Int CoreExpr (List (Int, Value))

fun showValue v =
  match v with
  | Value.Int n -> S.fromInt n
  | Value.Bool b -> if b then "true" else "false"
  | _ -> "<function>"

-- The program's tables are `a`, and a node the row it is in them. Its
-- production and fields are matched as if they were a constructor's: each
-- `Expr.…` pattern is a synonym `lang!` made, in the module of `Core`'s
-- `Expr` sort, which reads the node's kind and the fields the arm binds from
-- the tables -- nothing is built to match on.
fun eval (a : CoreArena) env (e : CoreExpr) =
  match (a, e) with
  | Expr.Int n -> Value.Int n
  | Expr.Bool b -> Value.Bool b
  | Expr.Var id ->
      (match L.lookupAssoc id env with
       | Just v -> v
       | None -> raise (errorAt (Expr.meta a e) "binder ${show id} has no value"))
  | Expr.Lam param body -> Value.Closure param body env
  | Expr.App func arg -> apply a (Expr.meta a e) (eval a env func) (eval a env arg)
  | Expr.Let id value body -> eval a ((id, eval a env value) :: env) body
  | Expr.LetRec id param value body -> eval a ((id, Value.Rec id param value env) :: env) body
  | Expr.If cond yes no ->
      (match eval a env cond with
       | Value.Bool True -> eval a env yes
       | _ -> eval a env no)
  | Expr.Prim op args -> operate a env e op args

fun operate a env e op args =
  match (V.get args 0, V.get args 1) with
  | (Just x, Just y) -> primitive (Expr.meta a e) op (eval a env x) (eval a env y)
  | _ -> raise (errorAt (Expr.meta a e) "`${op}` wants two operands")

fun apply a at f x =
  match f with
  | Value.Closure p body env -> eval a ((p, x) :: env) body
  | Value.Rec name p body env -> eval a ((p, x) :: (name, f) :: env) body
  | other -> raise (errorAt at "not a function: ${showValue other}")

fun primitive at op l r =
  match (l, r) with
  | (Value.Int a, Value.Int b) ->
      if op == "+" then Value.Int (a + b)
      else if op == "-" then Value.Int (a - b)
      else if op == "*" then Value.Int (a * b)
      else if op == "/" then
        (if b == 0 then raise (errorAt at "division by zero") else Value.Int (a / b))
      else if op == "==" then Value.Bool (a == b)
      else if op == "<" then Value.Bool (a < b)
      else if op == ">" then Value.Bool (a > b)
      else if op == "<=" then Value.Bool (a <= b)
      else Value.Bool (a >= b)
  | _ -> raise (errorAt at "`${op}` wants numbers")

-- What a program evaluates to, or what went wrong running it, where.
@pub fun run (p : CoreProgram) : Result Diagnostic String =
  toResult (\() -> showValue (eval (coreArena p) [;] (programExpr p)))

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)
use Std.Result.Result.*
use MiniML.Compiler (runSource)

@test fun evaluatesArithmetic () =
  assertEq
    (V.map runSource ["1 + 2 * 3", "(1 + 2) * 3", "7 / 2", "1 < 2"])
    [Ok "7", Ok "9", Ok "3", Ok "true"]
    "arithmetic"

@test fun evaluatesClosures () =
  assertEq
    (runSource "let add = fun x y -> x + y in let inc = add 1 in inc 41")
    (Ok "42")
    "partial application captures"

@test fun evaluatesRecursion () =
  assertEq
    (runSource "let rec fact n = if n < 2 then 1 else n * fact (n - 1) in fact 10")
    (Ok "3628800")
    "factorial"

@test fun shadowingSeesTheOldBinding () =
  assertEq (runSource "let x = 1 in let x = x + 1 in x") (Ok "2") "shadowing"

@test fun divisionByZeroIsCaught () =
  assertEq (runSource "1 / 0") (Err "division by zero") "a run-time error, not a crash"
