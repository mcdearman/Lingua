-- Lingua.Pipe: what Lingua's macros read their calls with, besides
-- `Std.String.Parse`.
--
-- A macro's parser is written as what it reads, in order, with that module's
-- `keep` and `skip`:
--
--   def setting : Parser Tokens ((String, Loc), String) =
--     P.pure (\k v -> (k, v))
--       |> skip (punct "|")
--       |> keep named
--       |> skip (punct "=")
--       |> keep (P.alt stringLit ident)
--
-- the function of what it reads, and then each thing: kept, when the function
-- takes it next, or skipped, when it is only there to be read. It reads down
-- the page in the order the input is read, with a `bind` only where what is
-- read next depends on what was read before.

use Std.String.Parse as P
use Std.String.Parse (Parser)
use Std.Macro (TokenTree, Loc)
use Std.Macro.TokenTree.*
use Std.Macro.Parse (Tokens)

-- A name among a macro's tokens, and where it was written: what an error
-- about it points at.
@pub def named : Parser Tokens (String, Loc) =
  P.label "a name" (P.token (\t -> match t with | Word w at -> Just (w, at) | _ -> None) [])
