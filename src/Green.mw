-- The green tree: what a file says, every byte of it, and nothing about where
-- the file is.
--
-- A tree is a text and a handful of tables, one slot per node or token, in
-- the order they are met reading down and left to right: its kind, where it
-- starts and ends in the text, how many slots its subtree takes -- 0 for a
-- token -- and the slot of its parent. The first slot is the root, and a
-- node's children follow it, each after the whole subtree of the one before.
-- A token is a kind and a range of the text, so the tokens, in order, are the
-- file: whitespace and comments included.
--
-- Nothing in it is counted but the tables themselves. A tree of a hundred
-- thousand tokens is six blocks, not a hundred thousand, so passing one around
-- or dropping it costs what one value does -- where a node or token a block
-- each is a count moved at every step of every walk, and a block freed at the
-- end.
--
-- Positions are the tree's own: a tree starts at 0, whatever file it came
-- from. `subtree` copies a node out as a tree of its own, with its text, so
-- that the same declaration read from two versions of a file is the same
-- value however far it moved -- what lets a query that read it cut off. Where
-- a node is in the file is the red view's business (`Lingua.Red`).
--
-- A tree parsed from tokens rather than text -- what a macro wrote, parsed
-- where it was called -- has a text all the same, its tokens' one after
-- another, but a token's place in it is not where the token stands: a token
-- a macro's template wrote stands where the call is, and so do all its
-- others. So a slot may also have an **origin**, the bytes it stands for,
-- kept in two more tables: -1, or no tables at all, for a slot that stands
-- where it is. A node's origin runs from its first token's to its last's --
-- tokens with one, trivia never -- as a parser's spans do.
--
-- `k` is the language's kind type, written by `syntax!`.

use Std.Collections.Vector as V
use Std.String as S

use Green.*

@derive(Debug, PartialEq)
@pub data Green k = Green String #[k] #[Int] #[Int] #[Int] #[Int] #[Int] #[Int]

-- A tree from its tables, as `Lingua.Build` writes them: the text, and for
-- each slot its kind, start, end, subtree size (0 for a token) and parent (-1
-- for the root).
@pub fun fromTables (text : String) (kinds : #[k]) (starts : #[Int])
    (ends : #[Int]) (sizes : #[Int]) (parents : #[Int]) : Green k =
  Green text kinds starts ends sizes parents #[] #[]

-- The same, with each slot's origin: where it stands, or -1 where it is. Each
-- node's is worked out from its tokens'.
@pub fun fromTablesAt (text : String) (kinds : #[k]) (starts : #[Int])
    (ends : #[Int]) (sizes : #[Int]) (parents : #[Int]) (froms : #[Int])
    (tos : #[Int]) : Green k =
  settled (Green text kinds starts ends sizes parents froms tos)

-- A token of kind `k` whose text is `text`.
@pub fun token (k : k) (text : String) : Green k =
  Green text #[k] #[0] #[stringByteLength text] #[0] #[0 - 1] #[] #[]

-- The same, standing for bytes `from` to `to` of somewhere else.
@pub fun tokenFrom (k : k) (text : String) (from : Int) (to : Int) : Green k =
  Green text #[k] #[0] #[stringByteLength text] #[0] #[0 - 1] #[from] #[to]

-- A node of kind `k` over `children`, in order: a copy of each, one after the
-- other. What a test writes a tree with, and a pass the nodes it builds; a
-- parse builds the tables directly.
@pub fun node (k : k) (children : [Green k]) : Green k =
  let root = Green "" #[k] #[0] #[0] #[1] #[0 - 1] #[] #[] in
  match V.foldl graft root children with
  | Green t ks ss es zs ps os oe ->
      let whole =
        Green
          t
          ks
          (arraySet ss 0 0)
          (arraySet es 0 (stringByteLength t))
          (arraySet zs 0 (arrayLen ks))
          ps
          os
          oe
      in
      if arrayLen os == 0 then whole else settledAt whole 0

-- `c`'s slots after `g`'s, `c`'s root a child of `g`'s.
fun graft (g : Green k) (c : Green k) : Green k =
  match (g, c) with
  | (Green t ks ss es zs ps os oe, Green ct cks css ces czs cps cos coe) ->
      let off = stringByteLength t in
      let base = arrayLen ks in
      let placed = arrayLen os > 0 or arrayLen cos > 0 in
      Green
        (t ++ ct)
        (arrayConcat ks cks)
        (arrayConcat ss (shifted off css))
        (arrayConcat es (shifted off ces))
        (arrayConcat zs czs)
        (arrayConcat
          ps
          (V.toArray
            (V.map (\p -> if p < 0 then 0 else p + base) (V.fromArray cps))))
        (if placed
          then arrayConcat (origins os base) (origins cos (arrayLen cks))
          else #[])
        (if placed
          then arrayConcat (origins oe base) (origins coe (arrayLen cks))
          else #[])

fun shifted (by : Int) (xs : #[Int]) : #[Int] =
  V.toArray (V.map (\x -> x + by) (V.fromArray xs))

-- An origin table for `n` slots: `xs`, or one saying each is where it is.
fun origins (xs : #[Int]) (n : Int) : #[Int] =
  if arrayLen xs == 0 then V.toArray (V.replicate n (0 - 1)) else xs

-- The same tree, each kind as `f` says: what a pass from one language's trees
-- to another's makes of what it keeps.
@pub fun mapKinds (f : k -> j) (g : Green k) : Green j =
  match g with
  | Green t ks ss es zs ps os oe ->
      Green t (V.toArray (V.map f (V.fromArray ks))) ss es zs ps os oe

-- Every node's origin, from its tokens'.
fun settled (g : Green k) : Green k =
  match g with
  | Green _ _ _ _ _ _ os _ ->
      (if arrayLen os == 0
        then g
        else
          V.foldl
          (\h i -> if isTokenAt h i then h else settledAt h i)
          g
          (V.range 0 (slots g)))

-- Node `i`'s origin: its first placed token's start to its last's end.
fun settledAt (g : Green k) (i : Int) : Green k =
  match g with
  | Green t ks ss es zs ps os oe ->
      let placed =
        V.filter
          (\j -> isTokenAt g j and arrayGet os j >= 0)
          (V.range (i + 1) (after g i))
      in
      (match (V.get placed 0, V.get placed (V.len placed - 1)) with
       | (Just a, Just b) ->
           Green
             t
             ks
             ss
             es
             zs
             ps
             (arraySet os i (arrayGet os a))
             (arraySet oe i (arrayGet oe b))
       | _ -> g)

-- --- a slot ------------------------------------------------------------------

-- How many slots the tree has.
@pub fun slots (g : Green k) : Int =
  match g with | Green _ ks _ _ _ _ _ _ -> arrayLen ks

@pub fun kindAt (g : Green k) (i : Int) : k =
  match g with | Green _ ks _ _ _ _ _ _ -> arrayGet ks i

-- Where slot `i` is in the tree's text.
@pub fun startAt (g : Green k) (i : Int) : Int =
  match g with | Green _ _ ss _ _ _ _ _ -> arrayGet ss i

@pub fun endAt (g : Green k) (i : Int) : Int =
  match g with | Green _ _ _ es _ _ _ _ -> arrayGet es i

-- Where slot `i` stands: its origin, or where it is.
@pub fun fromAt (g : Green k) (i : Int) : Int =
  match g with
  | Green _ _ ss _ _ _ os _ ->
      (if arrayLen os == 0
        then arrayGet ss i
        else (let o = arrayGet os i in if o < 0 then arrayGet ss i else o))

@pub fun toAt (g : Green k) (i : Int) : Int =
  match g with
  | Green _ _ _ es _ _ os oe ->
      (if arrayLen os == 0
        then arrayGet es i
        else (if arrayGet os i < 0 then arrayGet es i else arrayGet oe i))

-- Whether slot `i` stands somewhere other than where it is.
@pub fun isPlacedAt (g : Green k) (i : Int) : Bool =
  match g with
  | Green _ _ _ _ _ _ os _ -> arrayLen os > 0 and arrayGet os i >= 0

@pub fun isTokenAt (g : Green k) (i : Int) : Bool =
  match g with | Green _ _ _ _ zs _ _ _ -> arrayGet zs i == 0

-- The slot of `i`'s parent; -1 for the root.
@pub fun parentAt (g : Green k) (i : Int) : Int =
  match g with | Green _ _ _ _ _ ps _ _ -> arrayGet ps i

-- The slot after `i`'s subtree: its next sibling, if it has one.
@pub fun after (g : Green k) (i : Int) : Int =
  match g with
  | Green _ _ _ _ zs _ _ _ ->
      (let z = arrayGet zs i in if z == 0 then i + 1 else i + z)

-- The slot of `i`'s first child; -1 if it has none.
@pub fun firstChild (g : Green k) (i : Int) : Int =
  if i + 1 < after g i then i + 1 else 0 - 1

-- The slot of the child of `p` after its child `c`; -1 if `c` is the last.
@pub fun nextSibling (g : Green k) (p : Int) (c : Int) : Int =
  let n = after g c in
  if n < after g p then n else 0 - 1

-- The slots of `i`'s children, in order.
@pub fun childSlots (g : Green k) (i : Int) : [Int] =
  let stop = after g i in
  let rec go c acc =
    if c >= stop then acc else go (after g c) (V.pushBack acc c)
  in
  go (i + 1) []

-- The text of slot `i`.
@pub fun textAt (g : Green k) (i : Int) : String =
  match g with
  | Green t _ ss es _ _ _ _ -> stringSlice t (arrayGet ss i) (arrayGet es i)

-- Slot `i`'s subtree as a tree of its own: its text, and its slots, starting
-- from 0.
@pub fun subtree (g : Green k) (i : Int) : Green k =
  match g with
  | Green t ks ss es zs ps os oe ->
      let stop = after g i in
      let from = arrayGet ss i in
      let cut = \xs -> arraySlice xs i stop in
      Green
        (stringSlice t from (arrayGet es i))
        (cut ks)
        (shifted (0 - from) (cut ss))
        (shifted (0 - from) (cut es))
        (cut zs)
        (arraySet (shifted (0 - i) (cut ps)) 0 (0 - 1))
        (if arrayLen os == 0 then #[] else cut os)
        (if arrayLen oe == 0 then #[] else cut oe)

-- --- the whole tree ----------------------------------------------------------

@pub fun kind (g : Green k) : k = kindAt g 0

-- How many bytes of the file it covers.
@pub fun width (g : Green k) : Int =
  match g with | Green t _ _ _ _ _ _ _ -> stringByteLength t

-- Its children, each a tree of its own; a token has none.
@pub fun children (g : Green k) : [Green k] = V.map (subtree g) (childSlots g 0)

@pub fun isToken (g : Green k) : Bool = isTokenAt g 0

-- Every token under it, in order, each a tree of its own.
@pub fun tokens (g : Green k) : [Green k] =
  V.map (subtree g) (V.filter (isTokenAt g) (V.range 0 (slots g)))

-- The text it covers. For the root, the file.
@pub fun text (g : Green k) : String = match g with | Green t _ _ _ _ _ _ _ -> t

-- The tree drawn one line per node or token, indented by depth: what a test
-- compares a parse against.
@pub fun dump (show : k -> String) (g : Green k) : String =
  S.join "\n" (dumpLines show g 0 0)

fun dumpLines show g (i : Int) (depth : Int) =
  let pad = S.join "" (V.replicate depth "  ") in
  if isTokenAt g i then [pad ++ show (kindAt g i) ++ " " ++ debug (textAt g i)]
  else
    V.pushFront
      (V.concatMap (\c -> dumpLines show g c (depth + 1)) (childSlots g i))
      (pad ++ show (kindAt g i))

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)

@test fun aNodeIsAsWideAsItsChildren () =
  let g = node "Sum" [token "Num" "12", token "Space" " ", token "Plus" "+"] in
  let a = assertEq (width g) 4 "two, one and one" in
  assertEq (text g) "12 +" "its text is its tokens'"

@test fun aTreeIsDrawnByDepth () =
  let g = node "Sum" [token "Num" "1", node "Rest" [token "Plus" "+"]] in
  assertEq
    (dump (\k -> k) g)
    "Sum\n  Num \"1\"\n  Rest\n    Plus \"+\""
    "one line each"

@test fun aPlacedNodeStandsWhereItsTokensDo () =
  let g =
    node
      "Sum"
      [
        tokenFrom "Num" "1" 40 41,
        token "Space" " ",
        tokenFrom "Plus" "+" 10 20,
        token "Space" " ",
        tokenFrom "Num" "2" 12 13
      ]
  in
  let a = assertEq (text g) "1 + 2" "its text is its tokens'" in
  let b =
    assertEq
      (fromAt g 0, toAt g 0)
      (40, 13)
      "from its first token's start to its last's end"
  in
  let c = assertEq (fromAt g 2, toAt g 2) (1, 2) "trivia is where it is" in
  assertEq
    (fromAt (subtree g 3) 0, toAt (subtree g 3) 0)
    (10, 20)
    "and a token stands where it did, copied out"

@test fun aTreeOfTextStandsWhereItIs () =
  let g = node "Sum" [token "Num" "12", token "Plus" "+"] in
  assertEq
    (V.map (\i -> (fromAt g i, toAt g i, isPlacedAt g i)) (V.range 0 (slots g)))
    [(0, 3, False), (0, 2, False), (2, 3, False)]
    "its origins are its places"

@test fun aSubtreeIsTheSameWhereverItWas () =
  let rest = node "Rest" [token "Plus" "+", token "Num" "2"] in
  let near = node "Sum" [token "Num" "1", rest] in
  let far = node "Sum" [token "Num" "100", token "Space" "  ", rest] in
  let a = assertEq (V.getOr near (children near) 1) rest "copied out of one" in
  assertEq
    (V.getOr far (children far) 2)
    (V.getOr near (children near) 1)
    "and equal to the one further along"
