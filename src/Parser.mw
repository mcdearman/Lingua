-- The parser's runtime: what a generated parser reads tokens and says what it
-- saw with.
--
-- After matklad's "Resilient LL Parsing Tutorial". A parser never builds a
-- tree. It looks at the kinds of the tokens that are not trivia and emits a
-- flat list of events -- a node opens, a token is taken, a node closes, and
-- here is what was wrong -- which `Lingua.Build` turns into a green tree with
-- every token of the file in it. Because a node is a placeholder until it is
-- closed, what it is can be decided after it is read, and `openBefore` can
-- wrap a node already closed in a new one: how `a + b` takes the `a` it has
-- already read as its left side.
--
-- Wrapping moves nothing. The new node's `Open` goes at the end, and the one
-- it wraps is told where it is -- its *forward parent*, as rust-analyzer's
-- parser has it -- so that `openBefore` is a write, not a copy of every
-- event before it; `events` lays each chain of them out in order when the
-- parse is done.
--
-- `nth` burns fuel and progress refills it: a loop that stops moving is
-- stopped, reported as an error in the tree, and ends at the end of the input
-- rather than never. Progress is taking a token, or closing a node out to a
-- depth not reached since the last one was taken -- so that unwinding a
-- thousand nested rules at the end of the input, each looking once more at
-- what comes next, is not taken for a loop, and opening and closing nodes on
-- the spot still is.
--
-- Its state lives in `Std.St` cells, so a parse is run under `runSt` and is,
-- from outside, a pure function of the tokens: what a cached query needs.
-- What it says goes into tables (`Lingua.Buf`) -- a number, a kind and a
-- number per event -- rather than a list of events a block each, and comes
-- out as tables too (`Events`), for `Lingua.Build` to read slot by slot.

use Std.Collections.Vector as V
use Lingua.Buf as B
use Lingua.Buf (Buf)

use Event.*
use Events.*
use Parser.*

-- An event, one at a time: what a test compares a parse against. A parse
-- itself keeps its events as `Events`.
@pub data Event k = Open k | Close | Advance | Error String

-- Everything a parse said, in order, as tables: what each event is -- one of
-- the numbers below -- the kind of each `Open`, and for each `Error` which of
-- the messages it said. A parse of a hundred thousand tokens is four blocks,
-- not a block an event.
@pub data Events k = Events #[Int] #[k] #[Int] #[String]

def opOpen : Int = 0

def opClose : Int = 1

def opAdvance : Int = 2

def opError : Int = 3

-- How many events there are.
@pub fun eventCount (es : Events k) : Int = match es with | Events ops _ _ _ -> arrayLen ops

-- Event `i`, as an `Event`.
@pub fun eventAt (es : Events k) (i : Int) : Event k =
  match es with
  | Events ops ks args msgs ->
      let op = arrayGet ops i in
      if op == opOpen then Open (arrayGet ks i)
      else if op == opClose then Close
      else if op == opAdvance then Advance
      else Error (arrayGet msgs (arrayGet args i))

-- Whether event `i` opens a node, closes one, takes a token or says what is
-- wrong -- without making an `Event` to ask.
@pub fun isOpenAt (es : Events k) (i : Int) : Bool =
  match es with | Events ops _ _ _ -> arrayGet ops i == opOpen

@pub fun isCloseAt (es : Events k) (i : Int) : Bool =
  match es with
  | Events ops _ _ _ -> arrayGet ops i == opClose

@pub fun isAdvanceAt (es : Events k) (i : Int) : Bool =
  match es with
  | Events ops _ _ _ -> arrayGet ops i == opAdvance

-- The kind an `Open` at `i` opens.
@pub fun openKindAt (es : Events k) (i : Int) : k = match es with | Events _ ks _ _ -> arrayGet ks i

-- The message an `Error` at `i` says.
@pub fun messageAt (es : Events k) (i : Int) : String =
  match es with
  | Events _ _ args msgs -> arrayGet msgs (arrayGet args i)

-- Every event, in order.
@pub fun eventList (es : Events k) : [Event k] = V.map (eventAt es) (V.range 0 (eventCount es))

-- The kinds of the tokens to read; where it is and its fuel; what it has said
-- -- each event's number, its kind, its forward parent or message, and the
-- messages; the kinds that stand for the end of the input and for a node of
-- errors; how a kind is named in a message; and how many nodes are open, with
-- the fewest there have been since the last token was taken.
@pub data Parser s k
  = Parser
    #[k]
    (StRef s Int)
    (StRef s Int)
    (Buf s Int)
    (Buf s k)
    (Buf s Int)
    (Buf s String)
    k
    k
    (k -> String)
    (StRef s Int)
    (StRef s Int)

def fuelMax : Int = 256

-- A parser over tokens of these kinds.
@pub fun parser (kinds : #[k]) (eof : k) (errorKind : k) (name : k -> String)
    : Parser s k ! { St s | e } =
  Parser
    kinds
    (stNewRef 0)
    (stNewRef fuelMax)
    (B.buffer ())
    (B.buffer ())
    (B.buffer ())
    (B.buffer ())
    eof
    errorKind
    name
    (stNewRef 0)
    (stNewRef 0)

-- The kind `n` tokens ahead; past the end, the end-of-input kind.
@pub fun nth (p : Parser s k) (n : Int) : k ! { St s | e } =
  match p with
  | Parser ks pos fuel _ _ _ _ eofK _ _ _ _ ->
      let f = stGetRef fuel in
      if f <= 0 then
        -- Stuck: said once, and from then on the input has ended, so every
        -- loop waiting for something else stops.
        let said =
          if f == 0 then (let u = stSetRef fuel (0 - 1) in error p "the parser is stuck here")
          else ()
        in eofK
      else
        let u = stSetRef fuel (f - 1) in
        let i = stGetRef pos + n in
        if i < arrayLen ks then arrayGet ks i else eofK

@pub fun at (p : Parser s k) (k : k) : Bool ! { St s | e } = nth p 0 == k

@pub fun atAny (p : Parser s k) (ks : [k]) : Bool ! { St s | e } = V.elem (nth p 0) ks

-- Whether every token has been read.
@pub fun atEnd (p : Parser s k) : Bool ! { St s | e } =
  match p with
  | Parser ks pos _ _ _ _ _ _ _ _ _ _ -> stGetRef pos >= arrayLen ks

-- Open a node whose kind is not known yet; its mark.
@pub fun open (p : Parser s k) : Int ! { St s | e } =
  match p with
  | Parser _ _ _ _ _ _ _ _ errK _ _ _ ->
      let m = emit p opOpen errK 0 in
      let v = deeper p 1 in
      m

-- Close the node opened at `m`, as a `k`; its mark, for `openBefore`.
@pub fun close (p : Parser s k) (m : Int) (k : k) : Int ! { St s | e } =
  match p with
  | Parser _ _ _ _ kinds _ _ errK _ _ _ _ ->
      let u = B.put kinds m k in
      let v = emit p opClose errK 0 in
      let w = deeper p (0 - 1) in
      m

-- Open a node before the one closed at `m`, so that it holds it; the new
-- node's mark. Its `Open` goes at the end, and `m`'s is pointed at it.
@pub fun openBefore (p : Parser s k) (m : Int) : Int ! { St s | e } =
  match p with
  | Parser _ _ _ ops _ args _ _ errK _ _ _ ->
      let at = B.len ops in
      let u = if B.at ops m == opOpen then B.put args m (at - m) else () in
      let n = emit p opOpen errK 0 in
      let v = deeper p 1 in
      n

-- Take the next token.
@pub fun advance (p : Parser s k) : () ! { St s | e } =
  match p with
  | Parser _ pos _ _ _ _ _ _ errK _ depth fewest ->
      let u = emit p opAdvance errK 0 in
      let v = stSetRef pos (stGetRef pos + 1) in
      let w = stSetRef fewest (stGetRef depth) in
      refill p

-- Take the next token if it is a `k`.
@pub fun eat (p : Parser s k) (k : k) : Bool ! { St s | e } =
  if at p k then (let u = advance p in True) else False

-- Take a `k`, or say one was expected and take nothing.
@pub fun expect (p : Parser s k) (k : k) : () ! { St s | e } =
  if eat p k then ()
  else
    match p with
    | Parser _ _ _ _ _ _ _ _ _ name _ _ -> error p "expected ${name k}"

-- Say what is wrong here, taking nothing.
@pub fun error (p : Parser s k) (msg : String) : () ! { St s | e } =
  match p with
  | Parser _ _ _ _ _ _ msgs _ errK _ _ _ ->
      let i = B.push msgs msg in
      let _ = emit p opError errK i in
      ()

-- Take the next token into a node of errors, saying what is wrong with it.
@pub fun advanceWithError (p : Parser s k) (msg : String) : () ! { St s | e } =
  match p with
  | Parser _ _ _ _ _ _ _ _ errK _ _ _ ->
      let m = open p in
      let u = error p msg in
      let v = advance p in
      let w = close p m errK in
      ()

-- Everything it said, each node's `Open` in its place: a chain of forward
-- parents opened where its first node was, the outermost first.
@pub fun events (p : Parser s k) : Events k ! { St s | e } =
  match p with
  | Parser _ _ _ ops kinds args msgs errK _ _ _ _ ->
      let n = B.len ops in
      -- Which `Open`s some chain takes in: marked in place, in one pass.
      let absorbed = stNewArray n False in
      let _ = mark ops args absorbed 0 n in
      let outOps = stNewArray n 0 in
      let outKinds = stNewArray n errK in
      let outArgs = stNewArray n 0 in
      let _ = lay ops kinds args absorbed outOps outKinds outArgs 0 0 n in
      Events (stFreeze outOps) (stFreeze outKinds) (stFreeze outArgs) (B.freeze msgs)

fun mark ops args absorbed (i : Int) (n : Int) =
  if i >= n then ()
  else
    let fp = if B.at ops i == opOpen then B.at args i else 0 in
    let _ = if fp > 0 then stSetArray absorbed (i + fp) True else () in
    mark ops args absorbed (i + 1) n

-- Event `i` on, written from slot `o` on: an `Open` some chain took in is
-- written with that chain, and one that starts a chain writes all of it.
fun lay ops kinds args absorbed outOps outKinds outArgs (i : Int) (o : Int) (n : Int) =
  if i >= n then ()
  else if stGetArray absorbed i then lay ops kinds args absorbed outOps outKinds outArgs (i + 1) o n
  else
    let op = B.at ops i in
    if op == opOpen then
      let len = chainLength ops args i 1 in
      let _ = layChain ops kinds args outOps outKinds i (o + len - 1) in
      lay ops kinds args absorbed outOps outKinds outArgs (i + 1) (o + len) n
    else
      let _ = stSetArray outOps o op in
      let _ = stSetArray outArgs o (B.at args i) in
      lay ops kinds args absorbed outOps outKinds outArgs (i + 1) (o + 1) n

-- How many `Open`s the chain of forward parents from `i` has.
fun chainLength ops args (i : Int) (len : Int) =
  let fp = B.at args i in
  if fp > 0 then chainLength ops args (i + fp) (len + 1) else len

-- The chain from `i`, innermost at `o` and each wrapper before it: the
-- outermost first, as they open.
fun layChain ops kinds args outOps outKinds (i : Int) (o : Int) =
  let _ = stSetArray outOps o opOpen in
  let _ = stSetArray outKinds o (B.at kinds i) in
  let fp = B.at args i in
  if fp > 0 then layChain ops kinds args outOps outKinds (i + fp) (o - 1) else ()

-- `by` more nodes open, or fewer; closing out past the fewest there have been
-- since the last token is progress.
fun deeper p (by : Int) =
  match p with
  | Parser _ _ _ _ _ _ _ _ _ _ depth fewest ->
      let now = stGetRef depth + by in
      let _ = stSetRef depth now in
      if now < stGetRef fewest then (let u = stSetRef fewest now in refill p) else ()

-- Full fuel again -- unless the parser was already stopped.
fun refill p =
  match p with
  | Parser _ _ fuel _ _ _ _ _ _ _ _ _ -> if stGetRef fuel >= 0 then stSetRef fuel fuelMax else ()

-- One more event; its index.
fun emit p (op : Int) k (arg : Int) =
  match p with
  | Parser _ _ _ ops kinds args _ _ _ _ _ _ ->
      let i = B.push ops op in
      let _ = B.push kinds k in
      let _ = B.push args arg in
      i

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)

-- `1 + 2` as a sum: the `1` read first, then wrapped once the `+` is seen.
@test fun aNodeClosedCanBeWrappedInAnother () =
  let said =
    runSt (\() ->
      let p = parser #["num", "+", "num"] "eof" "error" (\k -> k) in
      let root = open p in
      let lit = open p in
      let a = advance p in
      let lhs = close p lit "Lit" in
      let sum = openBefore p lhs in
      let b = advance p in
      let c = expect p "num" in
      let d = close p sum "Sum" in
      let e = close p root "File" in
      eventList (events p))
  in assertEq
       said
       [Open "File", Open "Sum", Open "Lit", Advance, Close, Advance, Advance, Close, Close]
       "the sum holds the literal"

@test fun whatIsMissingIsSaidAndNothingIsTaken () =
  let said =
    runSt (\() ->
      let p = parser #["+"] "eof" "error" (\k -> "`${k}`") in
      let a = expect p "num" in
      eventList (events p))
  in assertEq said [Error "expected `num`"] "an error, and the `+` still there"

@test fun aLoopThatStopsMovingIsStopped () =
  let said =
    runSt (\() ->
      let p = parser #["x"] "eof" "error" (\k -> k) in
      let rec spin n = if at p "eof" then n else spin (n + 1) in
      let n = spin 0 in
      eventList (events p))
  in assertEq (V.last said) (Just (Error "the parser is stuck here")) "stuck, said, and over"

@test fun openingAndClosingOnTheSpotIsStuckToo () =
  let said =
    runSt (\() ->
      let p = parser #["x"] "eof" "error" (\k -> k) in
      let rec spin n =
        if at p "eof" then n
        else
          (let m = open p in
           let c = close p m "node" in
           spin (n + 1))
      in
      let n = spin 0 in
      eventList (events p))
  in assertEq (V.last said) (Just (Error "the parser is stuck here")) "no deeper, and no further"

@test fun unwindingDeepNestingAtTheEndIsNotStuck () =
  let said =
    runSt (\() ->
      let p = parser #["x"] "eof" "error" (\k -> k) in
      let rec down n =
        if n == 0 then (let a = advance p in ())
        else
          (let m = open p in
           let u = down (n - 1) in
           let peek = V.map (\i -> nth p 0) (V.range 0 10) in
           let c = close p m "node" in
           ())
      in
      let u = down 1000 in
      eventList (events p))
  in assertEq
       (V.any
          (\e ->
            match e with
            | Error m -> m == "the parser is stuck here"
            | _ -> False)
          said)
       False
       "a thousand levels, each looking ten times"
