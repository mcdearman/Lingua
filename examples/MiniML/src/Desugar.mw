-- The language inference and evaluation read, `Core`, and the pass from
-- `Resolved` to it -- declared as what changes (`lang!`), and the pass as only
-- its cases (`pass!`). Every name is an id by now (`Names`).

use Lingua (lang!, pass!)
use Lingua.Diagnostic (errorAt, withNote, say)
use Lingua.Lang (Meta)
use MiniML.Syntax
use MiniML.Names
use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe as M

-- The one inference and evaluation read: every function takes one argument,
-- an operator is a primitive, and a literal is its value. A variable, a
-- parameter and what a `let` binds are ids.
@pub(pkg) lang! {
  pub Core extends Resolved with In, modules
  Expr - Atom
  Expr - App
  Expr - Bin
  Expr - Lam
  Expr - Let
  Expr + Int { value : Int }
  Expr + Bool { value : Bool }
  Expr + Var { id : Int }
  Expr + App { func : Expr, arg : Expr }
  Expr + Prim { op : String, args : [Expr] }
  Expr + Lam { param : Int, body : Expr }
  Expr + Let { id : Int, value : Expr, body : Expr }
  Expr + LetRec { id : Int, param : Int, value : Expr, body : Expr }
}

-- `fun x y -> e` is `fun x -> fun y -> e`, and `let f x = e` binds
-- `fun x -> e`;
-- `let rec f x y = e` is recursive in `f`, taking `x`. `if` is copied. A
-- `let rec` with nothing to take is reported where it is -- `here` -- and
-- read as a `let`, so the rest of the program is still checked.
pass! {
  pub desugar : Resolved -> Core
    | Atom { atom } -> atomExpr out atom
    | App { func, arg } -> App { func = func, arg = atomExpr out arg }
    | Bin { lhs, op, rhs } -> Prim { op = op, args = [lhs, rhs] }
    | Lam { params, body } -> lambdas out here params body
    | Let { recursive, id, params, value, body } ->
        (match (recursive, V.get params 0) with
         | (True, Just first) ->
             LetRec
               {
                 id = id,
                 param = first,
                 value = lambdas out here (V.drop params 1) value,
                 body = body
               }
         | (True, None) ->
             (let u =
               say
                 (errorAt here "`let rec` needs an argument"
                   |> withNote "a recursive value that is not a function has nothing to stand on: write `let rec f x = …`")
in
               Let { id = id, value = value, body = body })
  | _ ->
      Let
               { id = id, value = lambdas out here params value, body = body })
}

-- `fun` of each of `params` in turn, around `body`: each where the node
-- that took them was, `at`, and written into `out`.
fun lambdas out (at : Meta) (params : [Int]) (body : CoreExpr) =
  V.foldr (\p acc -> newCoreExprLam out at p acc) body params

-- An atom, as the expression it is: read off the atom `out` has just been
-- given, and written after it.
fun atomExpr out (a : CoreAtom) =
  let s = coreStartIn out a in
  let e = coreEndIn out a in
  match kindCoreAtomIn out a with
  | CoreAtomKind.Literal ->
      newCoreExprIntSpan
        out
        s
        e
        (M.unwrapOr 0 (S.toInt (coreAtomLiteralNumberIn out a)))
  | CoreAtomKind.BoolLit ->
      newCoreExprBoolSpan out s e (coreAtomBoolLitValueIn out a == "true")
  | CoreAtomKind.NameRef ->
      newCoreExprVarSpan out s e (coreAtomNameRefIdIn out a)
  | CoreAtomKind.Paren -> coreAtomParenExprIn out a

-- The expression a program is.
@pub fun programExpr (p : CoreProgram) : CoreExpr =
  coreFileExpr (coreArena p) (coreRoot p)
